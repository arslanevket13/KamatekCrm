<Application x:Class="KamatekCrm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KamatekCrm"
             xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
             xmlns:views="clr-namespace:KamatekCrm.Views"
             xmlns:converters="clr-namespace:KamatekCrm.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. BASE DESIGN TOKENS (Yalnızca Yapısal Değerler) -->
                <ResourceDictionary Source="Resources/DesignTokens.xaml"/>

                <!-- 2. WPF-UI BASE (Varsayılan kontrol sözlükleri; aktif tema sözlüğü üzerine yazar) -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />

                <!-- 3. ACTIVE THEME COLORS (Varsayılan: Premium Light; çalışma zamanında yalnızca bu sözlük değişir) -->
                <ResourceDictionary Source="Resources/Themes/Theme.PremiumLight.xaml"/>

                <!-- 3B. CORPORATE DESIGN TOKENS (4px/8px Grid & Tipografi Çekirdeği) -->
                <ResourceDictionary Source="Resources/Styles/DesignTokens.xaml"/>

                <!-- 4. UX FOUNDATION, GLOBAL CONTROLS, STYLES & COMPONENT STYLES -->
                <ResourceDictionary Source="Resources/UxFoundation.xaml"/>
                <ResourceDictionary Source="Resources/Styles/GlobalControls.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/ComponentStyles.xaml"/>

                <!-- 5. ANIMATIONS -->
                <ResourceDictionary Source="Resources/Animations.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Navigation Views -->
            <DataTemplate DataType="{x:Type vm:FirstRunWizardViewModel}">
                <views:FirstRunWizardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MainContentViewModel}">
                <views:MainContentView/>
            </DataTemplate>

            <!-- Content Views -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                <views:CustomersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CustomerDetailViewModel}">
                <views:CustomerDetailView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductViewModel}">
                <views:ProductsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ServiceJobViewModel}">
                <views:ServiceJobsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StockCountViewModel}">
                <views:StockCountView/>
            </DataTemplate>

             <DataTemplate DataType="{x:Type vm:StockReportsViewModel}">
                <views:StockReportsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <views:UsersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CustomerInteractionsViewModel}">
                <views:CustomerInteractionsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ManagerAgendaViewModel}">
                <views:ManagerAgendaView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SystemLogsViewModel}">
                <views:SystemLogsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RepairListViewModel}">
                <views:RepairListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FieldJobListViewModel}">
                <views:FieldJobListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NetworkSettingsViewModel}">
                <views:NetworkSettingsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
                <views:FinanceView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <views:AnalyticsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FinancialHealthViewModel}">
                <views:FinancialHealthView/>
            </DataTemplate>
            
            <!-- Satın Alma ve Stok Giriş -->
            <DataTemplate DataType="{x:Type vm:PurchasingViewModel}">
                <views:PurchasingView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
                <views:SuppliersView/>
            </DataTemplate>

            <!-- SMART ERP MODULES -->
            <DataTemplate DataType="{x:Type vm:RoutePlanningViewModel}">
                <views:RoutePlanningView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:QuoteListViewModel}">
                <views:QuoteListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:QuotationViewModel}">
                <views:QuotationView/>
            </DataTemplate>

            <!-- Global Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:IntToVisibilityConverter x:Key="IntToVis"/>
            <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
            <converters:InvertedBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
            <converters:BalanceColorConverter x:Key="BalanceColorConverter"/>
            <converters:QuoteStatusTextConverter x:Key="QuoteStatusText"/>
            <converters:QuoteStatusColorConverter x:Key="QuoteStatusColor"/>
            <converters:DateDisplayConverter x:Key="DateDisplay"/>
            <converters:SensitiveDataConverter x:Key="SensitiveData"/>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <converters:SafeIntConverter x:Key="SafeIntConverter"/>
            <converters:SafeNullableIntConverter x:Key="SafeNullableIntConverter"/>
            <converters:SafeDecimalConverter x:Key="SafeDecimalConverter"/>
            <converters:StructureTypeDisplayConverter x:Key="StructureTypeDisplayConverter"/>
            <converters:BallInCourtTextConverter x:Key="BallInCourtText"/>
            <converters:BallInCourtColorConverter x:Key="BallInCourtColor"/>
            <converters:DirectionTextConverter x:Key="DirectionText"/>
            <converters:ThreadEntryTypeTitleConverter x:Key="ThreadEntryTypeTitle"/>
            <converters:IsManagerInstructionConverter x:Key="IsManagerInstruction"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
