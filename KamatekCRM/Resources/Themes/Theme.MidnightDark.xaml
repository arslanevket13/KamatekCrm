<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         KAMATEK CRM — MIDNIGHT DARK THEME
         Tam Kontrast Birincil Metin (#F8FAFC) ve WCAG AA İkincil Metin (#CBD5E1 / #94A3B8)
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─────────── CANONICAL SEMANTIC TOKENS ─────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E14"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141821"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#141821"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA"/>

    <!-- Input / Popup / Scrollbar Semantic Tokens -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="InputFocusBackgroundBrush" Color="#0B1120"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="ScrollbarThumbDragBrush" Color="#94A3B8"/>

    <!-- Skeleton & Elevation -->
    <LinearGradientBrush x:Key="SkeletonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E293B" Offset="0"/>
        <GradientStop Color="#334155" Offset="0.5"/>
        <GradientStop Color="#1E293B" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Elevation1" BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.20"/>
    <DropShadowEffect x:Key="Elevation2" BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.30"/>

    <!-- ─────────── PAGE & BACKGROUNDS ─────────── -->
    <Color x:Key="SurfacePageColor">#0B0E14</Color>
    <SolidColorBrush x:Key="SurfacePageBrush" Color="#0B0E14"/>
    <Color x:Key="ThemeBackgroundColor">#0B0E14</Color>
    <SolidColorBrush x:Key="ThemeBackground" Color="#0B0E14"/>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0B0E14"/>

    <!-- ─────────── SURFACES & CARDS ─────────── -->
    <Color x:Key="SurfaceCardColor">#141821</Color>
    <Color x:Key="ThemeSurfaceColor">#141821</Color>
    <SolidColorBrush x:Key="ThemeSurface" Color="#141821"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#141821"/>
    <SolidColorBrush x:Key="CardBackground" Color="#141821"/>
    <SolidColorBrush x:Key="ThemeCard" Color="#141821"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#141821"/>

    <Color x:Key="SurfaceSidebarColor">#141821</Color>
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#141821"/>
    <SolidColorBrush x:Key="ThemeSidebar" Color="#141821"/>
    <SolidColorBrush x:Key="ThemeSidebarHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="ThemeSidebarActive" Color="#334155"/>

    <!-- ─────────── CORE TYPOGRAPHY (WCAG AA+ Contrast, Full Opacity) ─────────── -->
    <Color x:Key="ThemeTextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#F8FAFC"/>

    <Color x:Key="ThemeTextSecondaryColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ThemeTextTertiary" Color="#94A3B8"/>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="ThemeForeground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ThemeForegroundMuted" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ThemeHover" Color="#E2E8F0" Opacity="0.06"/>

    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextLinkBrush" Color="#60A5FA"/>

    <!-- ─────────── BORDERS & DIVIDERS ─────────── -->
    <Color x:Key="ThemeBorderColor">#334155</Color>
    <SolidColorBrush x:Key="ThemeBorder" Color="#334155"/>
    <SolidColorBrush x:Key="ThemeDivider" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#334155"/>

    <!-- ─────────── BRAND COLORS & ACCENTS ─────────── -->
    <Color x:Key="ThemePrimaryColor">#3B82F6</Color>
    <Color x:Key="ThemeAccentColor">#3B82F6</Color>

    <SolidColorBrush x:Key="ThemePrimary" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#3B82F6"/>

    <SolidColorBrush x:Key="PrimaryColor" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>

    <SolidColorBrush x:Key="ThemePrimaryLight" Color="#3B82F6" Opacity="0.20"/>
    <SolidColorBrush x:Key="ThemePrimaryDark" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ThemePrimaryMuted" Color="#3B82F6" Opacity="0.20"/>

    <!-- ─────────── STATUS COLORS ─────────── -->
    <Color x:Key="ThemeSuccessColor">#10B981</Color>
    <Color x:Key="ThemeWarningColor">#F59E0B</Color>
    <Color x:Key="ThemeErrorColor">#EF4444</Color>
    <Color x:Key="ThemeInfoColor">#3B82F6</Color>

    <SolidColorBrush x:Key="ThemeSuccess" Color="#10B981"/>
    <SolidColorBrush x:Key="ThemeWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ThemeError" Color="#EF4444"/>
    <SolidColorBrush x:Key="ThemeInfo" Color="#3B82F6"/>

    <SolidColorBrush x:Key="StatusSuccessBg" Color="#10B981" Opacity="0.16"/>
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusWarningBg" Color="#F59E0B" Opacity="0.16"/>
    <SolidColorBrush x:Key="StatusWarningFg" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusWarningFgDark" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusErrorBg" Color="#EF4444" Opacity="0.16"/>
    <SolidColorBrush x:Key="StatusErrorFg" Color="#F87171"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#F87171" Opacity="0.30"/>
    <SolidColorBrush x:Key="StatusInfoBg" Color="#3B82F6" Opacity="0.16"/>
    <SolidColorBrush x:Key="StatusInfoFg" Color="#60A5FA"/>

    <!-- ─────────── KPI GRADIENTS ─────────── -->
    <LinearGradientBrush x:Key="KpiGradientPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#60A5FA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientSuccess" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientWarning" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E11D48" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientError" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC2626" Offset="0"/>
        <GradientStop Color="#EF4444" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemePrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#60A5FA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientPurple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientGreen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientOrange" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#D97706" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiGradientCyan" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#0891B2" Offset="1"/>
    </LinearGradientBrush>

    <!-- ─────────── GLASSMORPHISM & OVERLAYS ─────────── -->
    <Color x:Key="GlassOverlayColorValue">#33FFFFFF</Color>
    <Color x:Key="GlassBrushLowColorValue">#0DE2E8F0</Color>
    <SolidColorBrush x:Key="GlassBrushLow" Color="#E2E8F0" Opacity="0.03"/>
    <SolidColorBrush x:Key="GlassBrushMedium" Color="#E2E8F0" Opacity="0.06"/>
    <SolidColorBrush x:Key="GlassBrushHigh" Color="#E2E8F0" Opacity="0.10"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#E2E8F0" Opacity="0.08"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#E2E8F0" Opacity="0.14"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#3B82F6" Opacity="0.20"/>

    <LinearGradientBrush x:Key="GlassCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141821" Offset="0"/>
        <GradientStop Color="#1A1F2E" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBorderBrush" Color="#FFFFFF" Opacity="0.12"/>
    <SolidColorBrush x:Key="GlassBorderHighlight" Color="#FFFFFF" Opacity="0.06"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#334155" Opacity="0.7"/>

    <!-- ─────────── SHADOW SYSTEM ─────────── -->
    <Color x:Key="ShadowColor">#000000</Color>
    <DropShadowEffect x:Key="ShadowSubtle" BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.18"/>
    <DropShadowEffect x:Key="ShadowDefault" BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.22"/>
    <DropShadowEffect x:Key="ShadowMedium" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.28"/>
    <DropShadowEffect x:Key="ShadowHigh" BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.38"/>

    <!-- ─────────── INTERACTION STATES ─────────── -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3B82F6" Opacity="0.6"/>
    <SolidColorBrush x:Key="DisabledOverlayBrush" Color="#0B0E14" Opacity="0.5"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="RippleBrush" Color="#3B82F6" Opacity="0.20"/>

    <!-- ─────────── STATUS LIGHT VARIANTS ─────────── -->
    <SolidColorBrush x:Key="StatusSuccessBgLight" Color="#10B981" Opacity="0.15"/>
    <SolidColorBrush x:Key="StatusSuccessFgLight" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusWarningBgLight" Color="#F59E0B" Opacity="0.15"/>
    <SolidColorBrush x:Key="StatusWarningFgLight" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusErrorBgLight" Color="#EF4444" Opacity="0.15"/>
    <SolidColorBrush x:Key="StatusErrorFgLight" Color="#F87171"/>
    <SolidColorBrush x:Key="StatusInfoBgLight" Color="#3B82F6" Opacity="0.15"/>
    <SolidColorBrush x:Key="StatusInfoFgLight" Color="#60A5FA"/>

    <!-- ─────────── MISC TOKENS ─────────── -->
    <SolidColorBrush x:Key="ThemeHoverLight" Color="#E2E8F0" Opacity="0.08"/>
    <Color x:Key="ThemeTextTertiaryColor">#94A3B8</Color>

    <!-- ─────────── PROFESSIONAL TOKENS ─────────── -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="StatusNeutralBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="ThemeSuccessDark" Color="#059669"/>
    <SolidColorBrush x:Key="ThemeErrorDark" Color="#DC2626"/>
    <SolidColorBrush x:Key="StatusWarningBgDark" Color="#F59E0B" Opacity="0.20"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#EF4444" Opacity="0.20"/>
    <SolidColorBrush x:Key="AccentOverlayBrush" Color="#3B82F6" Opacity="0.20"/>
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#334155"/>
    <SolidColorBrush x:Key="StatusSuccessFgDark" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusErrorFgDark" Color="#F87171"/>
    <SolidColorBrush x:Key="StatusInfoFgDark" Color="#60A5FA"/>
    <Color x:Key="SurfaceSidebarColorValue">#141821</Color>
    <Color x:Key="SurfaceCardColorValue">#141821</Color>
    <Color x:Key="SurfacePageColorValue">#0B0E14</Color>
    <Color x:Key="KpiPurpleStartColor">#A78BFA</Color>
    <Color x:Key="KpiPurpleEndColor">#7C3AED</Color>
    <SolidColorBrush x:Key="KpiPurpleStartBrush" Color="{StaticResource KpiPurpleStartColor}"/>
    <SolidColorBrush x:Key="KpiPurpleEndBrush" Color="{StaticResource KpiPurpleEndColor}"/>

    <!-- ─────────── SEMANTIC SUPPORT TOKENS ─────────── -->
    <Color x:Key="ThemePrimaryLightColor">#1E3A8A</Color>
    <Color x:Key="BorderDefaultColorValue">#334155</Color>
    <Color x:Key="CardShadowColor">#000000</Color>
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#000000" Opacity="0.60"/>
    <SolidColorBrush x:Key="ThemeSuccessLight" Color="#10B981" Opacity="0.18"/>
    <SolidColorBrush x:Key="ThemeWarningLight" Color="#F59E0B" Opacity="0.18"/>
    <SolidColorBrush x:Key="ThemeErrorLight" Color="#EF4444" Opacity="0.18"/>
    <SolidColorBrush x:Key="ThemeInfoLight" Color="#3B82F6" Opacity="0.18"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TextOnStatusBrush" Color="#0B1220"/>

</ResourceDictionary>
