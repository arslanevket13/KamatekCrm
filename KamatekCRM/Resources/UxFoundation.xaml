<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared layout values. New screens should consume these instead of local numbers. -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PageHeaderSpacing">0,0,0,20</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons</FontFamily>

    <sys:Double x:Key="PageTitleSize">26</sys:Double>
    <sys:Double x:Key="PageSubtitleSize">13</sys:Double>
    <sys:Double x:Key="ControlHeight">40</sys:Double>

    <Style x:Key="PageRoot" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PagePadding}"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource ReadableTextBlock}">
        <Setter Property="FontSize" Value="{StaticResource PageTitleSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource ReadableTextBlock}">
        <Setter Property="FontSize" Value="{StaticResource PageSubtitleSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="NavigationSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="20,4,20,6"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>

    <Style x:Key="FilterToolbarCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource SectionSpacing}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="AccessibleDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style x:Key="AccessibleComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
    </Style>

</ResourceDictionary>
