<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════
         KAMATEK CRM — DESIGN TOKENS
         Kural: yalnızca en az bir tüketicisi olan token burada tutulur.
         Yeni token eklerken ilk kullanımıyla birlikte ekleyin; kullanılmayan
         ölçekler (Space*, Icon*, Duration*, Ease*, Elevation0/3/4/5,
         AvatarSize*, SidebarWidth*, DataGrid*Height) kaldırıldı.
         STRICT RULE: NO COLORS OR BRUSHES ALLOWED IN THIS FILE.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─────────── GEOMETRY (CORNER RADIUS) ─────────── -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>

    <!-- ─────────── ELEVATION ─────────── -->
    <!-- Elevation 1: Buttons, Inputs — barely perceptible -->
    <DropShadowEffect x:Key="Elevation1" BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.03"/>

    <!-- Elevation 2: Main Cards — premium subtle -->
    <DropShadowEffect x:Key="Elevation2" BlurRadius="15" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.05"/>

    <!-- ─────────── COMPONENT DIMENSIONS ─────────── -->
    <sys:Double x:Key="KpiCardMinWidth">240</sys:Double>
    <sys:Double x:Key="KpiCardHeight">120</sys:Double>

</ResourceDictionary>
