<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════
         KAMATEK CRM — DESIGN TOKENS
         YALNIZCA YAPISAL DEĞERLER (CornerRadius, Thickness, FontSize, Double, FontFamily).
         RENK, FIRÇA VE GÖLGE TANIMLARI YALNIZCA Theme.*.xaml DOSYALARINDADIR.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─────────── TYPOGRAPHY FAMILIES ─────────── -->
    <FontFamily x:Key="MainFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons</FontFamily>

    <!-- ─────────── GEOMETRY (CORNER RADIUS) ─────────── -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>

    <!-- ─────────── SPACING & PADDING (THICKNESS) ─────────── -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PageHeaderSpacing">0,0,0,20</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- ─────────── FONT SIZES & CONTROL DIMENSIONS (DOUBLE) ─────────── -->
    <sys:Double x:Key="PageTitleSize">26</sys:Double>
    <sys:Double x:Key="PageSubtitleSize">13</sys:Double>
    <sys:Double x:Key="ControlHeight">38</sys:Double>
    <sys:Double x:Key="KpiCardMinWidth">240</sys:Double>
    <sys:Double x:Key="KpiCardHeight">68</sys:Double>

</ResourceDictionary>
