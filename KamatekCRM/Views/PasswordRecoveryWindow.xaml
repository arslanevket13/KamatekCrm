<ui:FluentWindow x:Class="KamatekCrm.Views.PasswordRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Şifre Kurtarma"
        Width="540" SizeToContent="Height"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Şifre Kurtarma" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,24">
            <!-- SEÇİM EKRANI -->
            <StackPanel x:Name="ChoicePanel">
                <TextBlock Text="Hesap Türünüzü Seçin" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Şifrenizi nasıl sıfırlayacağınızı seçin." FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Personelim" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Personel hesaplarının şifreleri güvenlik gereği yalnızca işletme yöneticiniz tarafından sıfırlanabilir."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ui:Button Content="Yönetici Bilgisini Göster" Appearance="Secondary" Click="StaffOption_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="İşletme Yöneticisiyim (Kurtarma Anahtarı ile Sıfırla)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="İlk kurulumda size verilen KMTK-XXXX-XXXX-XXXX kurtarma anahtarı ile yeni yönetici şifresi belirleyin."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ui:Button Content="Kurtarma Anahtarı ile Devam Et →" Appearance="Primary" Click="AdminOption_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PERSONEL BİLGİ PANELİ -->
            <StackPanel x:Name="StaffInfoPanel" Visibility="Collapsed">
                <TextBlock Text="Personel Şifre Sıfırlama" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource InfoBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <TextBlock Text="Lütfen işletme yöneticinizle iletişime geçin. Yönetici, KamatekCRM içinde 'Kullanıcılar' ekranından hesabınız için anında yeni bir geçici şifre tanımlayabilir."
                               TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="← Geri" Appearance="Secondary" Click="BackToChoice_Click" Margin="0,0,10,0"/>
                    <ui:Button Content="Kapat" Appearance="Primary" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- YÖNETİCİ KURTARMA FORMU -->
            <StackPanel x:Name="AdminResetPanel" Visibility="Collapsed">
                <TextBlock Text="Yönetici Şifresini Sıfırla" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Kayıtlı kurtarma anahtarınızı ve yeni parolanızı girin." FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14"/>

                <Border x:Name="ErrorBanner" Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium"/>
                </Border>

                <TextBlock Text="Kurtarma Anahtarı *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ui:TextBox x:Name="RecoveryKeyInput" PlaceholderText="KMTK-XXXX-XXXX-XXXX" Margin="0,0,0,12"/>

                <TextBlock Text="Yeni Yönetici Parolası (en az 6 karakter) *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <PasswordBox x:Name="NewPasswordBox" Height="36" Padding="8,6" Margin="0,0,0,12"/>

                <TextBlock Text="Yeni Parola Tekrar *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="36" Padding="8,6" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="← Geri" Appearance="Secondary" Click="BackToChoice_Click" Margin="0,0,10,0"/>
                    <ui:Button x:Name="ResetButton" Content="Şifreyi Sıfırla" Appearance="Primary" Click="ResetAdminPassword_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- YENİ KURTARMA ANAHTARI SONUÇ PANELİ -->
            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed">
                <TextBlock Text="Şifreniz Güncellendi" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Güvenlik gereği eski kurtarma anahtarınız geçersiz kılındı. Aşağıdaki YENİ kurtarma anahtarını güvenli bir yere kaydedin:"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <TextBlock x:Name="NewRecoveryKeyText" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Panoya Kopyala" Appearance="Secondary" Click="CopyNewKey_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="Dosyaya Kaydet" Appearance="Secondary" Click="SaveNewKey_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="Giriş Ekranına Dön" Appearance="Primary" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
