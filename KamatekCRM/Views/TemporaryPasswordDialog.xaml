<Window x:Class="KamatekCrm.Views.TemporaryPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Güvenli İlk Kurulum"
        Width="480"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource PremiumWindowStyle}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0">
                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="22" Foreground="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText"
                           Text="İlk Yönetici Hesabı Oluşturuldu"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextHeadingBrush}"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Bu geçici şifre güvenlik gereği yalnızca bir kez gösterilir."
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Credential Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">
            <StackPanel>
                <TextBlock Text="Kullanıcı Adı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="UsernameTextBox"
                         IsReadOnly="True"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Padding="10,8"
                         Margin="0,4,0,14"
                         Background="{DynamicResource SurfacePageBrush}"
                         Foreground="{DynamicResource TextHeadingBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"/>

                <TextBlock Text="Geçici Şifre" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PasswordTextBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="15"
                             FontWeight="Bold"
                             Padding="10,8"
                             Background="{DynamicResource SurfacePageBrush}"
                             Foreground="{DynamicResource TextHeadingBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"/>

                    <ui:Button Grid.Column="1"
                               x:Name="CopyButton"
                               Content="Kopyala"
                               Icon="{ui:SymbolIcon Copy24}"
                               Appearance="Primary"
                               Height="38"
                               Padding="14,0"
                               Margin="8,0,0,0"
                               Cursor="Hand"
                               Click="CopyButton_Click"/>
                </Grid>

                <TextBlock x:Name="CopiedFeedbackText"
                           Text="✓ Geçici şifre panoya kopyalandı."
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessFg}"
                           Visibility="Collapsed"
                           Margin="0,0,0,10"/>

                <Border Background="{DynamicResource StatusWarningBg}" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{DynamicResource StatusWarningFg}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Lütfen geçici şifreyi kopyalayıp güvenli bir yere not edin. İlk girişte yeni ve güçlü bir şifre belirlemeniz istenecektir."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StatusWarningFg}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="Tamam"
                       Appearance="Primary"
                       MinWidth="110"
                       Height="38"
                       IsDefault="True"
                       IsCancel="True"
                       Cursor="Hand"
                       Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
