<UserControl x:Class="KamatekCrm.Views.CustomerInteractionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
             xmlns:models="clr-namespace:KamatekCrm.Shared.Models;assembly=KamatekCrm.Shared"
             xmlns:enums="clr-namespace:KamatekCrm.Shared.Enums;assembly=KamatekCrm.Shared"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenNewDrawerCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <!-- ============================================================ -->
        <!-- ANA EKRAN İÇERİĞİ                                            -->
        <!-- ============================================================ -->
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Üst Aksiyon Barı -->
                <RowDefinition Height="*"/>      <!-- 3 Sütunlu Çalışma Alanı -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- ROW 0: ÜST AKSİYON BARI                                      -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- Görünüm Seçici -->
                        <ColumnDefinition Width="*"/>      <!-- Boşluk / Başlık -->
                        <ColumnDefinition Width="Auto"/>   <!-- Arama -->
                        <ColumnDefinition Width="Auto"/>   <!-- Yenile -->
                        <ColumnDefinition Width="Auto"/>   <!-- + Yeni Kayıt Butonu -->
                    </Grid.ColumnDefinitions>

                    <!-- Görünüm Seçici (Segmented Buttons) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Call24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,10,0"/>
                        <TextBlock Text="İletişim &amp; Talep Merkezi" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Akış" IsChecked="{Binding IsFeedView, Mode=OneWay}"
                                             Command="{Binding SetViewModeCommand}" CommandParameter="Feed"
                                             GroupName="ViewModes" Margin="2" Padding="10,4"
                                             Style="{DynamicResource {x:Type ToggleButton}}"/>
                                <RadioButton Content="Günlük" IsChecked="{Binding IsDailyView, Mode=OneWay}"
                                             Command="{Binding SetViewModeCommand}" CommandParameter="Daily"
                                             GroupName="ViewModes" Margin="2" Padding="10,4"
                                             Style="{DynamicResource {x:Type ToggleButton}}"/>
                                <RadioButton Content="Haftalık" IsChecked="{Binding IsWeeklyView, Mode=OneWay}"
                                             Command="{Binding SetViewModeCommand}" CommandParameter="Weekly"
                                             GroupName="ViewModes" Margin="2" Padding="10,4"
                                             Style="{DynamicResource {x:Type ToggleButton}}"/>
                                <RadioButton Content="Aylık" IsChecked="{Binding IsMonthlyView, Mode=OneWay}"
                                             Command="{Binding SetViewModeCommand}" CommandParameter="Monthly"
                                             GroupName="ViewModes" Margin="2" Padding="10,4"
                                             Style="{DynamicResource {x:Type ToggleButton}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Anlık Arama Kutusu -->
                    <ui:TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Arayan, telefon, konu ara..." Icon="{ui:SymbolIcon Search24}"
                                Width="260" Height="34" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- Yenile Butonu -->
                    <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Yenile"
                               Command="{Binding LoadInteractionsCommand}" Appearance="Secondary"
                               Height="34" Width="34" Padding="0" Margin="0,0,10,0" Cursor="Hand" VerticalAlignment="Center"/>

                    <!-- + Yeni Kayıt (Ctrl+N) Butonu -->
                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Add24}" Content="+ Yeni Kayıt (Ctrl+N)"
                               Command="{Binding OpenNewDrawerCommand}" Appearance="Primary"
                               Height="34" Padding="14,0" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 1: 3 SÜTUNLU ÇALIŞMA ALANI                               -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>   <!-- Sütun 0: Sol Ray (Mini Takvim + Akıllı Klasörler) -->
                    <ColumnDefinition Width="10"/>    <!-- Sütun 1: Ayırıcı Boşluk -->
                    <ColumnDefinition Width="1.2*"/>  <!-- Sütun 2: Orta Sahne (Vaka Kartları Akışı) -->
                    <ColumnDefinition Width="10"/>    <!-- Sütun 3: Ayırıcı Boşluk -->
                    <ColumnDefinition Width="1.1*"/>  <!-- Sütun 4: Sağ Panel (Çok Katmanlı Vaka Defteri) -->
                </Grid.ColumnDefinitions>

                <!-- ======================================================== -->
                <!-- SOL RAY: MİNİ TAKVİM ARŞİVİ & AKILLI KLASÖRLER          -->
                <!-- ======================================================== -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Mini Takvim Başlık & Ay Gezintisi -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon ChevronLeft20}" Command="{Binding PreviousMonthCommand}"
                                           Appearance="Secondary" Padding="2" Height="26" Width="26" Cursor="Hand"/>
                                <TextBlock Grid.Column="1" Text="{Binding CalendarMonthTitle}" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ChevronRight20}" Command="{Binding NextMonthCommand}"
                                           Appearance="Secondary" Padding="2" Height="26" Width="26" Cursor="Hand"/>
                            </Grid>

                            <!-- Bugüne Dön Butonu -->
                            <Button Command="{Binding ResetToTodayCommand}" Content="Bugüne Dön"
                                    HorizontalAlignment="Center" Margin="0,0,0,8" Padding="8,2" FontSize="11"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemePrimary}" Cursor="Hand"/>

                            <!-- Gün Başlıkları (Pzt ... Paz) -->
                            <UniformGrid Columns="7" Margin="0,0,0,4">
                                <TextBlock Text="Pzt" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Sal" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Çar" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Per" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Cum" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Cmt" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Paz" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </UniformGrid>

                            <!-- Mini Takvim Günleri Izgarası -->
                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CalendarDayItemViewModel}">
                                        <Border Margin="1" CornerRadius="4" Padding="2,3" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsToday}" Value="True"/>
                                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayNumber}" FontSize="10" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Olay Noktası -->
                                                <Ellipse Width="4" Height="4" Margin="0,1,0,0" HorizontalAlignment="Center"
                                                         Visibility="{Binding HasInteractions, Converter={StaticResource BoolToVis}}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource ThemePrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusErrorFg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Ayırıcı Çizgi -->
                            <Separator Margin="0,12,0,10" Background="{DynamicResource BorderBrush}"/>

                            <!-- AKILLI KLASÖRLER BAŞLIĞI -->
                            <TextBlock Text="AKILLI KLASÖRLER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,0,6"/>

                            <!-- 1. Bugün -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="Today">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="CalendarToday20" FontSize="14" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Bugün" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountToday}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 2. Gecikenler (Rollover) -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="Overdue">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ClockAlarm20" FontSize="14" Foreground="{DynamicResource StatusErrorFg}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Gecikenler" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource StatusErrorBg}" CornerRadius="8" Padding="6,1"
                                            Visibility="{Binding CountOverdue, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding CountOverdue}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusErrorFg}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 3. Top Bizde -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="BallInCourtUs">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="PersonFeedback20" FontSize="14" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Top Bizde" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountBallInCourtUs}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 4. Müşteriden Beklenen -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="BallInCourtCustomer">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="PersonQuestionMark20" FontSize="14" Foreground="{DynamicResource StatusWarningFg}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Müşteriden Beklenen" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountBallInCourtCustomer}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 5. Patronda -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="BallInCourtManager">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="StarCheckmark20" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Patronda" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBgBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountBallInCourtManager}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 6. Bana Atanan -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="AssignedToMe">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="PersonStar20" FontSize="14" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Bana Atanan" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountAssignedToMe}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 7. Tamamlananlar -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="Completed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle20" FontSize="14" Foreground="{DynamicResource StatusSuccessBg}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Tamamlananlar" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountCompleted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 8. Tümü -->
                            <Button Margin="0,1" Padding="8,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding SelectFolderCommand}" CommandParameter="All">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Folder20" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Tümü" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding CountAll}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ======================================================== -->
                <!-- ORTA SAHNE: VAKA KARTLARI AKIŞI                          -->
                <!-- ======================================================== -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <!-- Boş Liste Uyarısı -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Interactions.Count, Converter={StaticResource InverseBoolToVis}}">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="40" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Kayıt bulunamadı" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Seçili filtre veya tarihe uygun vaka yok." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sanallaştırılmış Vaka Kartları Listesi -->
                        <ListBox ItemsSource="{Binding Interactions}" SelectedItem="{Binding SelectedInteraction}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10" BorderThickness="1" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Üst Bilgi Satırı -->
                                                <RowDefinition Height="Auto"/> <!-- Konu & Özet -->
                                                <RowDefinition Height="Auto"/> <!-- Alt Bilgi Rozetleri -->
                                            </Grid.RowDefinitions>

                                            <!-- Üst Satır: Arayan + Top Kimde + Gecikme Rozeti -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Arayan Bilgisi -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CallerName}" FontWeight="Bold" FontSize="13"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding CallerPhone}" FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <!-- Müşteri Rozeti -->
                                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="5,1"
                                                            Visibility="{Binding CustomerName, Converter={StaticResource NullToVis}}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CustomerName}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Sağ Rozetler: Gecikme + Top Kimde -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Gecikme Rozeti -->
                                                    <Border Background="{DynamicResource StatusErrorBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                            Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="SARKTI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusErrorFg}"/>
                                                    </Border>

                                                    <!-- Top Kimde Rozeti -->
                                                    <Border CornerRadius="4" Padding="6,2" Background="{Binding BallInCourt, Converter={StaticResource BallInCourtColor}}">
                                                        <TextBlock Text="{Binding BallInCourt, Converter={StaticResource BallInCourtText}}"
                                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Orta Satır: Konu ve Özet -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextHeadingBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Alt Satır: Yön + Talep Türü + Checklist Özeti + Takip Tarihi -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Yön -->
                                                    <TextBlock Text="{Binding Direction, Converter={StaticResource DirectionText}}"
                                                               FontSize="10" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0"/>
                                                    <!-- Talep Türü -->
                                                    <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding RequestType}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                                </StackPanel>

                                                <!-- Takip Tarihi -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="CalendarClock20" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding FollowUpDate, Converter={StaticResource DateDisplay}}"
                                                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- SAĞ PANEL: ÇOK KATMANLI VAKA DEFTERİ                    -->
                <!-- ======================================================== -->
                <Border Grid.Column="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <!-- Vaka Seçilmediğinde Gösterilecek Mesaj -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelectedInteraction, Converter={StaticResource InverseBoolToVis}}">
                            <ui:SymbolIcon Symbol="BookContacts24" FontSize="44" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Vaka Defteri" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="İncelemek veya işlem yapmak için&#x0a;soldaki listeden bir vaka seçiniz."
                                       TextAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Vaka Seçildiğinde Gösterilecek Çok Katmanlı Panel -->
                        <DockPanel Visibility="{Binding HasSelectedInteraction, Converter={StaticResource BoolToVis}}">
                            <!-- ================================================ -->
                            <!-- ÜST BÖLÜM: BAŞLIK + TOP KİMDE + AKSİYONLAR      -->
                            <!-- ================================================ -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <!-- Vaka Numarası & Arayan -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedInteraction.InteractionNumber}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThemePrimary}"/>
                                        <TextBlock Text="{Binding SelectedInteraction.CallerName}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding SelectedInteraction.CallerPhone}" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- WhatsApp Butonu -->
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Chat24}" Content="WhatsApp"
                                               Command="{Binding OpenWhatsAppCommand}" Appearance="Secondary"
                                               Height="30" Padding="8,0" Cursor="Hand" VerticalAlignment="Top"/>
                                </Grid>

                                <!-- Top Kimde 3'lü Butonları -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="4" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Bizde" Command="{Binding ChangeBallInCourtCommand}" CommandParameter="Us"
                                                Margin="2" Padding="0,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                        <Button Grid.Column="1" Content="Müşteride" Command="{Binding ChangeBallInCourtCommand}" CommandParameter="Customer"
                                                Margin="2" Padding="0,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="Patronda" Command="{Binding ChangeBallInCourtCommand}" CommandParameter="Manager"
                                                Margin="2" Padding="0,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                    </Grid>
                                </Border>

                                <!-- Sorumlu Devir ComboBox + Patrona Aktar -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding Users}" DisplayMemberPath="FullName"
                                              SelectedItem="{Binding SelectedAssignedUser}" Height="30" Margin="0,0,6,0"/>
                                    <ui:Button Grid.Column="1" Content="Patrona Aktar" Icon="{ui:SymbolIcon Star24}"
                                               Command="{Binding EscalateToManagerCommand}" Appearance="Secondary"
                                               Height="30" Padding="8,0" Cursor="Hand"/>
                                </Grid>

                                <!-- Aksiyon Butonları (İş Emri, Teklif, Tamamla) -->
                                <WrapPanel Margin="0,0,0,6">
                                    <ui:Button Content="İş Emri Aç" Icon="{ui:SymbolIcon Wrench24}"
                                               Command="{Binding ConvertToServiceJobCommand}" Appearance="Secondary"
                                               Height="28" Padding="8,0" Margin="0,0,6,4" Cursor="Hand"/>
                                    <ui:Button Content="Teklif Hazırla" Icon="{ui:SymbolIcon DocumentTable24}"
                                               Command="{Binding ConvertToQuoteCommand}" Appearance="Secondary"
                                               Height="28" Padding="8,0" Margin="0,0,6,4" Cursor="Hand"/>
                                    <ui:Button Content="Tamamla" Icon="{ui:SymbolIcon Checkmark24}"
                                               Command="{Binding CompleteInteractionCommand}" Appearance="Primary"
                                               Height="28" Padding="10,0" Margin="0,0,0,4" Cursor="Hand"/>
                                </WrapPanel>
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,4"/>
                            </StackPanel>

                            <!-- ================================================ -->
                            <!-- ALT BÖLÜM: HIZLI KATMAN / NOT EKLEME ÇUBUĞU      -->
                            <!-- ================================================ -->
                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Hızlı Erteleme Çipleri -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Ertele:" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Content="+30dk" Command="{Binding QuickSnoozeCommand}" CommandParameter="+30dk"
                                                Margin="0,0,4,0" Padding="6,2" FontSize="10" Cursor="Hand"/>
                                        <Button Content="+2s" Command="{Binding QuickSnoozeCommand}" CommandParameter="+2s"
                                                Margin="0,0,4,0" Padding="6,2" FontSize="10" Cursor="Hand"/>
                                        <Button Content="Yarın 09:30" Command="{Binding QuickSnoozeCommand}" CommandParameter="Yarın 09:30"
                                                Margin="0,0,4,0" Padding="6,2" FontSize="10" Cursor="Hand"/>
                                        <Button Content="Haftaya Pzt" Command="{Binding QuickSnoozeCommand}" CommandParameter="Haftaya Pzt"
                                                Padding="6,2" FontSize="10" Cursor="Hand"/>
                                    </StackPanel>

                                    <!-- Tür Seçici + Not Kutusu + Ekle -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" ItemsSource="{Binding ThreadEntryTypes}" SelectedItem="{Binding SelectedThreadEntryType}"
                                                  Height="26" Margin="0,0,0,4" FontSize="11"/>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding NewThreadNoteContent, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="Yeni katman veya not yazınız..."
                                                        AcceptsReturn="True" Height="46" Margin="0,0,6,0"/>
                                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Send24}" ToolTip="Katman Ekle"
                                                       Command="{Binding AddThreadEntryCommand}" Appearance="Primary"
                                                       Width="46" Height="46" Padding="0" Cursor="Hand"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ================================================ -->
                            <!-- ORTA BÖLÜM: CHECKLIST + THREAD                   -->
                            <!-- ================================================ -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- 1. KONTROL LİSTESİ (CHECKLIST) -->
                                    <TextBlock Text="KONTROL LİSTESİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>

                                    <ItemsControl ItemsSource="{Binding RightPanelChecklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:InteractionChecklistItem}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}"
                                                              Command="{Binding DataContext.ToggleChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <Button Grid.Column="2" Content="✕"
                                                            Command="{Binding DataContext.DeleteChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}"
                                                            FontSize="10" Padding="4,2" Cursor="Hand"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Yeni Madde Ekle -->
                                    <Grid Margin="0,4,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding NewChecklistTitle, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Yeni alt kontrol maddesi ekle..." Height="28" Margin="0,0,4,0"/>
                                        <ui:Button Grid.Column="1" Content="Ekle" Command="{Binding AddChecklistItemCommand}"
                                                   Appearance="Secondary" Height="28" Padding="8,0" Cursor="Hand"/>
                                    </Grid>

                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                                    <!-- 2. KRONOLOJİK ZAMAN ÇİZELGESİ (THREAD) -->
                                    <TextBlock Text="ZAMAN ÇİZELGESİ (THREAD)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding RightPanelThread}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:InteractionThreadEntry}">
                                                <Border Margin="0,0,0,8" CornerRadius="6" Padding="10,8" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EntryType, Converter={StaticResource IsManagerInstruction}}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBgBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding AuthorName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                <TextBlock Text=" (" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock Text="{Binding AuthorRole}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock Text=") • " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock Text="{Binding EntryType, Converter={StaticResource ThreadEntryTypeTitle}}"
                                                                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding CreatedAtUtc, Converter={StaticResource DateDisplay}}"
                                                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- SLIDE-OVER HIZLI KAYIT ÇEKMECESİ (DRAWER OVERLAY)            -->
        <!-- ============================================================ -->
        <Grid Panel.ZIndex="100" Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
            <!-- Karartılmış Arka Plan (Tıklayınca Kapanır) -->
            <Rectangle Fill="{DynamicResource SurfaceOverlayBrush}">
                <Rectangle.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDrawerCommand}"/>
                </Rectangle.InputBindings>
            </Rectangle>

            <!-- Sağdan Açılan Panel -->
            <Border HorizontalAlignment="Right" Width="480" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Başlık -->
                        <RowDefinition Height="*"/>    <!-- Form Gövdesi (Scrollable) -->
                        <RowDefinition Height="Auto"/> <!-- Butonlar -->
                    </Grid.RowDefinitions>

                    <!-- Başlık Satırı -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="YENİ VAKA &amp; İLETİŞİM KAYDI" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Slide-Over Hızlı Kayıt Çekmecesi (Esc ile kapanır)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CloseDrawerCommand}"
                                   Appearance="Secondary" Height="32" Width="32" Padding="0" Cursor="Hand"/>
                    </Grid>

                    <!-- Form Gövdesi -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Yön Seçimi -->
                            <TextBlock Text="TALEP YÖNÜ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="4" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="Müşteri Aradı" IsChecked="True" Margin="2" Padding="6,4"
                                                 Style="{DynamicResource {x:Type ToggleButton}}"/>
                                    <RadioButton Grid.Column="1" Content="Bilgi İstendi" Margin="2" Padding="6,4"
                                                 Style="{DynamicResource {x:Type ToggleButton}}"/>
                                    <RadioButton Grid.Column="2" Content="İç Not" Margin="2" Padding="6,4"
                                                 Style="{DynamicResource {x:Type ToggleButton}}"/>
                                </Grid>
                            </Border>

                            <!-- Hızlı Kategori Çipleri -->
                            <TextBlock Text="HIZLI KATEGORİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Fiyat" Command="{Binding SetDrawerCategoryCommand}" CommandParameter="Fiyat"
                                        Margin="0,0,6,6" Padding="10,4" Cursor="Hand"/>
                                <Button Content="Keşif" Command="{Binding SetDrawerCategoryCommand}" CommandParameter="Keşif"
                                        Margin="0,0,6,6" Padding="10,4" Cursor="Hand"/>
                                <Button Content="Servis" Command="{Binding SetDrawerCategoryCommand}" CommandParameter="Servis"
                                        Margin="0,0,6,6" Padding="10,4" Cursor="Hand"/>
                                <Button Content="Patron" Command="{Binding SetDrawerCategoryCommand}" CommandParameter="Patron"
                                        Margin="0,0,6,6" Padding="10,4" Cursor="Hand"/>
                                <Button Content="Şikâyet" Command="{Binding SetDrawerCategoryCommand}" CommandParameter="Şikâyet"
                                        Margin="0,0,6,6" Padding="10,4" Cursor="Hand"/>
                                <Button Content="Geri Ara" Command="{Binding SetDrawerCategoryCommand}" CommandParameter="Geri Ara"
                                        Margin="0,0,0,6" Padding="10,4" Cursor="Hand"/>
                            </WrapPanel>

                            <!-- Telefon & Canlı Arayan Hafızası -->
                            <TextBlock Text="TELEFON &amp; ARAYAN BİLGİSİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding DrawerCallerPhone, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Telefon (örn: 0532...)" Icon="{ui:SymbolIcon Call24}"
                                        Height="34" Margin="0,0,0,6"/>

                            <!-- Canlı Arayan Hafızası Kartı (Canlı 300ms Debounce) -->
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding HasDrawerCallerContext, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DrawerCallerContext.CustomerName}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource ThemePrimary}"/>
                                            <TextBlock Text="{Binding DrawerCallerContext.PhoneNumber}" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding DrawerCallerContext.OpenJobsCount, StringFormat='Açık İş: {0}'}" FontSize="10"/>
                                            </Border>
                                            <Border Background="{DynamicResource CardBackground}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding DrawerCallerContext.PendingQuotesCount, StringFormat='Teklif: {0}'}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Son Görüşmeler:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,2"/>
                                    <ItemsControl ItemsSource="{Binding DrawerCallerContext.RecentInteractions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1" TextTrimming="CharacterEllipsis">
                                                    <Run Text="• "/><Run Text="{Binding Date, Converter={StaticResource DateDisplay}}"/><Run Text=" - "/><Run Text="{Binding Subject}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ui:TextBox Text="{Binding DrawerCallerName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Arayan Kişi / Şirket Adı" Icon="{ui:SymbolIcon Person24}"
                                        Height="34" Margin="0,0,0,12"/>

                            <!-- Top Kimde Seçimi -->
                            <TextBlock Text="TOP KİMDE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="4" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="Bizde" IsChecked="True" Margin="2" Padding="6,4"
                                                 Style="{DynamicResource {x:Type ToggleButton}}"/>
                                    <RadioButton Grid.Column="1" Content="Müşteride" Margin="2" Padding="6,4"
                                                 Style="{DynamicResource {x:Type ToggleButton}}"/>
                                    <RadioButton Grid.Column="2" Content="Patronda" Margin="2" Padding="6,4"
                                                 Style="{DynamicResource {x:Type ToggleButton}}"/>
                                </Grid>
                            </Border>

                            <!-- Hızlı Takip Zamanlayıcı Çipleri -->
                            <TextBlock Text="TAKİP ZAMANLAYICI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="+30 dk" Command="{Binding SetDrawerFollowUpCommand}" CommandParameter="+30dk"
                                        Margin="0,0,6,6" Padding="8,4" Cursor="Hand"/>
                                <Button Content="+2 saat" Command="{Binding SetDrawerFollowUpCommand}" CommandParameter="+2saat"
                                        Margin="0,0,6,6" Padding="8,4" Cursor="Hand"/>
                                <Button Content="Yarın 09:30" Command="{Binding SetDrawerFollowUpCommand}" CommandParameter="Yarın 09:30"
                                        Margin="0,0,6,6" Padding="8,4" Cursor="Hand"/>
                                <Button Content="2 Gün Sonra" Command="{Binding SetDrawerFollowUpCommand}" CommandParameter="2 Gün Sonra"
                                        Margin="0,0,0,6" Padding="8,4" Cursor="Hand"/>
                            </WrapPanel>

                            <!-- Konu & Detay -->
                            <TextBlock Text="KONU &amp; AÇIKLAMA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding DrawerSubject, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Görüşme / Talep Konusu" Height="34" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding DrawerNotes, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Görüşme özeti ve ilk notlar..." AcceptsReturn="True" Height="70" Margin="0,0,0,12"/>

                            <!-- İlk Kontrol Listesi Maddeleri (Opsiyonel) -->
                            <TextBlock Text="İLK KONTROL LİSTESİ (OPSİYONEL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding DrawerNewChecklistText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Madde yazıp ekleyiniz..." Height="30" Margin="0,0,4,0"/>
                                <ui:Button Grid.Column="1" Content="Ekle" Command="{Binding AddDrawerChecklistItemCommand}"
                                           Appearance="Secondary" Height="30" Padding="10,0" Cursor="Hand"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DrawerChecklistItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <Button Grid.Column="1" Content="✕"
                                                    Command="{Binding DataContext.RemoveDrawerChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Padding="4,2" Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Butonlar -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Vaka Kaydını Aç" Icon="{ui:SymbolIcon Checkmark24}"
                                   Command="{Binding SaveDrawerRecordCommand}" Appearance="Primary"
                                   Height="36" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                        <ui:Button Grid.Column="1" Content="Vazgeç" Command="{Binding CloseDrawerCommand}"
                                   Appearance="Secondary" Height="36" Padding="12,0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
