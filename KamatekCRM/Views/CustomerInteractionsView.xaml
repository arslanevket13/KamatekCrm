<UserControl x:Class="KamatekCrm.Views.CustomerInteractionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:KamatekCrm.Components"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Call24" FontSize="26" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Müşteri İletişim ve Talep Merkezi" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="Telefon görüşmelerini, müşteri taleplerini, takip tarihlerini ve yönlendirmeleri yönetin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="2" Content="Yeni Görüşme Kaydı" Icon="{ui:SymbolIcon CallAdd24}"
                       Command="{Binding OpenAddWindowCommand}" Appearance="Primary" Height="40" Padding="18,0" Cursor="Hand"/>
        </Grid>

        <!-- ROW 1: KPI CARDS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <components:KmKpiCard Title="Bugünün Aramaları"
                                   Value="{Binding Summary.TotalInteractionsCount}"
                                   Icon="&#xE717;"
                                   AccentBrush="{DynamicResource ThemePrimary}"
                                   Margin="0,0,12,0"/>
            <components:KmKpiCard Title="Takip Gerekenler"
                                   Value="{Binding Summary.FollowUpRequiredCount}"
                                   Icon="&#xE823;"
                                   AccentBrush="{DynamicResource ThemeSuccess}"
                                   Margin="0,0,12,0"/>
            <components:KmKpiCard Title="Geciken Takipler"
                                   Value="{Binding Summary.OverdueCount}"
                                   Icon="&#xE783;"
                                   AccentBrush="{DynamicResource ThemeError}"
                                   Margin="0,0,12,0"/>
            <components:KmKpiCard Title="Yönetici Gündemi"
                                   Value="{Binding Summary.ManagerAgendaCount}"
                                   Icon="&#xE7EF;"
                                   AccentBrush="{DynamicResource ThemeWarning}"
                                   Margin="0,0,0,0"/>
        </UniformGrid>

        <!-- ROW 2: SEARCH & REFRESH TOOLBAR -->
        <Border Grid.Row="2" CornerRadius="12" Padding="14" Margin="0,0,0,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Arayan, müşteri adı, konu veya telefon ile ara..."
                            Icon="{ui:SymbolIcon Search24}" Height="38"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Yenile" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding LoadInteractionsCommand}" Appearance="Secondary"
                               Height="38" Padding="14,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: MAIN DATAGRID (LEFT) AND DETAIL CARD (RIGHT) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DATAGRID -->
            <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="12" Padding="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Interactions}"
                          SelectedItem="{Binding SelectedInteraction}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="54"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          AlternatingRowBackground="{DynamicResource HoverOverlayBrush}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfacePageBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding InteractionNumber}" Width="120"/>

                        <DataGridTemplateColumn Header="Arayan &amp; Müşteri" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CallerName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding CallerPhone}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Konu" Binding="{Binding Subject}" Width="160"/>
                        <DataGridTextColumn Header="Talep Türü" Binding="{Binding RequestType}" Width="110"/>
                        <DataGridTextColumn Header="Sorumlu" Binding="{Binding AssignedToUsername, TargetNullValue='Atanmadı'}" Width="110"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding InteractionDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: PREVIEW PANEL -->
            <Border Grid.Column="1" CornerRadius="12" Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <components:KmEmptyState Icon="&#xE717;" Title="Görüşme Seçilmedi"
                                             Message="Detaylarını incelemek ve işlem yapmak için sol listeden bir görüşme seçin."
                                             Visibility="{Binding HasSelectedInteraction, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedInteraction, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedInteraction}">
                            <TextBlock Text="{Binding InteractionNumber}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                            <TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding CallerName, StringFormat='Arayan: {0}'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="GÖRÜŞME ÖZETİ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <TextBlock Text="DETAYLI NOTLAR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding DetailedNotes, TargetNullValue='Ek not yok'}" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                            <StackPanel>
                                <ui:Button Content="Görüşmeyi Tamamla" Icon="{ui:SymbolIcon Checkmark24}"
                                           Command="{Binding DataContext.CompleteInteractionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Appearance="Success" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand"/>

                                <ui:Button Content="Teklife Dönüştür" Icon="{ui:SymbolIcon DocumentAdd24}"
                                           Command="{Binding DataContext.ConvertToQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Appearance="Primary" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand"/>

                                <ui:Button Content="Servis İşe Dönüştür" Icon="{ui:SymbolIcon Wrench24}"
                                           Command="{Binding DataContext.ConvertToServiceJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
