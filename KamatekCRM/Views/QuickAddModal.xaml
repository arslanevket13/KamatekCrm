<Window x:Class="KamatekCrm.Views.QuickAddModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hızlı Aksiyon" 
        Width="600" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{StaticResource PremiumWindowStyle}"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="500" MinHeight="360">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="QuickAddListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSidebarHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSidebarHover}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Return" Command="{Binding ExecuteSelectedCommand}"/>
        <KeyBinding Key="Up" Command="{Binding MoveSelectionUpCommand}"/>
        <KeyBinding Key="Down" Command="{Binding MoveSelectionDownCommand}"/>
    </Window.InputBindings>

    <!-- Kenarlık ve gölge -->
    <Border Background="{DynamicResource SurfacePageBrush}" 
            CornerRadius="16" 
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.3" ShadowDepth="10" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Arama Çubuğu -->
            <Border Grid.Row="0" Padding="24,16" 
                    BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="22" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bir aksiyon veya sayfa ara... (Ctrl+K)"
                                   FontSize="16"
                                   Foreground="{DynamicResource ThemeTextTertiary}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" Background="Transparent"
                                 BorderThickness="0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>

                    <Border Grid.Column="2" Background="{DynamicResource ApplicationBackgroundBrush}" 
                            CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="ESC" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextTertiary}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Filtrelenmiş RBAC Aksiyon Listesi -->
            <Grid Grid.Row="1" Margin="16,8">
                <ListBox x:Name="ActionsListBox"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource QuickAddListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseLeftButtonUp="ActionsListBox_MouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}" 
                                        CornerRadius="8" Width="38" Height="38">
                                    <TextBlock Text="{Binding Icon}" FontSize="18" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource ApplicationBackgroundBrush}" 
                                        CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextTertiary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Aramanızla eşleşen yetkili aksiyon bulunamadı."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="16,8"
                    BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⌨️ " FontSize="11" Foreground="{DynamicResource ThemeTextTertiary}"/>
                    <TextBlock Text="↑↓ Navigasyon" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextTertiary}" Margin="0,0,16,0"/>
                    <TextBlock Text="↵ Seç" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextTertiary}" Margin="0,0,16,0"/>
                    <TextBlock Text="ESC Kapat" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextTertiary}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

