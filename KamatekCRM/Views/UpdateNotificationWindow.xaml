<Window x:Class="KamatekCrm.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="KamatekCRM Uygulama Güncellemesi" 
        Width="540" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Release Notes & Progress -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons Footer -->
        </Grid.RowDefinitions>

        <!-- ════════ HEADER ════════ -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource ThemePrimaryLight}" Margin="0,0,14,0" DockPanel.Dock="Left">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YENİ UYGULAMA SÜRÜMÜ MEVCUT" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="KamatekCRM için yeni güncellemeler hazır." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════ BODY ════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sürüm Karşılaştırma Kartı -->
            <Border Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MEVCUT SÜRÜM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="12,0"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="YENİ SÜRÜM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtTargetVersion" Text="v2.1.0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sürüm Notları -->
            <Border Grid.Row="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Sürüm Notları &amp; Yenilikler" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtSizeInfo" Text="Boyut: -- MB" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtReleaseNotes" Text="Sürüm notları yükleniyor..." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- İlerleme Çubuğu (İndirilirken Görünür) -->
            <StackPanel Grid.Row="2" x:Name="PnlProgress" Visibility="Collapsed" Margin="0,0,0,8">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="TxtProgressStatus" Text="Güncelleme indiriliyor..." FontSize="11" Foreground="{DynamicResource ThemePrimary}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="%0" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                </DockPanel>
                <ProgressBar x:Name="ProgressBarDownload" Height="8" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Grid>

        <!-- ════════ FOOTER ACTIONS ════════ -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <!-- İndirme Öncesi Butonlar -->
                <Grid x:Name="GridInitialButtons" Visibility="Visible">
                    <ui:Button x:Name="BtnLater" Content="Daha Sonra" Click="BtnLater_Click"
                               Appearance="Secondary" Height="36" Padding="16,0" HorizontalAlignment="Left" Cursor="Hand"/>
                    <ui:Button x:Name="BtnDownload" Content="Güncellemeyi İndir" Click="BtnDownload_Click"
                               Appearance="Primary" Height="36" Padding="20,0" HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>

                <!-- İndirme Tamamlandığında Görünecek Butonlar -->
                <Grid x:Name="GridDownloadedButtons" Visibility="Collapsed">
                    <ui:Button x:Name="BtnInstallOnClose" Content="Kapanırken Yükle" Click="BtnInstallOnClose_Click"
                               Appearance="Secondary" Height="36" Padding="14,0" HorizontalAlignment="Left" Cursor="Hand"/>
                    <ui:Button x:Name="BtnRestartNow" Content="Şimdi Yeniden Başlat" Click="BtnRestartNow_Click"
                               Appearance="Success" Height="36" Padding="20,0" HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
