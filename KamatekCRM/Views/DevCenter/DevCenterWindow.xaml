<Window x:Class="KamatekCrm.Views.DevCenter.DevCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KamatekCrm.ViewModels.DevCenter"
        Title="Geliştirici Merkezi"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Width" Value="248"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="LogList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- GENEL BAKIŞ -->
        <DataTemplate DataType="{x:Type vm:OverviewTabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <StackPanel>
                    <TextBlock Text="{Binding LastRefreshedText}" Style="{StaticResource LabelText}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="UYGULAMA SÜRÜMÜ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding AppVersion}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="MAKİNE" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding MachineName}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="İŞLETİM SİSTEMİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding OperatingSystem}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text=".NET SÜRÜMÜ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding RuntimeVersion}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="SÜREÇ / THREAD" Style="{StaticResource LabelText}"/>
                                <TextBlock Style="{StaticResource ValueText}">
                                    <Run Text="{Binding ProcessId, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding ThreadCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ÇALIŞMA KÜMESİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding WorkingSetText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ÇALIŞMA SÜRESİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="LOG SEVİYESİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding LevelName}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="BELLEK TAMPONU" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding BufferSummary}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="DÜŞÜRÜLEN OLAY" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding DroppedCount}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="TANILAMA" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding IsDiagnosticsEnabled}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="YETKİLİ GELİŞTİRİCİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding DeveloperAccountCount}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Border Style="{StaticResource InfoCard}" Width="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="LOG DİZİNİ" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource ValueText}"/>
                            <TextBlock Text="TANILAMA DİZİNİ" Style="{StaticResource LabelText}" Margin="0,10,0,3"/>
                            <TextBlock Text="{Binding DiagnosticsDirectory}" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- CANLI LOGLAR -->
        <DataTemplate DataType="{x:Type vm:LiveLogsTabViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <ComboBox Width="170" Height="32" ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"/>
                    <TextBox Width="260" Height="32" Margin="8,0,0,0" ToolTip="Mesaj, modül veya olay kodu ara"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:Button Content="Duraklat / Devam" Margin="8,0,0,0" Appearance="Secondary"
                               Command="{Binding TogglePauseCommand}"/>
                    <ui:Button Content="Temizle" Margin="8,0,0,0" Appearance="Secondary"
                               Command="{Binding ClearCommand}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </WrapPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource LogList}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLine}" FontFamily="Consolas" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StackTrace}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <!-- HATA MERKEZİ -->
        <DataTemplate DataType="{x:Type vm:ErrorCenterTabViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding StatusText}" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" Style="{StaticResource LogList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="8" CornerRadius="8"
                                    Background="{DynamicResource SurfacePageBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource ThemePrimary}"/>
                                        <TextBlock Text="{Binding LastSeenText}" FontSize="11" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SampleMessage}" FontSize="12" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBodyBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <!-- ÇÖKME VE DONMA -->
        <DataTemplate DataType="{x:Type vm:CrashReportsTabViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding StatusText}" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Crashes}" Style="{StaticResource LogList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding CreatedAtUtc, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SizeBytes, Mode=OneWay, StringFormat='{}{0:N0} bayt'}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding PolicyNote}" Style="{StaticResource NoteText}"/>
            </Grid>
        </DataTemplate>

        <!-- PERFORMANS -->
        <DataTemplate DataType="{x:Type vm:PerformanceTabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <StackPanel>
                    <WrapPanel>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ÇALIŞMA KÜMESİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding WorkingSetText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ÖZEL BELLEK" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding PrivateMemoryText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="THREAD SAYISI" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding ThreadCountText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="YÖNETİLEN BELLEK" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding GcMemoryText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ÇALIŞMA SÜRESİ" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding LastRefreshedText}" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ScopeNote}" Style="{StaticResource NoteText}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- XAML / BINDING -->
        <DataTemplate DataType="{x:Type vm:BindingIssuesTabViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding StatusText}" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Issues}" Style="{StaticResource LogList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" Margin="2,4"
                                       ToolTip="{Binding Message}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding ScopeNote}" Style="{StaticResource NoteText}"/>
            </Grid>
        </DataTemplate>

        <!-- DERLEME VE KOD ANALİZİ (hazır değil) -->
        <DataTemplate DataType="{x:Type vm:BuildAnalysisTabViewModel}">
            <Border Style="{StaticResource InfoCard}" Width="Auto" Padding="20" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ValueText}" FontSize="16"/>
                    <TextBlock Text="{Binding AvailabilityNote}" Style="{StaticResource NoteText}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- OTOMATİK TESTLER (hazır değil) -->
        <DataTemplate DataType="{x:Type vm:AutomatedTestsTabViewModel}">
            <Border Style="{StaticResource InfoCard}" Width="Auto" Padding="20" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ValueText}" FontSize="16"/>
                    <TextBlock Text="{Binding AvailabilityNote}" Style="{StaticResource NoteText}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- TANILAMA PAKETİ -->
        <DataTemplate DataType="{x:Type vm:DiagnosticPackageTabViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <CheckBox Content="Logları dahil et" IsChecked="{Binding IncludeLogs, Mode=TwoWay}"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextBodyBrush}"/>
                    <CheckBox Content="Çökme izlerini dahil et" IsChecked="{Binding IncludeCrashes, Mode=TwoWay}"
                              Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBodyBrush}"/>
                    <ui:Button Content="Paket Oluştur" Margin="16,0,0,0" Appearance="Primary"
                               Command="{Binding CreatePackageCommand}"/>
                    <ui:Button Content="Dizini Aç" Margin="8,0,0,0" Appearance="Secondary"
                               Command="{Binding OpenExportFolderCommand}"/>
                    <TextBlock Text="Oluşturuluyor..." Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource ThemePrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource LabelText}" Margin="0"/>
                    <TextBox Text="{Binding LastPackagePath, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                             Foreground="{DynamicResource TextBodyBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             ToolTip="{Binding LastPackagePath}"/>
                </StackPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Packages}" Style="{StaticResource LogList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource TextHeadingBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Sil" Appearance="Secondary"
                                           Command="{Binding DataContext.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="{Binding ExportsDirectory}" Style="{StaticResource LabelText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding ScopeNote}" Style="{StaticResource NoteText}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- API / DB SAĞLIĞI -->
        <DataTemplate DataType="{x:Type vm:HealthTabViewModel}">
            <StackPanel>
                <WrapPanel>
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="VERİTABANI" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding DatabaseStatus}" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="API" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding ApiStatus}" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Şimdi Kontrol Et" Command="{Binding CheckCommand}" Appearance="Primary"/>
                    <TextBlock Text="{Binding LastCheckedText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Kontroller 5 saniye zaman aşımıyla arka planda çalışır; hata mesajı yerine yalnızca hata tipi gösterilir."
                           Style="{StaticResource NoteText}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Settings24" FontSize="26" Foreground="{DynamicResource ThemePrimary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GELİŞTİRİCİ MERKEZİ" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="Canlı loglar, hatalar, çökme izleri, performans ve sağlık kontrolleri"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"/>
                <ui:Button Content="Yenile" Command="{Binding RefreshCommand}" Appearance="Secondary"/>
            </StackPanel>
        </Grid>

        <!-- SEKMELER -->
        <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="13"/>
                        <TextBlock Text="{Binding Title}" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   Text="Bu ekran yalnızca yetkili geliştirici hesaplarına açıktır; tüm veri çağrıları servis seviyesinde yeniden yetkilendirilir."/>
    </Grid>
</Window>
