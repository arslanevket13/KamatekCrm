<UserControl x:Class="KamatekCrm.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:km="clr-namespace:KamatekCrm.Components"
             xmlns:converters="clr-namespace:KamatekCrm.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource SurfacePageBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageRoot}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════ ROW 0: HEADER ═══════════════ -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <!-- Right: Refresh Button -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Yenile" 
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding RefreshDashboardCommand}"
                               Appearance="Secondary"
                               Height="38" Padding="16,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Left: Welcome & Date -->
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        <Run Text="Komut Merkezi • "/>
                        <Run Text="{Binding TodayDate, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- ═══════════════ ROW 1: QUICK ACTION RIBBON ═══════════════ -->
            <Border Grid.Row="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,24"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0"/>
                        <TextBlock Text="Hızlı İşlemler" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextHeadingBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Yeni Arıza / Cihaz Kaydı" Icon="{ui:SymbolIcon Wrench24}"
                                   Command="{Binding OpenFaultTicketCommand}"
                                   Appearance="Primary" Margin="0,0,8,0" Height="36" Padding="14,0" Cursor="Hand"/>

                        <ui:Button Content="Hızlı Satış (POS)" Icon="{ui:SymbolIcon Cart24}"
                                   Command="{Binding OpenDirectSalesCommand}"
                                   Appearance="Secondary" Margin="0,0,8,0" Height="36" Padding="14,0" Cursor="Hand"/>

                        <ui:Button Content="Fiyat Teklifi Hazırla" Icon="{ui:SymbolIcon DocumentAdd24}"
                                   Command="{Binding OpenQuotationCommand}"
                                   Appearance="Secondary" Height="36" Padding="14,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ ROW 2: PRIMARY KPI'LAR (MAX 4) ═══════════════ -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,24">
                <km:KmKpiCard Title="Bugünkü Satış"
                               Value="{Binding TodaySalesTotal}"
                               Prefix="₺" Format="N0"
                               Icon="&#xEAFD;"
                               Subtitle="{Binding TodaySalesCountText}"
                               AccentBrush="{DynamicResource KpiGradientPurple}"
                               Margin="0,0,16,0"/>

                <km:KmKpiCard Title="Aylık Satış"
                               Value="{Binding MonthlySalesTotal}"
                               Prefix="₺" Format="N0"
                               Icon="&#xE9D2;"
                               Subtitle="{Binding CurrentMonthName}"
                               AccentBrush="{DynamicResource KpiGradientGreen}"
                               Margin="0,0,16,0"/>

                <km:KmKpiCard Title="Aktif İşler" 
                               Value="{Binding ActiveJobsCount}" 
                               Icon="&#xE90F;"
                               Subtitle="devam ediyor"
                               AccentBrush="{DynamicResource KpiGradientOrange}"
                               Margin="0,0,16,0"/>

                <km:KmKpiCard Title="Teslime Hazır" 
                               Value="{Binding ReadyRepairsCount}" 
                               Icon="&#xE73E;"
                               Subtitle="cihaz bekliyor"
                               AccentBrush="{DynamicResource KpiGradientCyan}"
                               Margin="0,0,0,0"/>
            </UniformGrid>

            <!-- ═══════════════ ROW 3: MAIN GRID (LEFT: CHARTS & ALERTS, RIGHT: JOBS & READY REPAIRS) ═══════════════ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ 1. GRAFİK BÖLÜMÜ ═══ -->
                    <Border Grid.Row="0" CornerRadius="12" Margin="0,0,0,20" Padding="24"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="20" 
                                                   Foreground="{DynamicResource ThemePrimary}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Haftalık Performans Trendi" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextHeadingBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Son 7 günlük gelir ve tamamlanan iş dağılımı" FontSize="12" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="30,2,0,0"/>
                            </StackPanel>

                            <lvc:CartesianChart Grid.Row="1" 
                                                Series="{Binding WeeklyTrendSeries}"
                                                XAxes="{Binding WeeklyTrendXAxes}"
                                                YAxes="{Binding WeeklyTrendYAxes}"
                                                Height="240"
                                                TooltipPosition="Top"
                                                ZoomMode="X"/>
                        </Grid>
                    </Border>

                    <!-- ═══ 2. KRİTİK UYARILAR BÖLÜMÜ ═══ -->
                    <Border Grid.Row="1" CornerRadius="12" Padding="24"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                                    Background="{DynamicResource StatusErrorBg}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="20" 
                                                   Foreground="{DynamicResource StatusErrorFg}" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Kritik Stok Uyarısı" FontSize="14" FontWeight="Bold" 
                                                   Foreground="{DynamicResource StatusErrorFg}"/>
                                        <TextBlock Text="Minimum seviyenin altındaki ürünler" FontSize="11" 
                                                   Foreground="{DynamicResource StatusErrorFg}" Opacity="0.8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stock List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                                        Background="{DynamicResource HoverOverlayBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding ProductName}" 
                                                                       FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{DynamicResource TextHeadingBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding UrgencyLevel}" FontSize="11" Foreground="{DynamicResource StatusErrorFg}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="12,4" Background="{DynamicResource StatusErrorFg}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CurrentStock}" 
                                                                       FontWeight="Bold" FontSize="16"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty State -->
                                    <km:KmEmptyState Icon="&#xE73E;" Title="Stoklar Yeterli"
                                                     Message="Tüm ürünlerin stok seviyeleri normal."
                                                     Visibility="{Binding IsLowStockEmpty, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT COLUMN -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ 1. BUGÜNÜN İŞLERİ BÖLÜMÜ ═══ -->
                    <Border Grid.Row="0" CornerRadius="12" Padding="24" Margin="0,0,0,20"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                                    Background="{DynamicResource StatusInfoBg}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="20" 
                                                   Foreground="{DynamicResource StatusInfoFg}" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Bugünün İşleri" FontSize="14" FontWeight="Bold" 
                                                   Foreground="{DynamicResource StatusInfoFg}"/>
                                        <TextBlock Text="Planlanan saha &amp; servis randevuları" FontSize="11" 
                                                   Foreground="{DynamicResource StatusInfoFg}" Opacity="0.8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Today's Jobs List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="240">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding TodaysJobs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                                        Background="{DynamicResource HoverOverlayBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource StatusInfoFg}" 
                                                                CornerRadius="6" Padding="10,4" Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ScheduledTime, TargetNullValue='Bugün'}" 
                                                                       FontWeight="Bold" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CustomerName}" 
                                                                       FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{DynamicResource TextHeadingBrush}"/>
                                                            <TextBlock Text="{Binding Category}" FontSize="11" 
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty State -->
                                    <km:KmEmptyState Icon="&#xE787;" Title="İş Yok"
                                                     Message="Bugün planlanmış iş bulunmuyor."
                                                     Visibility="{Binding IsTodaysJobsEmpty, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ═══ 2. TESLİME HAZIR CİHAZLAR WIDGET ═══ -->
                    <Border Grid.Row="1" CornerRadius="12" Padding="24"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                                    Background="{DynamicResource KpiPurpleStartColor}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Teslime Hazır Cihazlar" FontSize="14" FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Müşteri teslimatı bekleyen tamirler" FontSize="11" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ready Repairs List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ReadyToDeliverRepairs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                                        Background="{DynamicResource HoverOverlayBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding CustomerName}" 
                                                                       FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{DynamicResource TextHeadingBrush}"/>
                                                            <TextBlock Text="{Binding DeviceInfo}" FontSize="11" 
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource ThemeSuccess}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="Hazır" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty State -->
                                    <km:KmEmptyState Icon="&#xE7B8;" Title="Bekleyen Cihaz Yok"
                                                     Message="Teslim edilmeyi bekleyen tamir cihazı yok."
                                                     Visibility="{Binding IsReadyRepairsEmpty, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
