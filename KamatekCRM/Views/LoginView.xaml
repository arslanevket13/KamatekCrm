<UserControl x:Class="KamatekCrm.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480"/>
            <ColumnDefinition Width="480"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ LEFT COLUMN: BRANDING & FEATURE SHOWCASE HERO PANEL ═══════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfacePageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Logo -->
            <StackPanel Grid.Row="0" Margin="48,48,48,0">
                <Image Source="/Assets/Images/KamatekLogo.png" 
                       Width="220" Height="Auto"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Center Content & Feature Showcase -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0">
                <TextBlock Text="Kamatek CRM &amp; ERP" 
                           FontSize="32" FontWeight="Bold" 
                           Foreground="{DynamicResource TextHeadingBrush}" 
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="Teknik Servis, Saha İş Gücü, Stok &amp; Finans Yönetim Portalı" 
                           FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,0,0,36"/>

                <!-- Feature Highlights List -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Saha Servis &amp; Arıza Takibi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Müşteri taleplerini, arıza fişlerini ve teknisyen rotalarını canlı izleyin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="20" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Canlı Stok &amp; Fiyat Teklifi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Ürün envanterini, depo hareketlerini ve teklif yönetimini dijitalleştirin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Zero-Config Otomatik Ağ Keşfi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Yerel ağdaki veritabanı sunucularını sürücü kurmadan otomatik bulun" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Connection Status Indicator -->
            <Border Grid.Row="2" Margin="48,0,48,48" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Server24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ServerStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        <TextBlock Text="Yerel Veritabanı Servis Durumu" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ RIGHT COLUMN: LOGIN FORM ═══════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Action Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24">
                <ComboBox x:Name="LanguageCombo"
                          Width="110" SelectedIndex="0" FontSize="12" Margin="0,0,8,0" Cursor="Hand">
                    <ComboBoxItem Content="🇹🇷 Türkçe" Tag="tr-TR"/>
                    <ComboBoxItem Content="🇬🇧 English" Tag="en-US"/>
                    <ComboBoxItem Content="🇩🇪 Deutsch" Tag="de-DE"/>
                </ComboBox>
                
                <ui:Button Appearance="Transparent" 
                           Command="{Binding OpenConnectionSettingsCommand}"
                           ToolTip="Ağ ve Sunucu Ayarları"
                           Cursor="Hand" Padding="8">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>
            </StackPanel>

            <!-- Center Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0">
                <!-- Welcome Title -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Hoş Geldiniz" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Devam etmek için kullanıcı hesabınızla giriş yapın" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Username Input -->
                <StackPanel Margin="0,0,0,16">
                    <Label Content="Kullanıcı Adı" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ui:TextBox x:Name="UsernameTextBox"
                                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                Icon="Person24"
                                PlaceholderText="Kullanıcı adınızı giriniz"
                                ClearButtonEnabled="True"
                                Height="42"/>
                </StackPanel>

                <!-- Password Input -->
                <StackPanel Margin="0,0,0,16">
                    <Label Content="Şifre" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ui:PasswordBox x:Name="PasswordBox"
                                    Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="LockClosed24"
                                    PlaceholderText="Şifrenizi giriniz"
                                    Height="42"/>
                </StackPanel>

                <!-- Options Row -->
                <Grid Margin="0,4,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ui:ToggleSwitch Grid.Column="0"
                                     Content="Beni Hatırla" 
                                     IsChecked="{Binding RememberMe}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    
                    <TextBlock Grid.Column="1"
                               Text="Şifremi Unuttum"
                               Foreground="{DynamicResource ThemePrimary}"
                               FontSize="13"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               MouseLeftButtonUp="ForgotPassword_Click"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Error Message Banner -->
                <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="8" 
                        Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Server Not Found Fallback Banner -->
                <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="8" 
                        Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding IsServerNotFound, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Sunucu Bulunamadı" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Content="Bağlantıyı Manuel Yapılandır"
                                   Command="{Binding OpenConnectionSettingsCommand}"
                                   Appearance="Secondary"
                                   HorizontalAlignment="Stretch"
                                   Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Primary Login Button -->
                <ui:Button x:Name="LoginBtn"
                           Content="Sisteme Giriş Yap"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding LoginCommand}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Height="44"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Cursor="Hand"/>
            </StackPanel>

            <!-- Bottom Footer Copyright -->
            <TextBlock Grid.Row="2" 
                       Text="v1.0.1 © 2026 Kamatek Bilişim &amp; Güvenlik Teknolojileri"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorDisabledBrush}"
                       FontSize="11"
                       Margin="0,0,0,32"/>
        </Grid>
    </Grid>
</UserControl>
