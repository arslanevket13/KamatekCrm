<UserControl x:Class="KamatekCrm.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ LEFT COLUMN: BRANDING & FEATURE SHOWCASE HERO PANEL ═══════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfacePageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Logo -->
            <StackPanel Grid.Row="0" Margin="48,48,48,0">
                <Image Source="/Assets/Images/KamatekLogo.png" 
                       Width="220" Height="Auto"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Center Content & Feature Showcase -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0">
                <TextBlock Text="Kamatek CRM &amp; ERP" 
                           FontSize="32" FontWeight="Bold" 
                           Foreground="{DynamicResource TextHeadingBrush}" 
                           Margin="0,0,0,8"/>
                
                <TextBlock Text="Teknik Servis, Saha İş Gücü, Stok &amp; Finans Yönetim Portalı" 
                           FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,0,0,36"/>

                <!-- Feature Highlights List -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Saha Servis &amp; Arıza Takibi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Müşteri taleplerini, arıza fişlerini ve teknisyen rotalarını canlı izleyin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="20" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Canlı Stok &amp; Fiyat Teklifi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Ürün envanterini, depo hareketlerini ve teklif yönetimini dijitalleştirin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Border Background="{DynamicResource AccentOverlayBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Zero-Config Otomatik Ağ Keşfi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Yerel ağdaki veritabanı sunucularını sürücü kurmadan otomatik bulun" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Connection Status Indicator -->
            <Border Grid.Row="2" Margin="48,0,48,48" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Server24" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerFound}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSearchingForServer}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsServerNotFound}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ServerStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Yerel Veritabanı Servis Durumu" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ui:ProgressRing Grid.Column="2"
                                     Width="18" Height="18"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"
                                     Visibility="{Binding IsSearchingForServer, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ RIGHT COLUMN: LOGIN FORM ═══════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Action Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,20,24,0">
                <ui:Button Appearance="Transparent" 
                           Command="{Binding OpenConnectionSettingsCommand}"
                           ToolTip="Ağ ve Sunucu Ayarları"
                           Content="Ağ Ayarları"
                           Icon="{ui:SymbolIcon Settings24}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Cursor="Hand" Padding="10,6"/>
            </StackPanel>

            <!-- Center Form (Scrollable so banners never clip LoginBtn) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" Margin="44,16">
                    <!-- Welcome Title -->
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="Hoş Geldiniz" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Devam etmek için kullanıcı hesabınızla giriş yapın" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Username Input -->
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Kullanıcı Adı" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="UsernameTextBox"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="Person24"
                                    PlaceholderText="Kullanıcı adınızı giriniz"
                                    ClearButtonEnabled="True"
                                    PreviewKeyDown="UsernameTextBox_PreviewKeyDown"
                                    Height="42"/>
                    </StackPanel>

                    <!-- Password Input -->
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="Şifre" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:PasswordBox x:Name="PasswordBox"
                                        Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="LockClosed24"
                                        PlaceholderText="Şifrenizi giriniz"
                                        Height="42"/>
                        <Border Background="{DynamicResource StatusWarningBg}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding IsCapsLockOn, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning20" FontSize="14" Foreground="{DynamicResource StatusWarningFg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Caps Lock açık — şifreniz büyük harfle yazılabilir."
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource StatusWarningFg}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Options Row -->
                    <Grid Margin="0,4,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ui:ToggleSwitch Grid.Column="0"
                                         Content="Beni Hatırla" 
                                         IsChecked="{Binding RememberMe}"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        
                        <ui:Button Grid.Column="1"
                                   Content="Şifremi Unuttum"
                                   Command="{Binding ForgotPasswordCommand}"
                                   Appearance="Transparent"
                                   Foreground="{DynamicResource ThemePrimary}"
                                   FontSize="13"
                                   Padding="6,2"
                                   Cursor="Hand"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Error Message Banner -->
                    <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="8" 
                            Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource StatusErrorFg}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" 
                                       Foreground="{DynamicResource StatusErrorFg}" 
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Server Not Found Fallback Banner -->
                    <Border Background="{DynamicResource StatusWarningBg}" CornerRadius="8" 
                            Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IsServerNotFound, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource StatusWarningFg}" Margin="0,0,10,0"/>
                                <TextBlock Text="Sunucu Bağlantısı Kurulamadı" Foreground="{DynamicResource StatusWarningFg}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:Button Content="Bağlantıyı Manuel Yapılandır (Ağ Ayarları)"
                                       Command="{Binding OpenConnectionSettingsCommand}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Primary Login Button -->
                    <ui:Button x:Name="LoginBtn"
                               Command="{Binding LoginCommand}"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Height="44"
                               FontSize="15"
                               FontWeight="SemiBold"
                               IsDefault="True"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing Width="16" Height="16"
                                             IsIndeterminate="True"
                                             Margin="0,0,10,0"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16"
                                           Margin="0,0,8,0"
                                           Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding LoginButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- DEV-ONLY Quick Admin Login Button -->
                    <ui:Button x:Name="DevQuickLoginBtn"
                               Command="{Binding DevQuickLoginCommand}"
                               Visibility="{Binding IsDebugQuickLoginVisible, Converter={StaticResource BoolToVis}}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Height="38"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBodyBrush}"
                               BorderBrush="{DynamicResource BorderSubtleBrush}"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Key24" FontSize="15"
                                           Foreground="{DynamicResource ThemePrimary}"
                                           Margin="0,0,8,0"/>
                            <TextBlock Text="Hızlı Admin Girişi (DEBUG)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Footer Copyright -->
            <TextBlock Grid.Row="2" 
                       Text="v1.0.1 © 2026 Kamatek Bilişim &amp; Güvenlik Teknolojileri"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorDisabledBrush}"
                       FontSize="11"
                       Margin="0,12,0,24"/>
        </Grid>
    </Grid>
</UserControl>
