<Window x:Class="KamatekCrm.Views.ProductPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Stoktan Ürün Ekle"
        Width="760" Height="560"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Stoktan ürün seçme"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="STOKTAN ÜRÜN EKLE" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Ürün adı veya koduyla arayın; çift tıklayarak veya 'Ekle' ile teklife ekleyin."/>
        </StackPanel>

        <ui:TextBox Grid.Row="1" x:Name="SearchBox"
                    PlaceholderText="Ürün adı veya SKU (en az 2 karakter)..."
                    Icon="{ui:SymbolIcon Search24}"
                    Height="40" Margin="0,0,0,10" TextChanged="SearchBox_TextChanged"/>

        <DataGrid Grid.Row="2" x:Name="ResultsGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0" MinRowHeight="34"
                  AlternatingRowBackground="#0A000000" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="60"/>
                <DataGridTemplateColumn Header="Stok" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StockQuantity}" TextAlignment="Right" Margin="0,0,8,0"
                                       VerticalAlignment="Center" ToolTip="Güncel toplam stok miktarı">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockQuantity}" Value="0">
                                                <Setter Property="Foreground" Value="#C61F25"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockQuantity}" Value="1">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockQuantity}" Value="2">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Satış Fiyatı (₺)" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Content="Vazgeç" Click="CancelButton_Click"
                           Appearance="Secondary" Height="38" Padding="18,0" Margin="0,0,8,0" Cursor="Hand"/>
                <ui:Button x:Name="AddButton" Content="➕ Ekle" Click="AddButton_Click"
                           Appearance="Primary" Height="38" Padding="20,0" Cursor="Hand" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
