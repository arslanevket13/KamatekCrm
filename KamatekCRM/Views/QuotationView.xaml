<UserControl x:Class="KamatekCrm.Views.QuotationView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:converters="clr-namespace:KamatekCrm.Converters"
              mc:Ignorable="d" 
              d:DesignHeight="768" d:DesignWidth="1100"
              Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main Form Container -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="*"/>    <!-- Row 1: Body -->
            </Grid.RowDefinitions>

            <!-- ════════ ROW 0: HEADER ════════ -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="20,16" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ThemePrimary}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fiyat Teklifi Hazırla" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <Border Background="{DynamicResource ThemeSidebarHover}" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding QuoteNumber}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Müşterinize özel teknik ve ticari teklif oluşturun ve kar marjını izleyin" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Dynamic Profit Margin Badge -->
                        <Border Background="{Binding ProfitColor}" CornerRadius="12" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfitDisplay}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>

                        <ui:Button Command="{Binding SaveQuoteCommand}" 
                                   Icon="{ui:SymbolIcon Save24}" Content="Teklifi Kaydet"
                                   Appearance="Primary" Height="40" Padding="16,0" Margin="0,0,8,0"/>

                        <ui:Button Command="{Binding ExportPdfCommand}" 
                                   Icon="{ui:SymbolIcon DocumentPdf24}" Content="PDF Oluştur"
                                   Appearance="Secondary" Height="40" Padding="16,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ════════ ROW 1: BODY ════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Master Info Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="MÜŞTERİ &amp; TEKLİF BİLGİLERİ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,16"/>
                            
                            <!-- Müşteri Seçimi -->
                            <StackPanel Margin="0,0,0,16">
                                <Label Content="Müşteri Seçin *" Style="{StaticResource ModernLabel}"/>
                                <ComboBox ItemsSource="{Binding Customers}" 
                                          SelectedItem="{Binding SelectedCustomer}" 
                                          DisplayMemberPath="FullName" 
                                          IsEditable="True" Height="38"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>

                            <!-- Para Birimi -->
                            <StackPanel Margin="0,0,0,16">
                                <Label Content="Para Birimi" Style="{StaticResource ModernLabel}"/>
                                <ComboBox ItemsSource="{Binding Currencies}" 
                                          SelectedItem="{Binding SelectedCurrency}" 
                                          Height="38"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>

                            <!-- Teklif Tarihi -->
                            <StackPanel Margin="0,0,0,16">
                                <Label Content="Teklif Tarihi" Style="{StaticResource ModernLabel}"/>
                                <DatePicker SelectedDate="{Binding QuoteDate}" Height="38"/>
                            </StackPanel>

                            <!-- Geçerlilik Tarihi -->
                            <StackPanel Margin="0,0,0,16">
                                <Label Content="Geçerlilik Tarihi" Style="{StaticResource ModernLabel}"/>
                                <DatePicker SelectedDate="{Binding ValidUntil}" Height="38"/>
                            </StackPanel>

                            <!-- Şartlar ve Notlar -->
                            <StackPanel>
                                <Label Content="Teklif Notları &amp; Şartlar" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="100"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Quote Lines Table -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Teklif Kalemleri" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                            <ui:Button Command="{Binding ToggleSidebarCommand}" 
                                       Icon="{ui:SymbolIcon Add24}" Content="Malzeme Ekle"
                                       Appearance="Primary" HorizontalAlignment="Right" Height="36" Padding="14,0"/>
                        </DockPanel>

                        <!-- Quote Lines DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding QuoteLines}" 
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" 
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <!-- Ürün Adı -->
                                <DataGridTextColumn Header="Ürün / Hizmet" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>
                                
                                <!-- Stok -->
                                <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding CurrentStockQuantity}" Width="90" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Miktar (+/- Spinners) -->
                                <DataGridTemplateColumn Header="Miktar" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:Button Icon="{ui:SymbolIcon Subtract12}"
                                                           Command="{Binding DataContext.DecreaseLineQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Height="24" Width="24" Padding="0" Appearance="Secondary"/>
                                                <TextBlock Text="{Binding Quantity}" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                                                <ui:Button Icon="{ui:SymbolIcon Add12}"
                                                           Command="{Binding DataContext.IncreaseLineQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Height="24" Width="24" Padding="0" Appearance="Secondary"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='{}₺{0:N2}'}" Width="110"/>
                                <DataGridTextColumn Header="İskonto %" Binding="{Binding DiscountPercent, StringFormat='{}%{0:N0}'}" Width="80"/>
                                <DataGridTextColumn Header="Satır Toplamı" Binding="{Binding LineTotal, StringFormat='{}₺{0:N2}'}" Width="120" IsReadOnly="True" FontWeight="Bold"/>

                                <!-- İŞLEMLER KOLONU (Sil) -->
                                <DataGridTemplateColumn Header="İşlemler" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                       Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       Appearance="Secondary" Height="28" Width="28" Padding="0" Foreground="#F44336" ToolTip="Listeden Çıkar"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Totals Summary -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfacePageBrush}" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                            <StackPanel HorizontalAlignment="Right" Width="300">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Ara Toplam:" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <TextBlock Text="{Binding SubTotal, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="İskonto Toplamı:" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <TextBlock Text="{Binding TotalDiscount, StringFormat='{}-₺{0:N2}'}" HorizontalAlignment="Right" Foreground="#F44336"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="KDV Toplamı:" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <TextBlock Text="{Binding TotalTax, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Separator Margin="0,0,0,8" Background="{DynamicResource ThemeDivider}"/>
                                <DockPanel>
                                    <TextBlock Text="GENEL TOPLAM:" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ThemePrimary}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Product Search Drawer (Sidebar Popup when IsSidebarOpen = true) -->
        <Grid Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100">
            <!-- Dim Backdrop -->
            <Border Background="#60000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Right Drawer Container -->
            <Border HorizontalAlignment="Right" Width="400" 
                    Background="{DynamicResource SurfacePageBrush}" 
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="📦 Malzeme &amp; Hizmet Ekle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ToggleSidebarCommand}" Appearance="Secondary" HorizontalAlignment="Right" Width="32" Height="32" Padding="0"/>
                    </DockPanel>

                    <!-- Search Input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <Label Content="Ürün Adı veya SKU Ara" Style="{StaticResource ModernLabel}"/>
                        <ui:TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Search24}" Height="38"/>
                    </StackPanel>

                    <!-- Search Results List with Rich Product Cards -->
                    <Border Grid.Row="2" Background="{DynamicResource CardPanel}" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                        <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedProduct}" Height="300" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfacePageBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Image Thumbnail -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                                    Background="{DynamicResource ThemeSidebarHover}" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Box24" FontSize="18" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Stretch="UniformToFill" Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding SKU, StringFormat='SKU: {0}'}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding TotalStockQuantity, StringFormat='Stok: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSuccess}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SalePrice, StringFormat='₺{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemePrimary}"/>
                                                <ui:Button Command="{Binding DataContext.AddProductDirectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                           CommandParameter="{Binding}"
                                                           Icon="{ui:SymbolIcon Add12}" Content="Ekle"
                                                           Appearance="Primary" Height="26" Padding="8,0" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Quantity & Add Action -->
                    <StackPanel Grid.Row="3">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Miktar" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="İskonto %" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding NewDiscount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <ui:Button Command="{Binding AddProductCommand}" 
                                   Icon="{ui:SymbolIcon Add24}" Content="Seçili Ürünü Ekle"
                                   Appearance="Primary" Height="40" FontWeight="Bold" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
