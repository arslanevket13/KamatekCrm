<Window x:Class="KamatekCrm.Views.AddUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Yeni Kullanıcı Oluştur" 
        Width="520" Height="680"
        MinWidth="460" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PersonAdd24" FontSize="26" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yeni Kullanıcı Oluştur" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="Yönetici (Admin) yetkisi ile yeni personel veya yönetici tanımı yapın" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ FORM CONTENT ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- BÖLÜM 1: TEMEL BİLGİLER -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Person24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Temel Kullanıcı Bilgileri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Ad *" FontWeight="SemiBold"/>
                                <ui:TextBox x:Name="AdTextBox" Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Soyad *" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding Soyad, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Kullanıcı Adı *" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                                <TextBlock Text="{Binding UsernameValidationMessage}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource ThemePrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Telefon Numarası" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="05XX XXX XX XX" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,4">
                            <Label Content="Kullanıcı Rolü *" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding RoleDisplayOptions}"
                                      SelectedItem="{Binding SelectedRoleDisplay}"
                                      Height="38"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- BÖLÜM 2: BAŞLANGIÇ PAROLASI -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Başlangıç Parolası" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox Content="Özel Başlangıç Parolası Belirle" IsChecked="{Binding IsCustomPassword}" Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsCustomPassword, Converter={StaticResource BoolToVis}}">
                            <Label Content="Özel Parola *" FontWeight="SemiBold"/>
                            <ui:TextBox Text="{Binding InitialPassword, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                        </StackPanel>

                        <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0"
                                Visibility="{Binding IsCustomPassword, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource StatusInfoFg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Varsayılan parola '1234' olarak ayarlanacaktır." FontSize="11" Foreground="{DynamicResource StatusInfoFg}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- BÖLÜM 3: MODÜL ERİŞİM YETKİLERİ (RBAC) -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modül Erişim Yetkileri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox Content="Finansal Kayıtları Gör" IsChecked="{Binding CanViewFinance}" Margin="0,0,0,10"/>
                        <CheckBox Content="Analiz ve Raporları Gör" IsChecked="{Binding CanViewAnalytics}" Margin="0,0,0,10"/>
                        <CheckBox Content="Kayıt Silme Yetkisi" IsChecked="{Binding CanDeleteRecords}" Margin="0,0,0,10"/>
                        <CheckBox Content="Satın Alma Onay Yetkisi" IsChecked="{Binding CanApprovePurchase}" Margin="0,0,0,10"/>
                        <CheckBox Content="Sistem Ayarlarına Erişim" IsChecked="{Binding CanAccessSettings}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- BÖLÜM 4: SAHA & TEKNİSYEN DETAYLARI -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16"
                        Visibility="{Binding IsTechnicianRole, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Foreground="{DynamicResource ThemeSuccess}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Saha &amp; Teknisyen Detayları" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Araç Plakası" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding VehiclePlate}" PlaceholderText="34 ABC 123" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Hizmet Bölgesi" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding ServiceArea}" PlaceholderText="Örn: Eskişehir Merkez" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <Label Content="Uzmanlık Alanları" FontWeight="SemiBold"/>
                            <ui:TextBox Text="{Binding ExpertiseAreas}" PlaceholderText="CCTV, Diafon, Yangın Alarm..." Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status Message Overlay -->
                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource StatusErrorBg}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ BOTTOM BUTTONS ═══════════════ -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <ui:Button DockPanel.Dock="Left" Content="Temizle" Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding ClearCommand}" Appearance="Secondary" Height="38" Padding="16,0" Cursor="Hand"/>

            <ui:Button DockPanel.Dock="Right" Content="Kullanıcıyı Kaydet" Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding SaveCommand}" Appearance="Primary" Height="38" Padding="20,0" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
