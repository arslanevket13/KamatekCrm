<Window x:Class="KamatekCrm.Views.WorkOrderQuotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KamatekCrm.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Fiyat Teklifi" 
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Fiyat teklifi düzenleme"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintPdfCommand}"/>
    </Window.InputBindings>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Başlık ── -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FİYAT TEKLİFİ" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Teklif No: "/><Run Text="{Binding QuotationNumber}" FontWeight="SemiBold"/>
                    <Run Text="   |   Durum: "/><Run Text="{Binding StatusDisplay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="🖨️ PDF" Command="{Binding PrintPdfCommand}" Appearance="Secondary"
                           Height="34" Padding="16,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Fiyat Teklifi PDF'i oluştur (Ctrl+P)"/>
                <ui:Button Content="❌ Reddet" Command="{Binding RejectCommand}" Appearance="Danger"
                           Height="34" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                           IsEnabled="{Binding IsEditable}"/>
                <ui:Button Content="✅ Kabul Et" Command="{Binding AcceptCommand}" Appearance="Success"
                           Height="34" Padding="16,0" Cursor="Hand"
                           IsEnabled="{Binding IsEditable}"/>
            </StackPanel>
        </Grid>

        <!-- ── İçerik ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Teklif Kalemleri -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TEKLİF KALEMLERİ" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                              AlternatingRowBackground="#0A000000" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Malzeme / Hizmet" Binding="{Binding ProductName}" Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Birim Fiyat (₺)" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                            <DataGridTextColumn Header="İskonto %" Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="KDV %" Binding="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Ara Toplam" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="95"
                                                IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Sağ: Şartlar ve Tutarlar -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TUTARLAR" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="İşçilik (₺)" VerticalAlignment="Center" FontSize="12"/>
                                <ui:NumberBox Grid.Row="0" Grid.Column="1" Value="{Binding LaborCost}" Minimum="0"
                                              HorizontalAlignment="Stretch" Height="30" Margin="6,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nakliye (₺)" VerticalAlignment="Center" FontSize="12"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding ShippingCost}" Minimum="0"
                                              HorizontalAlignment="Stretch" Height="30" Margin="6,0,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="İskonto (₺)" VerticalAlignment="Center" FontSize="12"/>
                                <ui:NumberBox Grid.Row="2" Grid.Column="1" Value="{Binding DiscountAmount}" Minimum="0"
                                              HorizontalAlignment="Stretch" Height="30" Margin="6,0,0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="KDV Oranı (%)" VerticalAlignment="Center" FontSize="12"/>
                                <ui:NumberBox Grid.Row="3" Grid.Column="1" Value="{Binding TaxRate}" Minimum="0" Maximum="100"
                                              HorizontalAlignment="Stretch" Height="30" Margin="6,0,0,6"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Malzeme Ara Toplamı" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:N2}}" 
                                           FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,4,6"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="KDV Tutarı" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TaxAmount, StringFormat={}{0:N2}}"
                                           FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                            </Grid>

                            <Border Background="#14C61F25" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GENEL TOPLAM" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:N2} ₺}"
                                               FontWeight="Bold" FontSize="16" Foreground="#C61F25"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="TİCARİ ŞARTLAR" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Açıklama" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="54"
                                        Margin="0,2,0,8" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Garanti" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox Text="{Binding Warranty}" Margin="0,2,0,8"/>
                            <TextBlock Text="Teslim Süresi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox Text="{Binding DeliveryTime}" Margin="0,2,0,8"/>
                            <TextBlock Text="Ödeme Şartları" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox Text="{Binding PaymentTerms}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Alt Butonlar ── -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ui:Button HorizontalAlignment="Left" Content="İptal (Esc)" Command="{Binding CancelCommand}"
                       Appearance="Secondary" Height="36" Padding="20,0" Cursor="Hand"/>
            <ui:Button HorizontalAlignment="Right" Content="💾 Teklifi Kaydet (Ctrl+S)" Command="{Binding SaveCommand}"
                       Appearance="Primary" Height="36" Padding="24,0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
