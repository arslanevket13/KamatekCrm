<Window x:Class="KamatekCrm.Views.EditUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:KamatekCrm.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kullanıcı Düzenle" 
        Width="480"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource PremiumWindowStyle}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="✏️ Kullanıcı Düzenle" 
                       FontSize="22" FontWeight="Bold" 
                       Foreground="{DynamicResource StatusInfoFg}"/>
            <TextBlock Text="{Binding Username, StringFormat='Kullanıcı: {0}'}" 
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Margin="8,4"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Padding" Value="12,8"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Temel Bilgiler -->
            <TabItem Header="👤 Temel Bilgiler">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" 
                        Padding="24" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Ad -->
                        <TextBlock Text="Ad *" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PremiumTextBox}"
                                 Height="40" Margin="0,0,0,16"/>

                        <!-- Soyad -->
                        <TextBlock Text="Soyad *" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,8"/>
                        <TextBox Text="{Binding Soyad, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PremiumTextBox}"
                                 Height="40" Margin="0,0,0,16"/>

                        <!-- Rol -->
                        <TextBlock Text="Rol *" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,8"/>
                        <ComboBox ItemsSource="{Binding RoleDisplayOptions}"
                                  SelectedItem="{Binding SelectedRoleDisplay}"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="40" Margin="0,0,0,16" FontSize="16"/>

                        <!-- Telefon (Tüm roller için görünür) -->
                        <TextBlock Text="İletişim Telefonu" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,8"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PremiumTextBox}"
                                 Height="40" Margin="0,0,0,16"/>

                        <!-- Aktif -->
                        <CheckBox IsChecked="{Binding IsActive}" 
                                  Content="Kullanıcı Aktif" 
                                  FontSize="14"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 2: Yetkiler (RBAC) -->
            <TabItem Header="🛡️ Yetkiler">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" 
                        Padding="24" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Modül Erişim Yetkileri" FontSize="15" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource ThemePrimary}"/>
                        
                        <CheckBox Content="Finansal Kayıtları Gör" IsChecked="{Binding CanViewFinance}" Margin="0,0,0,16"/>
                        <CheckBox Content="Analiz ve Raporları Gör" IsChecked="{Binding CanViewAnalytics}" Margin="0,0,0,16"/>
                        <CheckBox Content="Kayıt Silme Yetkisi" IsChecked="{Binding CanDeleteRecords}" Margin="0,0,0,16"/>
                        <CheckBox Content="Satın Alma Onay Yetkisi" IsChecked="{Binding CanApprovePurchase}" Margin="0,0,0,16"/>
                        <CheckBox Content="Sistem Ayarlarına Erişim" IsChecked="{Binding CanAccessSettings}" Margin="0,0,0,16"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 3: Saha Bilgileri -->
            <TabItem Header="🔧 Saha Bilgileri" Visibility="{Binding IsTechnicianRole, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" 
                        Padding="24" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Teknisyen Detayları" FontSize="15" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource ThemeSuccess}"/>

                        <!-- Araç Plakası -->
                        <TextBlock Text="Araç Plakası" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding VehiclePlate}" Style="{DynamicResource PremiumTextBox}" Height="40" Margin="0,0,0,16"/>

                        <!-- Hizmet Bölgesi -->
                        <TextBlock Text="Hizmet Bölgesi" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,8"/>
                        <TextBox Text="{Binding ServiceArea}" Style="{DynamicResource PremiumTextBox}" Height="40" Margin="0,0,0,16"/>

                        <!-- Uzmanlık Alanları -->
                        <TextBlock Text="Uzmanlık Alanları" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,8,0,8"/>
                        <TextBox Text="{Binding ExpertiseAreas}" Style="{DynamicResource PremiumTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Message Overlay -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="16" CornerRadius="8" Padding="16,8" Panel.ZIndex="10"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
                Effect="{DynamicResource Elevation2}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource StatusErrorBg}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="İptal"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding CancelCommand}"
                       Appearance="Secondary"
                       Height="44" FontSize="14"
                       HorizontalAlignment="Stretch"
                       Cursor="Hand"/>

            <ui:Button Grid.Column="2" Content="Değişiklikleri Kaydet"
                       Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding SaveCommand}"
                       Appearance="Primary"
                       Height="44" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Stretch"
                       Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>


