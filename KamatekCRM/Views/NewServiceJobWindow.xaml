<Window x:Class="KamatekCrm.Views.NewServiceJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="İş Emri ve Keşif Formu"
        Width="1180" Height="740"
        MinWidth="960" MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="İş emri ve keşif formu"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelFormCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveServiceJobCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- High-Contrast Segmented Mode RadioButton (Light & MidnightDark safe) -->
        <Style x:Key="ModeTogglePillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{DynamicResource SurfaceSubtleBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Compact Header + Mode Segmented Switch -->
            <RowDefinition Height="*"/>    <!-- Row 1: 2-Column Dynamic Body -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Sticky Footer -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: COMPACT HEADER & HIGH-CONTRAST MODE TOGGLE ════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}"
                Padding="20,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBgBrush}" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="İş Emri ve Keşif Formu" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        <TextBlock Text="Müşteri hafızası, keşif kontrol listesi ve canlı stokla hızlı kayıt" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Segmented Mode Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton IsChecked="{Binding IsDiscoveryOnly, Mode=TwoWay}"
                                 Style="{StaticResource ModeTogglePillStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Keşif Talebi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding IsDiscoveryOnly, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                 Style="{StaticResource ModeTogglePillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Servis İş Emri" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ ROW 1: 2-COLUMN DYNAMIC WORKSPACE ════════ -->
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="460"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- ════ LEFT COLUMN: CUSTOMER, CATEGORIES, DESCRIPTION, PLANNING ════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <!-- 1. Müşteri & Yapı Türü -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="1. Müşteri ve Yapı Türü" Style="{StaticResource SectionHeader}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RbExisting" Content="Mevcut Müşteri" IsChecked="True" Margin="0,0,16,0"
                                             Foreground="{DynamicResource TextHeadingBrush}" GroupName="CstT"/>
                                <RadioButton x:Name="RbNew" Content="Hızlı Yeni Müşteri" IsChecked="{Binding IsQuickAddCustomer, Mode=TwoWay}"
                                             Foreground="{DynamicResource TextHeadingBrush}" GroupName="CstT"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbNew, Converter={StaticResource InvertedBoolToVis}}">
                                <TextBlock Text="Müşteri Arayın veya Seçin *" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer}"
                                          DisplayMemberPath="FullName"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          Height="36" Margin="0,0,0,8"/>

                                <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SummaryCustomerName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding SummaryCustomerAddress}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbNew, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ad Soyad *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Telefon *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Yapı / Bina Türü" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding StructureTypes}" SelectedItem="{Binding SelectedStructureType}" Height="32">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource StructureTypeDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding ShowBlockCount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Blok Sayısı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding BlockCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SafeIntConverter}, ConverterParameter=1, TargetNullValue=1, FallbackValue=1}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Visibility="{Binding ShowFlatCount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Daire Sayısı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding FlatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SafeIntConverter}, ConverterParameter=1, TargetNullValue=1, FallbackValue=1}" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. İş Kategorileri & Açıklama -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="2. İş Tanımı ve Kategoriler" Style="{StaticResource SectionHeader}"/>

                            <ItemsControl ItemsSource="{Binding CategoryItems}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Foreground="{DynamicResource TextHeadingBrush}"
                                                  Margin="0,2,12,4" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="İş Açıklaması / Talep Detayı *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                        Height="84" TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Planlama ve Teknisyen Atama -->
                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="3. Planlama ve Teknisyen Atama" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Öncelik Seviyesi" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Teknisyen Atama" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Technicians}"
                                              SelectedValue="{Binding SelectedTechnicianId}"
                                              SelectedValuePath="Id" DisplayMemberPath="FullName" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Planlanan Tarih" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding ScheduledDate}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SLA Son Tarih" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding SlaDeadline}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Tahmini Süre (Dk)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding EstimatedDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SafeNullableIntConverter}}" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ════ RIGHT COLUMN (DYNAMIC): DISCOVERY MODE vs SERVICE MODE ════ -->
            <Grid Grid.Column="2">

                <!-- MODE A: KEŞİF TALEBİ — Müşteri Hafızası + 90 Gün Garanti + Keşif Kontrol Listesi -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDiscoveryOnly, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Müşteri Hafızası & 90 Gün Garanti Uyarısı -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Müşteri Hafızası ve Garanti Radar" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CustomerPastJobsDisplay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 90-Day Repeat / Warranty Alert -->
                                <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                        Visibility="{Binding HasRepeatWarrantyWarning, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="18" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RepeatWarrantyWarningMessage}" TextWrapping="Wrap"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,8" Visibility="{Binding HasCustomerMemory, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Geçmiş İş Emri" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CustomerMemory.PastJobCount}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextHeadingBrush}" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="10,7" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Açık Bakiye" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CustomerOpenBalanceDisplay}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding CustomerMemory.LastJobs}"
                                              Visibility="{Binding HasCustomerMemory, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextHeadingBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CategoriesDisplay}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding CreatedDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                               FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Müşteri seçtiğinizde geçmiş işler, bakiye ve 90 gün garanti uyarısı otomatik görünür."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasCustomerMemory, Converter={StaticResource InvertedBoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Kategoriye Göre Keşif Kontrol Listesi -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="CheckboxChecked24" FontSize="16" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kategoriye Göre Keşif Kontrol Listesi" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DiscoveryChecklistItems}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Content="{Binding Title}" Foreground="{DynamicResource TextBodyBrush}" FontSize="12"/>
                                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                                           Height="24" Width="24" Padding="0"
                                                           Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" PlaceholderText="Özel kontrol maddesi ekle..."
                                                Text="{Binding NewChecklistItemText, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                    <ui:Button Grid.Column="2" Content="Ekle" Appearance="Secondary" Height="32" Padding="12,0"
                                               Command="{Binding AddChecklistItemCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- MODE B: SERVİS İŞ EMRİ — Hızlı Paketler + Malzeme Ekleme + Tek Finansal Özet -->
                <Grid Visibility="{Binding IsDiscoveryOnly, Converter={StaticResource InvertedBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hızlı Malzeme & Hazır Paketler -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Hızlı Malzeme ve Hazır Paketler" Style="{StaticResource SectionHeader}"/>

                            <ItemsControl ItemsSource="{Binding QuickMaterialKits}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding Name}" Appearance="Secondary" Height="28" Padding="10,0" FontSize="11"
                                                   Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding Description}"
                                                   Command="{Binding DataContext.ApplyMaterialKitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" ItemsSource="{Binding Products}"
                                          SelectedItem="{Binding SelectedProductToAdd}"
                                          DisplayMemberPath="ProductName"
                                          IsEditable="True" IsTextSearchEnabled="True" Height="34"/>

                                <ui:TextBox Grid.Column="2" Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Height="34"/>

                                <ui:Button Grid.Column="4" Content="Ekle" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                           Height="34" Padding="12,0" Command="{Binding AddItemToJobCommand}"/>
                            </Grid>

                            <TextBlock Text="{Binding SelectedProductStockText}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"
                                       Visibility="{Binding HasSelectedProductStockText, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedProductLowStock}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Seçilen Malzemeler Listesi (Virtualized DataGrid) -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="8">
                        <DataGrid ItemsSource="{Binding CurrentJobItems}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ürün / Malzeme" Binding="{Binding ProductName}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="Adet" Binding="{Binding QuantityUsed}" Width="56"/>
                                <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₺'}" Width="96"/>
                                <DataGridTemplateColumn Header="" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Icon="{ui:SymbolIcon Delete20}" Appearance="Transparent" Height="26" Width="26" Padding="0"
                                                       Command="{Binding DataContext.RemoveItemFromJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- TEK Temiz Finansal Özet Kartı -->
                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Finansal Özet" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="İşçilik (₺)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="İskonto (₺)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="KDV (%)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding KdvRates}" SelectedItem="{Binding KdvRate}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource AccentSubtleBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="GENEL TOPLAM (KDV DAHİL)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        <TextBlock Text="{Binding KdvAmount, StringFormat='KDV: {0:N2} ₺'}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GrandTotalWithKdv, StringFormat='{}{0:N2} ₺'}"
                                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ════════ ROW 2: STICKY FOOTER ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}"
                Padding="20,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <ui:Button HorizontalAlignment="Left" Content="İptal (Esc)" Appearance="Secondary"
                           Height="36" Padding="16,0" Command="{Binding CancelFormCommand}"/>

                <ui:Button HorizontalAlignment="Right" Content="Kaydet (Ctrl+S)" Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary" Height="36" Padding="20,0" Command="{Binding SaveServiceJobCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
