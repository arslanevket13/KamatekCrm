<Window x:Class="KamatekCrm.Views.NewServiceJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KamatekCrm.Views"
        xmlns:enums="clr-namespace:KamatekCrm.Shared.Enums;assembly=KamatekCrm.Shared"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="İş Emri &amp; Keşif Formu" 
        Width="1220" Height="800"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="İş emri ve keşif formu"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveServiceJobCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top Header & Total Summary Badge -->
            <RowDefinition Height="*"/>    <!-- Row 1: 2-Column Split Dashboard -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Footer Actions -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: TOP HEADER ════════ -->
        <Border Grid.Row="0" Background="{DynamicResource CardPanelBackgroundBrush}" 
                Padding="24,16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource ThemePrimaryLight}" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="22" Foreground="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="İş Emri ve Keşif Formu" Style="{StaticResource PageTitle}" FontSize="20"/>
                        <TextBlock Text="Müşteri talebini, altyapıyı, malzemeleri ve maliyeti tek ekranda yönetin" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Canlı Genel Toplam Rozeti (Header Right) -->
                <Border Grid.Column="2" Background="{DynamicResource ThemePrimary}" CornerRadius="10" Padding="18,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="White" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="GENEL TOPLAM" FontSize="10" FontWeight="SemiBold" Foreground="White" Opacity="0.85"/>
                            <TextBlock Text="{Binding GrandTotalWithKdv, StringFormat='{}₺{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════ ROW 1: 2-COLUMN SPLIT DASHBOARD ════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ════ SOL KOLON: MÜŞTERİ, İŞ DETAYLARI & SLA ════ -->
                <StackPanel Grid.Column="0">
                    
                    <!-- BÖLÜM 1: MÜŞTERİ & YAPI BİLGİLERİ -->
                    <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="1. Müşteri ve Yapı Türü" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="RbExisting" Content="Mevcut Müşteri" IsChecked="True" Margin="0,0,20,0" Foreground="{DynamicResource ThemeTextPrimary}" GroupName="CstT"/>
                                <RadioButton x:Name="RbNew" Content="Hızlı Yeni Müşteri" IsChecked="{Binding IsQuickAddCustomer, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}" GroupName="CstT"/>
                            </StackPanel>

                            <!-- Mevcut Müşteri Seçimi -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbNew}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Label Content="Müşteri Arayın veya Seçin *" Style="{StaticResource ModernLabel}"/>
                                <ComboBox ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer}"
                                          DisplayMemberPath="FullName"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          Style="{StaticResource ModernComboBox}"
                                          Height="40" Margin="0,0,0,12"
                                          AutomationProperties.Name="Mevcut müşteri seçimi"
                                          AutomationProperties.HelpText="Müşteri adını yazarak arayın veya listeden seçin."/>

                                <!-- Müşteri Adres Kartı -->
                                <Border Background="{DynamicResource SurfacePageBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SummaryCustomerName, FallbackValue='Müşteri Seçilmedi'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        <TextBlock Text="{Binding SummaryCustomerAddress, Converter={StaticResource SensitiveData}, ConverterParameter=Address, FallbackValue='Adres bilgisi yok'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Yeni Müşteri Hızlı Ekleme Paneli -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbNew, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="Ad Soyad *" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                 Style="{StaticResource ModernTextBox}" Height="40"
                                                 AutomationProperties.Name="Yeni müşteri adı"
                                                 AutomationProperties.HelpText="Hızlı yeni müşteri için zorunludur."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Telefon *" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                 Style="{StaticResource ModernTextBox}" Height="40"
                                                 AutomationProperties.Name="Yeni müşteri telefonu"
                                                 AutomationProperties.HelpText="En az 10 rakam içeren geçerli bir telefon numarası girin."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Yapı Türü Seçimi -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Label Content="Yapı / Bina Türü" Style="{StaticResource ModernLabel}"/>
                                    <ComboBox ItemsSource="{Binding StructureTypes}"
                                              SelectedItem="{Binding SelectedStructureType}"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="36">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding ShowBlockCount, Converter={StaticResource BoolToVis}}">
                                    <Label Content="Blok Sayısı" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding BlockCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="Blok sayısı"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Visibility="{Binding ShowFlatCount, Converter={StaticResource BoolToVis}}">
                                    <Label Content="Daire Sayısı" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding FlatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="Daire sayısı"/>
                                </StackPanel>
                            </Grid>

                            <!-- Toplam Birim Rozeti -->
                            <Border Background="{DynamicResource ThemePrimaryLight}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding ShowFlatCount, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="{DynamicResource ThemePrimary}" FontSize="12" FontWeight="SemiBold">
                                    <Run Text="Toplam İşlem Birimi:"/>
                                    <Run Text="{Binding TotalUnitCount, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="bağımsız bölüm"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BÖLÜM 2: İŞ KATEGORİLERİ & AÇIKLAMA -->
                    <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2. İş Tanımı ve Kategoriler" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2"/>

                            <TextBlock Text="İş Kategorileri" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding CategoryItems}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                                  Margin="0,2,14,6" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Label Content="İş Açıklaması / Arıza Detayı *" Style="{StaticResource ModernLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="110" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Padding="10" Margin="0,0,0,12"
                                     AutomationProperties.Name="İş açıklaması veya arıza detayı"
                                     AutomationProperties.HelpText="Keşif dışındaki iş emirleri için zorunludur."/>

                            <CheckBox Content="Sadece Keşif Yapılacak (Malzeme Girilmez)" 
                                      IsChecked="{Binding IsDiscoveryOnly}" 
                                      Foreground="{DynamicResource ThemePrimary}"
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- BÖLÜM 3: İŞ AYARLARI & TEKNİSYEN & SLA -->
                    <Border Style="{StaticResource CardPanel}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="3. Planlama ve Teknisyen Atama" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Label Content="Öncelik Seviyesi" Style="{StaticResource ModernLabel}"/>
                                    <ComboBox ItemsSource="{Binding Priorities}"
                                              SelectedItem="{Binding SelectedPriority}"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Label Content="Teknisyen Atama" Style="{StaticResource ModernLabel}"/>
                                    <ComboBox ItemsSource="{Binding Technicians}"
                                              SelectedValue="{Binding SelectedTechnicianId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="FullName"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="36"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Label Content="Planlanan Tarih" Style="{StaticResource ModernLabel}"/>
                                    <DatePicker SelectedDate="{Binding ScheduledDate}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Label Content="SLA Son Tarih" Style="{StaticResource ModernLabel}"/>
                                    <DatePicker SelectedDate="{Binding SlaDeadline}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <Label Content="Tahmini Süre (Dk)" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding EstimatedDuration, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="Tahmini süre dakika"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ════ SAĞ KOLON: MALZEME YÖNETİMİ & MALİYET HESAPLAYICI ════ -->
                <StackPanel Grid.Column="2">
                    
                    <!-- BÖLÜM 4: MALZEME VE ÜRÜN YÖNETİMİ -->
                    <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="4. Malzeme ve Ürün Ekleme" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2"/>

                            <!-- Ekleme Çubuğu -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Label Content="Ürün Seçin" Style="{StaticResource ModernLabel}"/>
                                    <ComboBox ItemsSource="{Binding Products}"
                                              SelectedItem="{Binding SelectedProductToAdd}"
                                              DisplayMemberPath="ProductName"
                                              IsEditable="True" IsTextSearchEnabled="True"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="40" AutomationProperties.Name="İş emrine eklenecek ürün"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Label Content="Miktar" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="Malzeme miktarı"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <Label Content="Birim Fiyat" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding UnitPriceToAdd, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="Malzeme birim fiyatı"/>
                                </StackPanel>

                                <ui:Button Grid.Column="6" Content="Ekle" Icon="{ui:SymbolIcon Add24}"
                                           Command="{Binding AddItemToJobCommand}"
                                           Appearance="Primary" Height="40" Padding="14,0" VerticalAlignment="Bottom"
                                           AutomationProperties.HelpText="Seçilen ürünü miktar ve fiyatıyla iş emrine ekler."/>
                            </Grid>

                            <!-- Malzeme Tablosu -->
                            <DataGrid ItemsSource="{Binding CurrentJobItems}"
                                      Style="{StaticResource AccessibleDataGrid}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                      MinHeight="180" MaxHeight="260"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ürün / Malzeme" Binding="{Binding Product.ProductName}" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Adet" Binding="{Binding QuantityUsed}" Width="70"/>
                                    <DataGridTextColumn Header="Fiyat" Binding="{Binding UnitPrice, StringFormat='{}₺{0:N2}'}" Width="100"/>
                                    <DataGridTemplateColumn Header="Sil" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Command="{Binding DataContext.RemoveItemFromJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}"
                                                           Appearance="Secondary" Height="28" Width="28" Padding="0" Foreground="{DynamicResource StatusErrorFg}" ToolTip="Malzemeyi kaldır"
                                                           AutomationProperties.Name="Malzemeyi iş emrinden kaldır"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- BÖLÜM 5: CANLI MALIYET HESAPLAYICISI (Live Calculator) -->
                    <Border Style="{StaticResource CardPanel}" Padding="20" Background="{DynamicResource SurfacePageBrush}">
                        <StackPanel>
                            <TextBlock Text="💰 5. Canlı Finansal Maliyet Özeti" Style="{StaticResource SectionHeader}"/>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Malzeme Toplamı:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MaterialTotal, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="İşçilik Ücreti (₺)" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="İşçilik ücreti"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="İskonto / İndirim (₺)" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                             Style="{StaticResource ModernTextBox}" Height="40" AutomationProperties.Name="İskonto tutarı"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Ara Toplam:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="KDV Oranı: %" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding KdvRates}" SelectedItem="{Binding KdvRate}" Style="{StaticResource ModernComboBox}" Width="65" Height="28" Padding="4,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding KdvAmount, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Separator Margin="0,0,0,14" Background="{DynamicResource ThemeBorder}"/>

                            <!-- Genel Toplam Büyük Vurgu Kartı -->
                            <Border Background="{DynamicResource ThemePrimary}" CornerRadius="10" Padding="16">
                                <DockPanel>
                                    <TextBlock Text="GENEL TOPLAM:" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotalWithKdv, StringFormat='{}₺{0:N2}'}" FontWeight="Bold" FontSize="24" HorizontalAlignment="Right" Foreground="White"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ════════ ROW 2: FOOTER (Actions) ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardPanelBackgroundBrush}" 
                Padding="24,14" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- İptal (Esc) -->
                <ui:Button HorizontalAlignment="Left" Content="İptal Et (Esc)" 
                           Command="{Binding CancelCommand}"
                           Appearance="Secondary" Height="42" Padding="24,0"/>

                <!-- Kaydet (Ctrl+S) -->
                <ui:Button HorizontalAlignment="Right" Command="{Binding SaveServiceJobCommand}"
                           Appearance="Primary" Height="42" Padding="32,0"
                           AutomationProperties.HelpText="Geçerli alanlarla iş emrini, malzemeleri ve stok rezervasyonlarını birlikte kaydeder.">
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0"
                                             Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                            <ui:SymbolIcon Symbol="Save24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSaving, Converter={StaticResource InvertedBoolToVis}}"/>
                            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="İŞ EMRİNİ KAYDET (Ctrl+S)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Text" Value="KAYDEDİLİYOR..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:Button.Content>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>
