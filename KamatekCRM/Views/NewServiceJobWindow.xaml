<Window x:Class="KamatekCrm.Views.NewServiceJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KamatekCrm.Views"
        xmlns:enums="clr-namespace:KamatekCrm.Shared.Enums;assembly=KamatekCrm.Shared"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="İş Emri &amp; Keşif Formu" 
        Width="1240" Height="820"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="İş emri ve keşif formu"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelFormCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveServiceJobCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ToggleButtonPillStyle for Work Order Type RadioButtons -->
        <Style x:Key="ToggleButtonPillStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{DynamicResource SurfacePageBrush}" 
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="6" Padding="12,6" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemePrimaryLight}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header & Work Order Type Bar -->
            <RowDefinition Height="*"/>    <!-- Row 1: Form ScrollViewer (2 Columns) -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Sticky Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: TOP HEADER & TYPE SELECTOR ════════ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="20,14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title & Grand Total -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource ThemePrimaryLight}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="İş Emri ve Keşif Formu" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="İşlem türüne göre müşteri talebini, ekibinizi ve malzemeleri yönetin" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Canlı Genel Toplam (Keşif modunda gizlenir) -->
                    <Border Grid.Column="2" Background="{DynamicResource ThemePrimary}" CornerRadius="8" Padding="14,6" VerticalAlignment="Center"
                            Visibility="{Binding IsDiscoveryOnly, Converter={StaticResource InvertedBoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="White" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="GENEL TOPLAM" FontSize="9" FontWeight="SemiBold" Foreground="White" Opacity="0.85"/>
                                <TextBlock Text="{Binding GrandTotalWithKdv, StringFormat='{}₺{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hızlı İşlem Türü Seçim Çubuğu (Keşif vs Servis vs Kurulum vs Bakım) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="İşlem Türü:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <RadioButton Content="🔍 Keşif Talebi" IsChecked="{Binding IsDiscoveryOnly, Mode=TwoWay}"
                                 Style="{StaticResource ToggleButtonPillStyle}" Height="30" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"/>

                    <RadioButton Content="🔧 Servis İş Emri" IsChecked="{Binding IsDiscoveryOnly, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                 Style="{StaticResource ToggleButtonPillStyle}" Height="30" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ ROW 1: FORM CONTENT (2-COLUMN DASHBOARD) ════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ════ SOL KOLON: MÜŞTERİ, İŞ TANIMI & PLANLAMA ════ -->
                <StackPanel Grid.Column="0">

                    <!-- BÖLÜM 1: MÜŞTERİ & YAPI BİLGİLERİ -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="1. Müşteri ve Yapı Türü" Style="{StaticResource SectionHeader}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="RbExisting" Content="Mevcut Müşteri" IsChecked="True" Margin="0,0,16,0" Foreground="{DynamicResource TextHeadingBrush}" GroupName="CstT"/>
                                <RadioButton x:Name="RbNew" Content="Hızlı Yeni Müşteri" IsChecked="{Binding IsQuickAddCustomer, Mode=TwoWay}" Foreground="{DynamicResource TextHeadingBrush}" GroupName="CstT"/>
                            </StackPanel>

                            <!-- Mevcut Müşteri Seçimi -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbNew, Converter={StaticResource InvertedBoolToVis}}">
                                <TextBlock Text="Müşteri Arayın veya Seçin *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer}"
                                          DisplayMemberPath="FullName"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          Height="36" Margin="0,0,0,8"/>

                                <!-- Müşteri Adres Özeti -->
                                <Border Background="{DynamicResource SurfacePageBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SummaryCustomerName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding SummaryCustomerAddress}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Yeni Müşteri Ekleme Paneli -->
                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbNew, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ad Soyad *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Telefon *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Yapı Türü Seçimi -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Yapı / Bina Türü" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding StructureTypes}"
                                              SelectedItem="{Binding SelectedStructureType}"
                                              Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding ShowBlockCount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Blok Sayısı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding BlockCount, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Visibility="{Binding ShowFlatCount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Daire Sayısı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding FlatCount, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BÖLÜM 2: İŞ KATEGORİLERİ & AÇIKLAMA -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="2. İş Tanımı ve Kategoriler" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="İş Kategorileri" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding CategoryItems}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Foreground="{DynamicResource TextHeadingBrush}"
                                                  Margin="0,2,12,4" FontSize="11"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="İş Açıklaması / Arıza Detayı *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                            <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                        Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                            <CheckBox Content="Sadece Keşif Yapılacak (Malzemeler Keşif Sonrası Girilecek)" 
                                      IsChecked="{Binding IsDiscoveryOnly}" 
                                      Foreground="{DynamicResource ThemePrimary}"
                                      FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- BÖLÜM 3: İŞ AYARLARI & TEKNİSYEN & SLA -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="3. Planlama ve Teknisyen Atama" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Öncelik Seviyesi" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Priorities}"
                                              SelectedItem="{Binding SelectedPriority}"
                                              Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Teknisyen Atama" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Technicians}"
                                              SelectedValue="{Binding SelectedTechnicianId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="FullName"
                                              Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Planlanan Tarih" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding ScheduledDate}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SLA Son Tarih" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding SlaDeadline}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Tahmini Süre (Dk)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding EstimatedDuration, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ════ SAĞ KOLON: MALZEME VE CANLI MALİYET ÖZETİ ════ -->
                <StackPanel Grid.Column="2">
                    
                    <!-- BÖLÜM 4: MALZEME VE ÜRÜN YÖNETİMİ (Keşif modunda gizlenir) -->
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsDiscoveryOnly, Converter={StaticResource InvertedBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="4. Malzeme ve Ürün Ekleme" Style="{StaticResource SectionHeader}"/>

                            <!-- Ekleme Çubuğu -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ürün Seçin" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Products}"
                                              SelectedItem="{Binding SelectedProductToAdd}"
                                              DisplayMemberPath="ProductName"
                                              IsEditable="True" IsTextSearchEnabled="True"
                                              Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Adet" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Fiyat" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding UnitPriceToAdd, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>

                                <ui:Button Grid.Column="6" Content="Ekle" Icon="{ui:SymbolIcon Add24}"
                                           Command="{Binding AddItemToJobCommand}"
                                           Appearance="Primary" Height="32" Padding="12,0" VerticalAlignment="Bottom"/>
                            </Grid>

                            <!-- Malzeme Tablosu -->
                            <DataGrid ItemsSource="{Binding CurrentJobItems}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      MinHeight="160" MaxHeight="240"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Adet" Binding="{Binding QuantityUsed}" Width="55"/>
                                    <DataGridTextColumn Header="Fiyat" Binding="{Binding UnitPrice, StringFormat='{}₺{0:N2}'}" Width="80"/>
                                    <DataGridTemplateColumn Header="Sil" Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Command="{Binding DataContext.RemoveItemFromJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}"
                                                           Appearance="Secondary" Height="24" Width="24" Padding="0" Foreground="{DynamicResource ThemeError}" ToolTip="Kaldır"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- BÖLÜM 5: CANLI MALIYET HESAPLAYICISI (Keşif modunda gizlenir) -->
                    <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsDiscoveryOnly, Converter={StaticResource InvertedBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="💰 5. Finansal Özet ve Maliyet" Style="{StaticResource SectionHeader}"/>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Malzeme Toplamı:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MaterialTotal, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="İşçilik Ücreti (₺)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="İndirim / İskonto (₺)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ui:TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Ara Toplam:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="KDV Oranı: %" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding KdvRates}" SelectedItem="{Binding KdvRate}" Width="65" Height="26" Padding="4,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding KdvAmount, StringFormat='{}₺{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Separator Margin="0,0,0,10" Background="{DynamicResource BorderSubtleBrush}"/>

                            <!-- Genel Toplam Büyük Vurgu Kartı -->
                            <Border Background="{DynamicResource ThemePrimary}" CornerRadius="8" Padding="14">
                                <DockPanel>
                                    <TextBlock Text="GENEL TOPLAM:" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotalWithKdv, StringFormat='{}₺{0:N2}'}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right" Foreground="White"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ════════ ROW 2: PERSISTENT STICKY FOOTER (ACTIONS) ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="20,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- İptal (Esc) -->
                <ui:Button HorizontalAlignment="Left" Content="İptal Et (Esc)" 
                           Command="{Binding CancelFormCommand}"
                           Appearance="Secondary" Height="36" Padding="20,0" Cursor="Hand"/>

                <!-- Kaydet (Ctrl+S) - Dinamik Metinli -->
                <ui:Button HorizontalAlignment="Right" Command="{Binding SaveServiceJobCommand}"
                           ToolTip="{Binding SaveDisabledReason}"
                           Appearance="Primary" Height="36" Padding="28,0" Cursor="Hand">
                    <ui:Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                             Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                            <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSaving, Converter={StaticResource InvertedBoolToVis}}"/>
                            <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="İŞ EMRİNİ KAYDET (Ctrl+S)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscoveryOnly}" Value="True">
                                                <Setter Property="Text" Value="KEŞİF TALEBİNİ KAYDET (Ctrl+S)"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                <Setter Property="Text" Value="KAYDEDİLİYOR..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:Button.Content>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>
