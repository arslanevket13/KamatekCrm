<Window x:Class="KamatekCrm.Views.DeliveryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Teslim"
        Width="860" Height="620"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════ Başlık ════════ -->
        <Border Grid.Row="0" CornerRadius="10" Padding="16,12" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ThemePrimary}"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <Border Margin="0,8,0,0" CornerRadius="4" Padding="7,2" Background="{DynamicResource HoverOverlayBrush}" HorizontalAlignment="Left"
                        Visibility="{Binding IsDelivered, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="🚚 İş Teslim Edildi" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ════════ İçerik ════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ── Teslim Bilgileri ── -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🚚 TESLİM BİLGİLERİ" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teslim Eden" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding DeliveredBy, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,10"
                                         IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Teslim Notu" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding DeliveryNote, UpdateSourceTrigger=PropertyChanged}" Height="74"
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,0"
                                         IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Müşteri İmzası (opsiyonel)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CustomerSignature, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,10"
                                         IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Teklif Genel Toplamı" Style="{StaticResource LabelStyle}"/>
                                <Border Padding="10" CornerRadius="6" Background="{DynamicResource SurfacePageBrush}" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding QuotationTotalDisplay}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemePrimary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Ödeme Bilgileri ── -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💳 ÖDEME BİLGİLERİ" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ödeme Durumu" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PaymentStatusOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding PaymentStatus}"
                                          Height="34" Margin="0,4,0,10"
                                          IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Tahsil Edilen Tutar (₺)" Style="{StaticResource LabelStyle}"/>
                                <ui:NumberBox Value="{Binding PaidAmount, Mode=TwoWay}" Minimum="0" Height="34" Margin="0,4,0,0"
                                              IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ödeme Yöntemi" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding PaymentMethod}"
                                          Height="34" Margin="0,4,0,10"
                                          IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Fatura No (opsiyonel)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,0"
                                         IsEnabled="{Binding IsDelivered, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════ Alt ════════ -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CompletionCheckSummary}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemePrimary}"/>
                <TextBlock Text="{Binding CompletionError}" FontSize="10"
                           Foreground="{DynamicResource StatusWarningFg}" TextWrapping="Wrap"/>
            </StackPanel>

            <ui:Button Grid.Column="1" Content="Vazgeç" Command="{Binding CancelCommand}"
                       Appearance="Secondary" Height="38" Padding="18,0" FontSize="12" Cursor="Hand"/>
            <ui:Button Grid.Column="3" Content="🚚 İşi Teslim Et" Command="{Binding SaveCommand}"
                       IsEnabled="{Binding IsReadyToComplete}" ToolTip="{Binding CompletionError}"
                       ToolTipService.ShowOnDisabled="True"
                       Appearance="Success" Height="38" Padding="18,0" FontSize="12" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
