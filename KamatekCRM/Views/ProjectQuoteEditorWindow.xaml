<Window x:Class="KamatekCrm.Views.ProjectQuoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:dd="urn:gong-wpf-dragdrop"
        Title="🏗️ PROJE TEKLİF EDİTÖRÜ" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PremiumWindowStyle}">

    <Window.Resources>
        <!-- TreeView Item Template -->
        <HierarchicalDataTemplate x:Key="TreeNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <TextBlock Text="{Binding HeaderDisplay}" FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        
        <!-- Product List Template -->
        <DataTemplate x:Key="ProductTemplate">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8,8" Margin="0"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SKU}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SalePrice, StringFormat='₺{0:N0}'}" 
                               FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact Sleek Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Compact Title & Code -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <ui:SymbolIcon Symbol="Building24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="PROJE TEKLİF EDİTÖRÜ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding CurrentProject.ProjectCode}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Customer Selection -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="MÜŞTERİ" FontWeight="SemiBold" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName" Height="30"/>
                </StackPanel>

                <!-- Project Title -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="PROJE ADI" FontWeight="SemiBold" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,2"/>
                </StackPanel>

                <!-- Compact Structure Generator -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Blok" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Text="{Binding BlockCount}" Width="40" Height="28" TextAlignment="Center" Padding="0,2"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Kat" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Text="{Binding FloorCount}" Width="40" Height="28" TextAlignment="Center" Padding="0,2"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Daire/Kat" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Text="{Binding FlatsPerFloor}" Width="40" Height="28" TextAlignment="Center" Padding="0,2"/>
                    </StackPanel>
                    <Button Command="{Binding GenerateStructureCommand}" Style="{StaticResource ModernButton}" Background="{DynamicResource ThemePrimary}" Foreground="{DynamicResource TextInverseBrush}" FontWeight="SemiBold" Padding="12,0" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AddSquare24" Margin="0,0,6,0"/>
                            <TextBlock Text="Yapı Oluştur" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Ana İçerik (3 Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="250"/>
            </Grid.ColumnDefinitions>
            
            <!-- SOL PANEL: Yapı Ağacı -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" 
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Başlık -->
                    <Border Grid.Row="0" Background="{DynamicResource StatusInfoBg}" Padding="16,8">
                        <TextBlock Text="📍 YAPI AĞACI" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemePrimary}"/>
                    </Border>
                    
                    <!-- TreeView -->
                    <TreeView Grid.Row="1" ItemsSource="{Binding RootNodes}"
                               ItemTemplate="{StaticResource TreeNodeTemplate}"
                               BorderThickness="0" Padding="8"
                               SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        
                        <!-- Context Menu -->
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="➕ Blok Ekle" Command="{Binding AddBlockCommand}"/>
                                <MenuItem Header="📋 Kat Ekle" Command="{Binding AddFloorCommand}"/>
                                <MenuItem Header="🏠 Daire Ekle" Command="{Binding AddFlatCommand}"/>
                                <MenuItem Header="🏭 Bölge Ekle" Command="{Binding AddZoneCommand}"/>
                                <Separator/>
                                <MenuItem Header="📑 Kopyala (Duplicate)" Command="{Binding DuplicateNodeCommand}"/>
                                <MenuItem Header="📝 Yeniden Adlandır / Etiketle" Command="{Binding RenameNodeCommand}"/>
                                <MenuItem Header="📋 Kardeşlere Uygula" Command="{Binding ApplyToSiblingsCommand}"/>
                                <Separator/>
                                <MenuItem Header="🗑️ Sil" Command="{Binding RemoveNodeCommand}" Foreground="{DynamicResource ThemeError}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                    
                    <!-- Tree Action Buttons -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="8" 
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
                        <UniformGrid Columns="3">
                            <Button Command="{Binding AddBlockCommand}"
                                    Style="{StaticResource ModernButton}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    Height="32" Margin="2,0" Padding="4,0" ToolTip="Yeni Blok Ekle">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,4,0"/>
                                    <TextBlock Text="Blok" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddFloorCommand}"
                                    Style="{StaticResource ModernButton}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    Height="32" Margin="2,0" Padding="4,0" ToolTip="Yeni Kat Ekle">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,4,0"/>
                                    <TextBlock Text="Kat" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddFlatCommand}"
                                    Style="{StaticResource ModernButton}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                    Height="32" Margin="2,0" Padding="4,0" ToolTip="Yeni Daire Ekle">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,4,0"/>
                                    <TextBlock Text="Daire" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                          Background="Transparent" Cursor="SizeWE"/>
            
            <!-- ORTA PANEL: Mahal Listesi -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" 
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.DropHandler="{Binding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Başlık -->
                    <Border Grid.Row="0" Background="{DynamicResource StatusSuccessBg}" Padding="16,8">
                        <Grid>
                            <TextBlock Text="{Binding SelectedNodeName, StringFormat='🛠️ {0} - Kalem Listesi'}" 
                                       FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeSuccess}"/>
                            <TextBlock Text="{Binding SelectedNodeSubTotal, StringFormat='₺{0:N0}'}" 
                                       HorizontalAlignment="Right" FontWeight="Bold" 
                                       FontSize="14" Foreground="{DynamicResource ThemeSuccess}"/>
                        </Grid>
                    </Border>
                    
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentNodeItems}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Adet" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Alış ₺" Binding="{Binding UnitCost, StringFormat='{}{0:N0}'}" Width="80">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Satış ₺" Binding="{Binding UnitPrice, StringFormat='{}{0:N0}'}" Width="80"/>
                            <DataGridTextColumn Header="İşçilik ₺" Binding="{Binding LaborCost, StringFormat='{}{0:N0}'}" Width="80"/>
                            <DataGridTextColumn Header="Toplam ₺" Binding="{Binding TotalPrice, StringFormat='{}{0:N0}'}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Marj" Binding="{Binding MarginDisplay}" Width="60" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Ops." Binding="{Binding IsOptional}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Alt Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource ThemeSurface}" Padding="16" 
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Button Content="🗑️ Kalemi Sil" Command="{Binding RemoveItemCommand}"
                                    Background="{DynamicResource StatusErrorBg}" Foreground="{DynamicResource StatusErrorFg}" 
                                    Padding="16,6" Height="32" BorderThickness="0" HorizontalAlignment="Left"/>
                            
                            <TextBlock Text="💡 Sağ panelden ürün sürükleyip bırakın" 
                                       FontSize="11" Foreground="{DynamicResource ThemeMuted}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" 
                          Background="Transparent" Cursor="SizeWE"/>
            
            <!-- SAĞ PANEL: Ürün Kataloğu -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" 
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Başlık -->
                    <Border Grid.Row="0" Background="{DynamicResource ThemeWarningBg}" Padding="16,8">
                        <TextBlock Text="📦 ÜRÜN &amp; HİZMET KATALOĞU" FontWeight="Bold" 
                                   FontSize="14" Foreground="{DynamicResource ThemeWarning}"/>
                    </Border>
                    
                    <!-- Arama -->
                    <Border Grid.Row="1" Padding="8,8">
                        <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" Padding="8,4"/>
                    </Border>
                    
                    <!-- Ürün Listesi -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredProducts}"
                             SelectedItem="{Binding SelectedProduct}"
                             ItemTemplate="{StaticResource ProductTemplate}"
                             BorderThickness="0" Padding="8"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.DragAdornerTemplate="{StaticResource ProductTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    
                    <!-- Ekle Butonu -->
                    <Border Grid.Row="3" Background="{DynamicResource ThemeSurface}" Padding="16" 
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
                        <Button Content="➕ SEÇİLİ NODE'A EKLE" Command="{Binding AddItemCommand}"
                                Background="{DynamicResource ThemeSuccess}" Foreground="{DynamicResource TextInverseBrush}" FontWeight="SemiBold"
                                Padding="8,8" Height="36" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer: Finansal Özet ve Butonlar (Duyarlı Wrap Panel) -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Üst Satır: Finansal Özet Kartları (WrapPanel ile Esnek Sığdırma) -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                    <!-- Maliyet -->
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MALİYET" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalCostDisplay}" FontSize="15" 
                                       FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Satış -->
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SATIŞ" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalRevenueDisplay}" FontSize="15" 
                                       FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- İskonto -->
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="İSKONTO %" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="40" Height="18" FontSize="10" TextAlignment="Center" 
                                         Padding="0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DiscountAmountDisplay}" FontSize="14" 
                                       FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- KDV -->
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KDV %" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding KdvRate, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="40" Height="18" FontSize="10" TextAlignment="Center" 
                                         Padding="0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KdvAmountDisplay}" FontSize="14" 
                                       FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Genel Toplam -->
                    <Border Background="{DynamicResource ThemePrimaryLight}" CornerRadius="8" Padding="16,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource ThemePrimary}" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="GENEL TOPLAM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryDark}"/>
                            <TextBlock Text="{Binding GrandTotalDisplay}" FontSize="18" 
                                       FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryDark}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Kar -->
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="KAR" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalProfitDisplay}" FontSize="15" 
                                       FontWeight="Bold" Foreground="{DynamicResource StatusSuccessFg}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Marj -->
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,8,8"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MARJ" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding OverallMarginDisplay}" FontSize="15" 
                                       FontWeight="Bold" Foreground="{DynamicResource StatusSuccessFg}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Alt Satır: Durum ve Butonlar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Durum Bilgisi -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding QuoteStatusDisplay, StringFormat='Durum: {0}'}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                        </Border>
                        <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding RevisionDisplay}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Butonlar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                FontWeight="SemiBold" Padding="16,0" Height="38" Margin="0,0,8,0" 
                                BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0"/>
                                <TextBlock Text="İptal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Command="{Binding ExportPdfCommand}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                FontWeight="SemiBold" Padding="16,0" Height="38" Margin="0,0,8,0" 
                                BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentPdf24" Margin="0,0,6,0"/>
                                <TextBlock Text="PDF Dışa Aktar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SendEmailCommand}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                FontWeight="SemiBold" Padding="16,0" Height="38" Margin="0,0,8,0" 
                                BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Mail24" Margin="0,0,6,0"/>
                                <TextBlock Text="E-Posta Gönder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveCommand}"
                                Background="{DynamicResource ThemePrimary}" Foreground="{DynamicResource TextInverseBrush}"
                                FontWeight="Bold" FontSize="14" Padding="24,0" Height="38"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0"/>
                                <TextBlock Text="KAYDET VE ONAYLA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

