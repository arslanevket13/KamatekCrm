<Window x:Class="KamatekCrm.Views.WorkOrderWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:KamatekCrm.Views"
        mc:Ignorable="d"
        Title="İş Emri Çalışma Alanı"
        Width="1150" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="İş emri çalışma alanı"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:FileIsImageConverter x:Key="FileIsImage"/>
        <views:CompleteMarkConverter x:Key="CompleteMarkConverter"/>
        <views:StrikeConverter x:Key="StrikeConverter"/>

        <!-- Süreç göstergesi aşama stili -->
        <Style x:Key="StageCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource SurfacePageBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Current">
                    <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Completed">
                    <Setter Property="Background" Value="{DynamicResource ThemeSuccess}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter Property="Opacity" Value="0.35"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StageTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Current">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Completed">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoRowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- İzinli işlem butonu: aktiflik ve pasiflik gerekçesi AllowedActions'tan gelir -->
        <Style x:Key="ActionButtonStyle" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Action">
                    <Setter Property="Appearance" Value="Primary"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Appearance" Value="Danger"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStretchStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <DataTemplate x:Key="ActionButtonTemplate">
            <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                       IsEnabled="{Binding IsEnabled}"
                       ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                       Style="{StaticResource ActionButtonStyle}"
                       AutomationProperties.Name="{Binding PrimaryButtonText}"/>
        </DataTemplate>

        <DataTemplate x:Key="ActionButtonStretchTemplate">
            <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                       IsEnabled="{Binding IsEnabled}"
                       ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                       Style="{StaticResource ActionButtonStretchStyle}"
                       AutomationProperties.Name="{Binding PrimaryButtonText}"/>
        </DataTemplate>

        <!-- Uyarı şeridi şip -->
        <Style x:Key="WarningChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,4,6,0"/>
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="#1AFF6B6B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Action">
                    <Setter Property="Background" Value="{DynamicResource ThemePrimaryLight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="Auto"/> <!-- Süreç göstergesi -->
            <RowDefinition Height="Auto"/> <!-- Sıradaki işlem + uyarılar -->
            <RowDefinition Height="*"/>    <!-- Sekmeler -->
            <RowDefinition Height="Auto"/> <!-- Alt -->
        </Grid.RowDefinitions>

        <!-- ════════ Başlık ════════ -->
        <Border Grid.Row="0" CornerRadius="10" Padding="16,12" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                        Background="{DynamicResource ThemePrimaryLight}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding WorkOrderTypeDisplay}" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding JobNumber}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemePrimary}"/>
                        <TextBlock Text="  •  " FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding CustomerFullName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="620" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border CornerRadius="4" Padding="7,2" Background="{DynamicResource ThemePrimaryLight}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                        </Border>
                        <Border CornerRadius="4" Padding="7,2" Background="{DynamicResource HoverOverlayBrush}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding PriorityDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        </Border>
                        <Border CornerRadius="4" Padding="7,2" Background="{DynamicResource HoverOverlayBrush}" Margin="0,0,6,0">
                            <TextBlock Text="Sorumlu: " FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding AssignedTechnician, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Planlanan" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ScheduledDateDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Right" Margin="0,1,0,4"/>
                    <TextBlock Text="SLA" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SlaStatusDisplay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusWarningFg}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ Süreç göstergesi ════════ -->
        <Border Grid.Row="1" CornerRadius="10" Padding="24,14" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <!-- Bağlantı çizgisi -->
                <Border Height="2" Background="{DynamicResource BorderSubtleBrush}"
                        Margin="24,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                <ItemsControl ItemsSource="{Binding Stages}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding NavigateCommand}" ToolTip="İlgili sekmeyi aç" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel>
                                            <Border Style="{StaticResource StageCircleStyle}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource StageTextStyle}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ════════ Sıradaki işlem + uyarılar ════════ -->
        <Border Grid.Row="2" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Background="{DynamicResource ThemePrimaryLight}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="👉 Sıradaki işlem: " FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NextActionTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0" Visibility="{Binding HasNextAction, Converter={StaticResource BoolToVis}}">
                    <ui:Button DockPanel.Dock="Right" Content="{Binding NextActionButtonText}"
                               Command="{Binding ExecuteActionCommand}" CommandParameter="{Binding NextAction.Action}"
                               IsEnabled="{Binding NextActionEnabled}"
                               ToolTip="{Binding NextActionDisabledReason}" ToolTipService.ShowOnDisabled="True"
                               Appearance="Primary" Height="38" Padding="20,0" Margin="10,0,0,0"
                               FontSize="12" Cursor="Hand"
                               AutomationProperties.Name="{Binding NextActionButtonText}"/>
                    <TextBlock Text="{Binding NextActionDescription}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Warnings}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WarningChipStyle}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap">
                                    <Run Text="{Binding Glyph, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ════════ Sekmeler ════════ -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <!-- ── Genel Bakış ── -->
            <TabItem Header="👁️ Genel Bakış">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid DataContext="{Binding OverviewTab}" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="İŞ BİLGİLERİ" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Müşteri" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.CustomerFullName}" Style="{StaticResource InfoRowTextStyle}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Telefon" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.CustomerPhone}" Style="{StaticResource InfoRowTextStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="İş Türü" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.WorkOrderTypeDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Öncelik" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.PriorityDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Sorumlu" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.AssignedTechnician}" Style="{StaticResource InfoRowTextStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Planlanan" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.ScheduledDateDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Oluşturulma" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.CreatedDateDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="SLA Durumu" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header.SlaStatusDisplay}" Style="{StaticResource InfoRowTextStyle}" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="KULLANILAN MALZEMELER" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MaterialTotalDisplay}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemePrimary}"/>
                            </DockPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Materials}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="5" Background="{DynamicResource SurfacePageBrush}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding ProductName}" FontSize="11.5" Foreground="{DynamicResource TextHeadingBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding QuantityUsed, StringFormat='{}{0} adet'}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='{}₺{0:N2}'}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource ThemePrimary}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4">
                        <Border CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="TEKLİF ÖZETİ" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding QuoteSummaryDisplay}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="HIZLI İŞLEMLER" Style="{StaticResource SectionTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                                       IsEnabled="{Binding IsEnabled}"
                                                       ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                                       Style="{StaticResource ActionButtonStretchStyle}"
                                                       AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Content="✏️ Genel Bilgileri Düzenle" Command="{Binding OpenGeneralEditorCommand}"
                                           Visibility="{Binding HasGeneralEditor, Converter={StaticResource BoolToVis}}"
                                           Appearance="Secondary" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                           FontSize="12" Cursor="Hand"/>
                                <ui:Button Content="🔄 Yenile (F5)" Command="{Binding RefreshCommand}"
                                           Appearance="Secondary" Height="38" HorizontalAlignment="Stretch"
                                           FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Keşif ── -->
            <TabItem Header="🔍 Keşif">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid DataContext="{Binding DiscoveryTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Keşif planlanmadıysa empty-state -->
                    <Border Grid.Row="0" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiscovery}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="🔍 Keşif henüz planlanmadı" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Bu iş için keşif tarihi ve teknisyen belirleyin." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="KEŞİF DETAYI" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Teknisyen" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Technician}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tahmini İşçilik" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding LaborHours}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Öngörülen Malzeme" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding MaterialSummary}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Ziyaretler" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding VisitSummary}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Fotoğraflar" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding PhotoSummary}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TEKNİK TESPİTLER" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Padding="10" CornerRadius="6" Background="{DynamicResource SurfacePageBrush}">
                                    <TextBlock Text="{Binding TechnicalNotes}" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ÖNERİLEN ÇÖZÜM" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Padding="10" CornerRadius="6" Background="{DynamicResource SurfacePageBrush}">
                                <TextBlock Text="{Binding RecommendedSolution}" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="🔎 KEŞİF ZİYARETLERİ" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VisitSummary}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Visits}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="5" Background="{DynamicResource SurfacePageBrush}">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding VisitDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextHeadingBrush}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TechnicianName}" FontSize="11"
                                                               Foreground="{DynamicResource ThemePrimary}" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📦 TAHMİNİ MALZEMELER" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Materials}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" Margin="0,0,0,3" CornerRadius="5" Background="{DynamicResource SurfacePageBrush}">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding ProductName}" FontSize="11.5" Foreground="{DynamicResource TextHeadingBrush}"/>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0} adet'}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource ThemePrimary}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Keşif fotoğrafları / belgeler -->
                    <Border Grid.Row="4" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}">
                                <Run Text="📷 KEŞİF FOTOĞRAFLARI ("/><Run Text="{Binding PhotoSummary, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Photos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="140" Height="100" Margin="0,0,8,8" CornerRadius="6"
                                                Background="{DynamicResource SurfacePageBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding}" Stretch="Uniform" Margin="4" ToolTip="{Binding}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource FileIsImage}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource FileIsImage}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Keşif işlemleri (AllowedActions'tan) -->
                    <Grid Grid.Row="5">
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                               IsEnabled="{Binding IsEnabled}"
                                               ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                               Style="{StaticResource ActionButtonStyle}"
                                               AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock Grid.Row="6" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding StatusLine, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding CompletionSummary, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Teklif ── -->
            <TabItem Header="📄 Teklif">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid DataContext="{Binding QuotationTab}" Margin="0,10,0,0">
                    <!-- Teklif yoksa empty-state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQuotation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📄" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Henüz teklif oluşturulmadı" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                        <TextBlock Text="Teklif oluşturmak için keşif raporunu tamamlayın." FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Actions}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                               IsEnabled="{Binding IsEnabled}"
                                               ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                               Style="{StaticResource ActionButtonStyle}"
                                               AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Teklif mevcut: kalemler + durum kartı -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQuotation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="TEKLİF KALEMLERİ" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDisplay}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemePrimary}"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                          MaxHeight="150" Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" MinRowHeight="30"
                                          AlternatingRowBackground="#0A000000">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Malzeme / Hizmet" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="60"/>
                                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="80"/>
                                        <DataGridTextColumn Header="İsk. %" Binding="{Binding DiscountPercent}" Width="55"/>
                                        <DataGridTextColumn Header="KDV %" Binding="{Binding TaxPercent}" Width="55"/>
                                        <DataGridTextColumn Header="Net" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="İşçilik" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LaborDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Nakliye" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ShippingDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="İskonto" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="KDV (satır bazlı)" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TaxDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Genel Toplam" Style="{StaticResource LabelStyle}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource ThemePrimary}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="TEKLİF DURUMU" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Teklif No" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NumberDisplay}" Style="{StaticResource InfoRowTextStyle}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Revizyon" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RevisionDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Durum" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" Style="{StaticResource InfoRowTextStyle}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Tarih" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IssuedDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Geçerlilik" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ValidUntilDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Gönderildi" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SentDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Kabul" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AcceptedDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Red" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RejectedDisplay}" Style="{StaticResource InfoRowTextStyle}"/>
                                    </Grid>
                                    <TextBlock Text="Red Gerekçesi: " Style="{StaticResource LabelStyle}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding RejectionReason}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                                   IsEnabled="{Binding IsEnabled}"
                                                   ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                                   Style="{StaticResource ActionButtonStretchStyle}"
                                                   AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Montaj ── -->
            <TabItem Header="🛠️ Montaj">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid DataContext="{Binding InstallationTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Montaj planlanmadıysa empty-state -->
                    <Border Grid.Row="0" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInstallation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="🛠️ Montaj henüz planlanmadı" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Montaj yalnızca kabul edilmiş teklif için planlanabilir." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MONTAJ DETAYI" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Teknisyen" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Technician}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Montaj Tarihi" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding DateDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="İşçilik Saati" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding LaborHoursDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tamamlanma" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding CompletedDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tamamlayan" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding CompletionTechnician}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Görevler" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding TaskSummary}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NOTLAR VE TESLİM" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Padding="10" CornerRadius="6" Background="{DynamicResource SurfacePageBrush}" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="Teslim Notu" Style="{StaticResource LabelStyle}"/>
                                <Border Padding="10" CornerRadius="6" Background="{DynamicResource SurfacePageBrush}" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DeliveryNote}" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="📦 MONTAJ MALZEMELERİ" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MaterialSummary}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Materials}" MaxHeight="140">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="5" Background="{DynamicResource SurfacePageBrush}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding ProductName}" FontSize="11.5" Foreground="{DynamicResource TextHeadingBrush}"/>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N2} adet'}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='{}₺{0:N2}'}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource ThemePrimary}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="✅ MONTAJ GÖREVLERİ" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TaskSummary}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tasks}" MaxHeight="120">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="5" Background="{DynamicResource SurfacePageBrush}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource TextHeadingBrush}"
                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource StrikeConverter}}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding IsCompleted, Converter={StaticResource CompleteMarkConverter}}" FontSize="11"
                                                           Foreground="{DynamicResource ThemeSuccess}" Margin="8,0,0,0"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Montaj işlemleri (AllowedActions'tan) -->
                    <Grid Grid.Row="4">
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                               IsEnabled="{Binding IsEnabled}"
                                               ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                               Style="{StaticResource ActionButtonStyle}"
                                               AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CompletionSummary}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Teslim ── -->
            <TabItem Header="🚚 Teslim">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid DataContext="{Binding DeliveryTab}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Teslim başlamadıysa empty-state -->
                    <Border Grid.Row="0" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDelivered}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="🚚 Teslim süreci henüz başlamadı" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="Bu alan montaj tamamlandıktan sonra kullanılabilir." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TESLİM DETAYI" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Teslim Tarihi" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding DateDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Teslim Eden" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding DeliveredByDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="İmza" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding SignatureDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Fatura No" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding InvoiceNumberDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ÖDEME ÖZETİ" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Durum" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding PaymentStatusDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Yöntem" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding PaymentMethodDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tahsilat" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding PaidAmountDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Kalan Bakiye" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding BalanceDisplay}" HorizontalAlignment="Right" Style="{StaticResource InfoRowTextStyle}" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TESLİM NOTU" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Padding="10" CornerRadius="6" Background="{DynamicResource SurfacePageBrush}">
                                <TextBlock Text="{Binding NoteDisplay}" FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📄 BELGELER" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Fatura; kabul edilmiş teklif kalemleri, işçilik, nakliye ve KDV üzerinden üretilir. Servis raporu; iş künyesi, keşif, montaj ve teslim özetini birleştirir."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding DocumentActions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                                   IsEnabled="{Binding IsEnabled}"
                                                   ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                                   Style="{StaticResource ActionButtonStyle}"
                                                   AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Teslim işlemi (AllowedActions'tan) -->
                    <Grid Grid.Row="4">
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{Binding PrimaryButtonText}" Command="{Binding Command}"
                                               IsEnabled="{Binding IsEnabled}"
                                               ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"
                                               Style="{StaticResource ActionButtonStyle}"
                                               AutomationProperties.Name="{Binding PrimaryButtonText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Grid.Row="5" Text="{Binding StatusLine}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Belgeler ── -->
            <TabItem Header="📁 Belgeler">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel DataContext="{Binding DocumentsTab}" Margin="0,10,0,0">
                    <Border CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📄 ÜRETİLEBİLİR BELGELER" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Her belge, iş dosyasının o andaki verisiyle üretilir. Hazır olmayan türler gerekçesiyle birlikte listelenir."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Documents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="290" Margin="0,0,10,10" CornerRadius="8" Padding="12"
                                                Background="{DynamicResource SurfacePageBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center"/>
                                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1" Background="#14C61F25"
                                                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="✓ HAZIR" FontSize="9" FontWeight="Bold" Foreground="#C61F25" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextHeadingBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MinHeight="34" Margin="0,0,0,8"/>
                                                <ui:Button Content="⬇️ Üret" Command="{Binding Command}" Appearance="Primary"
                                                           IsEnabled="{Binding IsAvailable}"
                                                           ToolTip="{Binding UnavailableReason}" ToolTipService.ShowOnDisabled="True"
                                                           Height="32" FontSize="11" HorizontalAlignment="Left" Padding="14,0" Cursor="Hand"
                                                           AutomationProperties.Name="{Binding Title, StringFormat='{}{0} üret'}"/>
                                                <TextBlock Text="{Binding UnavailableReason}" FontSize="10" Foreground="{DynamicResource StatusWarningFg}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="📷 CİHAZ FOTOĞRAFLARI VE BELGELER" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Photos.Count, StringFormat='{}{0} dosya'}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Keşif raporu ve saha ziyareti fotoğrafları. Tıklayarak varsayılan uygulamada açılır."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="🗂️ Bu iş için fotoğraf/belge eklenmemiş." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPhotos}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Photos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150" Margin="0,0,8,8" CornerRadius="6" Padding="6"
                                                Background="{DynamicResource SurfacePageBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0"
                                                        Padding="0" Cursor="Hand" HorizontalAlignment="Stretch" Height="88"
                                                        AutomationProperties.Name="{Binding FilePath}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Image Source="{Binding FilePath}" Stretch="Uniform" Margin="2" ToolTip="{Binding FilePath}">
                                                                    <Image.Style>
                                                                        <Style TargetType="Image">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FilePath, Converter={StaticResource FileIsImage}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Image.Style>
                                                                </Image>
                                                                <TextBlock Text="📄" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="{Binding FilePath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding FilePath, Converter={StaticResource FileIsImage}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.75"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{Binding Source}" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Geçmiş ── -->
            <TabItem Header="🗂️ Geçmiş">
                <Border DataContext="{Binding TimelineTab}" CornerRadius="8" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="İŞ HAREKET GEÇMİŞİ" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Grid.Row="1" Text="🗂️ Henüz hareket kaydı yok." FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" MinRowHeight="34"
                                  AlternatingRowBackground="#0A000000">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                                <DataGridTextColumn Header="İşlem" Binding="{Binding Action}" Width="160"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding TechnicianNote}" Width="*"/>
                                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding UserId}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ════════ Alt ════════ -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <ui:Button HorizontalAlignment="Right" Content="Kapat (Esc)" Command="{Binding CloseCommand}"
                       Appearance="Secondary" Height="38" Padding="22,0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
