<Window x:Class="KamatekCrm.Views.WorkOrderWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{Binding JobNumber, StringFormat='İş Emri Çalışma Alanı — {0}'}"
        Width="1360" Height="800"
        MinWidth="1120" MinHeight="680"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveShortcutCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CockpitCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CockpitSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LeftRailNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Compact 56px Top Bar -->
            <RowDefinition Height="*"/>  <!-- 3-Column Cockpit Body -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: COMPACT 56PX TOP BAR ════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Identity Summary -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding JobNumber}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text=" · " FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CustomerFullName}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <TextBlock Text=" · " FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WorkOrderTypeDisplay}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource AccentSubtleBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    </Border>

                    <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PriorityDisplay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Right Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="PDF İndir" Icon="{ui:SymbolIcon DocumentPdf24}" Appearance="Secondary"
                               Height="32" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                               Command="{Binding DownloadPrimaryPdfCommand}"/>
                    <ui:Button Content="WhatsApp" Icon="{ui:SymbolIcon Chat24}" Appearance="Secondary"
                               Height="32" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                               Command="{Binding OpenWhatsAppCommand}"/>
                    <ui:Button Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Secondary"
                               Height="32" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"
                               Command="{Binding RefreshCommand}"/>
                    <ui:Button Content="Kapat (Esc)" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Secondary"
                               Height="32" Padding="12,0" Cursor="Hand"
                               Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ ROW 1: 3-COLUMN COCKPIT BODY (210px | * | 290px) ════════ -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- ════ LEFT RAIL (210px): 6-STEP VERTICAL PROCESS STEPPER + DOCS + TIMELINE ════ -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SÜREÇ ADIMLARI" Style="{StaticResource CockpitSectionLabel}" Margin="6,2,0,8"/>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsOverviewTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="1. Talep &amp; Genel"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsDiscoveryTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="2. Keşif (Satır İçi)"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsQuotationTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="2">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="3. Teklif"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsInstallationTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="3">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="4. Montaj"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsDeliveryTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="5. Teslim &amp; Finans"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="4,10" Background="{DynamicResource BorderSubtleBrush}"/>

                        <TextBlock Text="DOSYA VE KAYITLAR" Style="{StaticResource CockpitSectionLabel}" Margin="6,0,0,8"/>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsDocumentsTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="5">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DocumentCountDisplay}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LeftRailNavButtonStyle}" Tag="{Binding IsTimelineTabActive}"
                                Command="{Binding SelectTabCommand}" CommandParameter="6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Zaman Çizelgesi"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="4,10" Background="{DynamicResource BorderSubtleBrush}"/>

                        <ui:Button Content="Genel Bilgileri Düzenle" Appearance="Secondary" HorizontalAlignment="Stretch"
                                   Height="32" FontSize="11" Command="{Binding OpenGeneralEditorCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ════ CENTER STAGE (*): DIRECT INLINE EDITABLE WORKSPACE ════ -->
            <Grid Grid.Column="2">

                <!-- TAB 0: GENEL BAKIŞ / TALEP + ALT GÖREVLER -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                              Visibility="{Binding IsOverviewTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Müşteri & Talep Özeti -->
                        <Border Style="{StaticResource CockpitCard}">
                            <StackPanel>
                                <TextBlock Text="MÜŞTERİ VE TALEP BİLGİLERİ" Style="{StaticResource CockpitSectionLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Müşteri" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding CustomerFullName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding CustomerPhone}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Sorumlu Teknisyen" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AssignedTechnician}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding ScheduledDateDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SLA / Oluşturma" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SlaStatusDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CreatedDateDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="12,10">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- İş Emri Alt Görev Kontrol Listesi (Enter ile ekle) -->
                        <Border Style="{StaticResource CockpitCard}">
                            <StackPanel>
                                <TextBlock Text="İŞ EMRİ ALT GÖREVLERİ" Style="{StaticResource CockpitSectionLabel}"/>

                                <ItemsControl ItemsSource="{Binding SubTasks}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          Content="{Binding Title}" Foreground="{DynamicResource TextBodyBrush}" FontSize="12"
                                                          Command="{Binding DataContext.ToggleSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                                           Height="24" Width="24" Padding="0"
                                                           Command="{Binding DataContext.RemoveSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" PlaceholderText="Yeni alt görev yazın ve Enter'a basın..."
                                                Text="{Binding NewSubTaskTitle, UpdateSourceTrigger=PropertyChanged}" Height="34">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddSubTaskCommand}"/>
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                    <ui:Button Grid.Column="2" Content="Ekle" Appearance="Secondary" Height="34" Padding="14,0"
                                               Command="{Binding AddSubTaskCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- İş Emri Hızlı Malzeme Özeti -->
                        <Border Style="{StaticResource CockpitCard}" Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="İŞ EMRİ MALZEMELERİ" Style="{StaticResource CockpitSectionLabel}" Margin="0"/>
                                    <TextBlock Text="{Binding OverviewTab.MaterialTotalDisplay}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding OverviewTab.Materials}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="200"
                                          BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ürün / Malzeme" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Miktar" Binding="{Binding QuantityUsed}" Width="70"/>
                                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₺'}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 1: KEŞİF — DIRECT INLINE EDITABLE COCKPIT (ZERO MODAL HELL) -->
                <Grid Visibility="{Binding IsDiscoveryTabActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Keşif Temel Bilgiler & Teknik Tespit -->
                            <Border Style="{StaticResource CockpitCard}">
                                <StackPanel>
                                    <TextBlock Text="KEŞİF RAPORU (DOĞRUDAN SATIR İÇİ DÜZENLEME)" Style="{StaticResource CockpitSectionLabel}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Keşif Teknisyeni" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox Text="{Binding InlineDiscoveryTechnician, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Ziyaret Tarihi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                            <DatePicker SelectedDate="{Binding InlineDiscoveryVisitDate}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tahmini İşçilik (Sa)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox Text="{Binding InlineDiscoveryLaborHours, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Teknik Tespitler *" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding InlineDiscoveryTechnicalNotes, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Saha tespiti, altyapı durumu, kablo metrajı..."
                                                Height="78" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                    <TextBlock Text="Önerilen Çözüm *" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding InlineDiscoveryRecommendedSolution, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Müşteriye sunulacak sistem çözümü ve kapsam..."
                                                Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Keşif Malzemeleri (+ Stoktan, + Hazır Paket, Canlı Stok Rozeti) -->
                            <Border Style="{StaticResource CockpitCard}">
                                <StackPanel>
                                    <TextBlock Text="TAHMİNİ KEŞİF MALZEMELERİ" Style="{StaticResource CockpitSectionLabel}"/>

                                    <!-- Hazır Paketler -->
                                    <ItemsControl ItemsSource="{Binding InlineQuickKits}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="{Binding Name}" Appearance="Secondary" Height="26" Padding="10,0" FontSize="11"
                                                           Margin="0,0,6,6" Cursor="Hand"
                                                           Command="{Binding DataContext.ApplyInlineDiscoveryKitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Stoktan Ürün Ekle -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding InlineProductCatalog}"
                                                  SelectedItem="{Binding SelectedInlineProduct}"
                                                  DisplayMemberPath="ProductName" IsEditable="True" IsTextSearchEnabled="True" Height="34"/>
                                        <ui:TextBox Grid.Column="2" Text="{Binding InlineMaterialQty, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                        <ui:Button Grid.Column="4" Content="+ Stoktan Ekle" Appearance="Secondary" Height="34" Padding="12,0"
                                                   Command="{Binding AddInlineMaterialCommand}"/>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding InlineDiscoveryMaterials}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200"
                                              BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Malzeme" Binding="{Binding ProductName}" Width="*" MinWidth="160"/>
                                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="64"/>
                                            <DataGridTemplateColumn Header="Stok Durumu" Width="115">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StockBadgeText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ui:Button Icon="{ui:SymbolIcon Delete20}" Appearance="Transparent" Height="26" Width="26" Padding="0"
                                                                   Command="{Binding DataContext.RemoveInlineMaterialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Keşif Ziyaretleri & Fotoğraf / Belge Ekleri (Temiz boşluklu başlıklar) -->
                            <Border Style="{StaticResource CockpitCard}" AllowDrop="True" Drop="OnPhotoAreaDrop" Margin="0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="KEŞİF ZİYARETLERİ · " Style="{StaticResource CockpitSectionLabel}" Margin="0"/>
                                            <TextBlock Text="{Binding DiscoveryTab.VisitSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <ui:Button Content="Fotoğraf / Belge Ekle" Icon="{ui:SymbolIcon ImageAdd24}" Appearance="Secondary"
                                                   Height="28" Padding="10,0" FontSize="11" HorizontalAlignment="Right"
                                                   Command="{Binding BrowseInlinePhotosCommand}"/>
                                    </Grid>

                                    <TextBlock Text="FOTOĞRAF / BELGE EKLERİ (Sürükle-bırak destekli)" Style="{StaticResource CockpitSectionLabel}" Margin="0,4,0,6"/>

                                    <ItemsControl ItemsSource="{Binding InlineDiscoveryPhotos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextBodyBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <ui:Button Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Height="22" Width="22" Padding="0"
                                                                   HorizontalAlignment="Right"
                                                                   Command="{Binding DataContext.RemoveInlinePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Sticky Bar for Inline Discovery -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,8,0,0">
                        <Grid>
                            <ui:Button HorizontalAlignment="Left" Content="Taslağı Kaydet (Ctrl+S)" Icon="{ui:SymbolIcon Save24}"
                                       Appearance="Secondary" Height="34" Padding="14,0" Command="{Binding SaveInlineDiscoveryDraftCommand}"/>

                            <ui:Button HorizontalAlignment="Right" Content="Keşfi Bitir ve Teklife Aktar" Icon="{ui:SymbolIcon ArrowRight24}"
                                       Appearance="Primary" Height="34" Padding="16,0" Command="{Binding CompleteDiscoveryAndConvertToQuoteCommand}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 2: TEKLİF -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                              Visibility="{Binding IsQuotationTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource CockpitCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="TEKLİF ÖZETİ" Style="{StaticResource CockpitSectionLabel}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding QuotationTab.NumberDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentSubtleBgBrush}" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="{Binding QuotationTab.StatusDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="İşçilik" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding QuotationTab.LaborDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="İskonto" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding QuotationTab.DiscountDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="KDV" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding QuotationTab.TaxDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Genel Toplam" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding QuotationTab.TotalDisplay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Allowed Quotation Actions -->
                                <ItemsControl ItemsSource="{Binding QuotationTab.Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding Info.PrimaryButtonText}" Appearance="Secondary"
                                                       Height="32" Padding="12,0" Margin="0,0,8,6"
                                                       IsEnabled="{Binding Info.IsEnabled}" ToolTip="{Binding Info.DisabledReason}"
                                                       Command="{Binding Command}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CockpitCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="TEKLİF KALEMLERİ" Style="{StaticResource CockpitSectionLabel}"/>
                                <DataGrid ItemsSource="{Binding QuotationTab.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="300"
                                          BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ürün / Hizmet" Binding="{Binding ProductName}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="70"/>
                                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₺'}" Width="110"/>
                                        <DataGridTextColumn Header="Satır Toplamı" Binding="{Binding LineTotal, StringFormat='{}{0:N2} ₺'}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 3: MONTAJ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                              Visibility="{Binding IsInstallationTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource CockpitCard}">
                            <StackPanel>
                                <TextBlock Text="MONTAJ PLANLAMA VE DURUM" Style="{StaticResource CockpitSectionLabel}"/>
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Teknisyen" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding InstallationTab.CompletionTechnician}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="İşçilik Saati" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding InstallationTab.LaborHoursDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tamamlanma" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding InstallationTab.CompletedDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <ItemsControl ItemsSource="{Binding InstallationTab.Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding Info.PrimaryButtonText}" Appearance="Secondary"
                                                       Height="32" Padding="12,0" Margin="0,0,8,6"
                                                       IsEnabled="{Binding Info.IsEnabled}" ToolTip="{Binding Info.DisabledReason}"
                                                       Command="{Binding Command}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CockpitCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="MONTAJ MALZEMELERİ (STOK DÜŞÜM ÖNİZLEMESİ)" Style="{StaticResource CockpitSectionLabel}"/>
                                <DataGrid ItemsSource="{Binding InstallationTab.Materials}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="260"
                                          BorderThickness="0" Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Malzeme" Binding="{Binding ProductName}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="75"/>
                                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₺'}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 4: TESLİM & FİNANS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                              Visibility="{Binding IsDeliveryTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource CockpitCard}">
                            <StackPanel>
                                <TextBlock Text="TESLİMAT VE ÖDEME KAYDI" Style="{StaticResource CockpitSectionLabel}"/>
                                <TextBlock Text="{Binding DeliveryTab.StatusLine}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Teslim Tarihi" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DeliveryTab.DateDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Ödeme Durumu" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DeliveryTab.PaymentStatusDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tahsil Edilen" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DeliveryTab.PaidAmountDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </UniformGrid>

                                <ItemsControl ItemsSource="{Binding DeliveryTab.Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding Info.PrimaryButtonText}" Appearance="Primary"
                                                       Height="34" Padding="14,0" Margin="0,0,8,6"
                                                       IsEnabled="{Binding Info.IsEnabled}" ToolTip="{Binding Info.DisabledReason}"
                                                       Command="{Binding Command}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 5: BELGELER (3-COLUMN RESPONSIVE CARD GRID, ZERO CLIPPING) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,12"
                              Visibility="{Binding IsDocumentsTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="BELGELER VE PDF ÇIKTILARI" Style="{StaticResource CockpitSectionLabel}" Margin="4,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding DocumentsTab.Documents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding UnavailableReason}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                           Visibility="{Binding IsAvailable, Converter={StaticResource InvertedBoolToVis}}"/>

                                                <ui:Button Content="PDF Üret / İndir" HorizontalAlignment="Stretch" Height="32"
                                                           IsEnabled="{Binding IsAvailable}" Command="{Binding Command}">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Setter Property="Appearance" Value="Secondary"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Appearance" Value="Primary"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 6: ZAMAN ÇİZELGESİ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                              Visibility="{Binding IsTimelineTabActive, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource CockpitCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="İŞ EMRİ ZAMAN ÇİZELGESİ" Style="{StaticResource CockpitSectionLabel}"/>
                            <ItemsControl ItemsSource="{Binding TimelineTab.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding Action}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding UserId}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- ════ RIGHT RAIL (290px): AKILLI ASİSTAN ════ -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Sıradaki Tek Adım Card -->
                    <Border Style="{StaticResource CockpitCard}" BorderBrush="{DynamicResource AccentPrimaryBrush}">
                        <StackPanel>
                            <TextBlock Text="SIRADAKİ TEK ADIM" Style="{StaticResource CockpitSectionLabel}" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="{Binding NextAction.Title, TargetNullValue='Süreç Tamamlandı'}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NextAction.Description, TargetNullValue='Bu iş emri için bekleyen aksiyon bulunmuyor.'}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <ui:Button Content="{Binding NextAction.PrimaryButtonText, TargetNullValue='İşlemi Başlat'}"
                                       Appearance="Primary" HorizontalAlignment="Stretch" Height="36"
                                       IsEnabled="{Binding NextAction.IsEnabled, FallbackValue=False}"
                                       Command="{Binding ExecuteNextActionCommand}"
                                       Visibility="{Binding NextAction, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Hazırlık Checklist (Calm Interactive Checklist) -->
                    <Border Style="{StaticResource CockpitCard}">
                        <StackPanel>
                            <TextBlock Text="HAZIRLIK KONTROL LİSTESİ" Style="{StaticResource CockpitSectionLabel}"/>
                            <ItemsControl ItemsSource="{Binding ReadinessItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding NavigateCommand}" Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Left" Padding="4,4" Cursor="Hand" Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Circle20"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                    <Setter Property="Symbol" Value="CheckmarkCircle20"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Finans & Kârlılık Kartı -->
                    <Border Style="{StaticResource CockpitCard}">
                        <StackPanel>
                            <TextBlock Text="FİNANS VE KÂRLILIK" Style="{StaticResource CockpitSectionLabel}"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Malzeme Maliyeti" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding MaterialCostDisplay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Teklif / Tutar" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding QuotedTotalDisplay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tahmini Kâr" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding EstimatedProfitDisplay}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding ProfitMarginDisplay, StringFormat=' ({0})'}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>
                            <Separator Margin="0,4,0,6" Background="{DynamicResource BorderSubtleBrush}"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Tahsil Edilen" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding CollectedDisplay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Kalan Bakiye" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock Text="{Binding RemainingDisplay}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Hızlı Hatırlatma & Not -->
                    <Border Style="{StaticResource CockpitCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="HIZLI HATIRLATMA VE NOT" Style="{StaticResource CockpitSectionLabel}"/>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <ui:Button Content="Yarın 10:00" Appearance="Secondary" Height="30" FontSize="11"
                                           HorizontalAlignment="Stretch" Margin="0,0,4,0" Command="{Binding SnoozeTomorrow10Command}"/>
                                <ui:Button Content="2 Gün Sonra" Appearance="Secondary" Height="30" FontSize="11"
                                           HorizontalAlignment="Stretch" Margin="4,0,0,0" Command="{Binding SnoozeTwoDaysCommand}"/>
                            </UniformGrid>

                            <ui:TextBox PlaceholderText="Zaman çizelgesine hızlı not ekle..."
                                        Text="{Binding QuickTimelineNote, UpdateSourceTrigger=PropertyChanged}"
                                        Height="58" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                            <ui:Button Content="Notu Kaydet" Appearance="Secondary" HorizontalAlignment="Stretch" Height="32"
                                       Command="{Binding AddQuickTimelineNoteCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
