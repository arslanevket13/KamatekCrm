<Window x:Class="KamatekCrm.Views.DiscoveryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KamatekCrm.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Keşif Raporu"
        Width="1180" Height="780"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Keşif raporu düzenleme"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:FileIsImageConverter x:Key="FileIsImage"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Başlık ── -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="640"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="➕ Stoktan Malzeme" Command="{Binding AddMaterialFromStockCommand}" Appearance="Primary"
                           Height="38" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" FontSize="12"/>
                <ui:Button Content="➕ Özel Malzeme" Command="{Binding AddCustomMaterialCommand}" Appearance="Secondary"
                           Height="38" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" FontSize="12"/>
                <ui:Button Content="➕ Ziyaret Ekle" Command="{Binding AddVisitCommand}" Appearance="Secondary"
                           Height="38" Padding="14,0" Cursor="Hand" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- ── İçerik ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: Teknik rapor + malzemeler -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📋 TEKNİK RAPOR" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teknik Tespit Notları (sahadaki durum, altyapı, güzergah)" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBox Text="{Binding TechnicalNotes, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" MinHeight="110" Margin="0,2,0,8" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Tahmini İşçilik (saat)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:NumberBox Value="{Binding EstimatedLaborHours}" Minimum="0" HorizontalAlignment="Stretch"
                                                  Height="38" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Önerilen Çözüm / Keşif Sonucu" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBox Text="{Binding RecommendedSolution, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" MinHeight="110" Margin="0,2,0,8" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Keşfi Yapan Teknisyen" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBox Text="{Binding TechnicianName}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📦 TAHMİNİ MALZEMELER (teklife kopyalanır)" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Materials}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                                      Background="Transparent" BorderThickness="0" RowHeaderWidth="0" MinRowHeight="34"
                                      AlternatingRowBackground="#0A000000" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Malzeme" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Not" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="🗑" Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" Height="26" Width="26" Padding="0" FontSize="11"
                                                           ToolTip="Malzemeyi Sil" Foreground="{DynamicResource ThemeError}" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🖼️ FOTOĞRAF / BELGE EKLERİ" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Text="{Binding PhotoSummary}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Photos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="120" Height="90" Margin="0,0,8,8" CornerRadius="6"
                                                Background="{DynamicResource SurfacePageBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding}" Stretch="Uniform" Margin="4" ToolTip="{Binding}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource FileIsImage}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="📄" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource FileIsImage}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="✕" Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Width="22" Height="22" Padding="0" FontSize="10"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                        Background="{DynamicResource ThemeError}" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Dosyayı Kaldır"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Grid.Row="1" Content="➕ Dosya Ekle" Command="{Binding AddPhotosCommand}" Appearance="Secondary"
                                       Height="34" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="0,0,0,0" Cursor="Hand" FontSize="12"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Sağ: Ziyaretler + tamamlama doğrulaması -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="🚶 ÇOKLU KEŞİF ZİYARETLERİ" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextHeadingBrush}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Visits.Count, StringFormat='{}{0} ziyaret'}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Visits}" MaxHeight="300">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8" Margin="0,0,0,6"
                                                Background="{DynamicResource SurfacePageBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <DatePicker SelectedDate="{Binding VisitDate, UpdateSourceTrigger=PropertyChanged}"
                                                                   Height="32" Margin="0,0,6,0" FontSize="11"/>
                                                    <ui:Button Grid.Column="1" Content="🗑" Command="{Binding DataContext.RemoveVisitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" Height="28" Width="28" Padding="0" FontSize="11"
                                                               Foreground="{DynamicResource ThemeError}" Cursor="Hand" ToolTip="Ziyareti Sil"/>
                                                </Grid>
                                                <ui:TextBox Grid.Row="1" Text="{Binding TechnicianName, UpdateSourceTrigger=PropertyChanged}"
                                                            Margin="0,4,0,0" Height="32" FontSize="11" PlaceholderText="Teknisyen"/>
                                                <ui:TextBox Grid.Row="2" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                            Margin="0,4,0,0" AcceptsReturn="True" MinHeight="52" FontSize="11"
                                                            PlaceholderText="Ziyaret notu"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Ziyaret yok — '➕ Ziyaret Ekle' ile ilk ziyareti kaydedin." FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasNoVisits, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Tamamlama doğrulaması ── -->
                    <Border Background="#14C61F25" BorderBrush="#33C61F25" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="✅ KEŞİF TAMAMLAMA DOĞRULAMASI" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="✔" FontSize="12"
                                           Foreground="{DynamicResource ThemeSuccess}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Keşif raporu kaydı oluşturuldu" FontSize="11.5" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="✔" FontSize="12"
                                           Foreground="{DynamicResource ThemeSuccess}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Teknik tespit notu veya önerilen çözüm girildi" FontSize="11.5" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="✔" FontSize="12"
                                           Foreground="{DynamicResource ThemeSuccess}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="En az bir malzeme veya ziyaret kaydı girildi" FontSize="11.5" TextWrapping="Wrap"/>
                            </Grid>

                            <Border CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                    Background="{DynamicResource SurfacePageBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CompletionCheckSummary}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CompletionError}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Alt ── -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ui:Button HorizontalAlignment="Left" Content="İptal (Esc)" Command="{Binding CancelCommand}"
                       Appearance="Secondary" Height="40" Padding="20,0" Cursor="Hand"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Content="💾 Kaydet (Ctrl+S)" Command="{Binding SaveCommand}"
                           Appearance="Secondary" Height="40" Padding="22,0" Margin="0,0,10,0" Cursor="Hand"/>
                <ui:Button Content="✅ Keşifi Tamamla" Command="{Binding CompleteCommand}"
                           IsEnabled="{Binding IsReadyToComplete}" ToolTip="Doğrulama tamamlanınca keşfi tamamlar"
                           ToolTipService.ShowOnDisabled="True"
                           Appearance="Success" Height="40" Padding="24,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
