<Window x:Class="KamatekCrm.Views.InstallationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Montaj Emri"
        Width="980" Height="760"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════ Başlık ════════ -->
        <Border Grid.Row="0" CornerRadius="10" Padding="16,12" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ThemePrimary}"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <Border Margin="0,8,0,0" CornerRadius="4" Padding="7,2" Background="{DynamicResource HoverOverlayBrush}" HorizontalAlignment="Left"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="✅ Montaj Tamamlandı" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ════════ İçerik ════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ── Montaj Başlığı ── -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🛠️ MONTAJ BAŞLIĞI" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teknisyen" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TechnicianName, UpdateSourceTrigger=PropertyChanged}" Height="34"
                                         IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}" Margin="0,4,0,10"/>
                                <TextBlock Text="Montaj Tarihi" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding InstallationDate}" Height="34" Margin="0,4,0,0"
                                            IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="İşçilik Saati (planlanan)" Style="{StaticResource LabelStyle}"/>
                                <ui:NumberBox Value="{Binding LaborHours, Mode=TwoWay}" Minimum="0" Height="34" Margin="0,4,0,10"
                                              IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Notlar" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Malzemeler ── -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="📦 MONTAJ MALZEMELERİ" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="➕ Stoktan Ekle" Command="{Binding AddMaterialFromStockCommand}"
                                           Appearance="Primary" Height="30" Padding="12,0" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                                <ui:Button Content="➕ Özel Ekle" Command="{Binding AddCustomMaterialCommand}"
                                           Appearance="Secondary" Height="30" Padding="12,0" Margin="0,0,6,0" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Materials}" AutoGenerateColumns="False"
                                  IsReadOnly="{Binding IsCompleted}" Background="Transparent" BorderThickness="0"
                                  RowHeaderWidth="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" MinRowHeight="32"
                                  MaxHeight="200" AlternatingRowBackground="#0A000000">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Malzeme" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="Not" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="✕" Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}" Appearance="Danger" Height="24" Width="32"
                                                       FontSize="10" Padding="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ── Görevler ── -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="✅ MONTAJ GÖREVLERİ" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                            <ui:Button DockPanel.Dock="Right" Content="➕ Görev Ekle" Command="{Binding AddTaskCommand}"
                                       Appearance="Secondary" Height="30" Padding="12,0" FontSize="11" Cursor="Hand"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Tasks}" MaxHeight="180">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="5" Background="{DynamicResource SurfacePageBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center"
                                                      IsEnabled="{Binding DataContext.IsCompleted, Converter={StaticResource InverseBoolConverter}, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" FontWeight="SemiBold"
                                                         Background="Transparent" BorderThickness="0"/>
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" FontSize="10.5"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" Background="Transparent" BorderThickness="0"/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="2" Content="✕" Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" Appearance="Danger" Height="24" Width="32"
                                                       FontSize="10" Padding="0" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Tamamlama Formu ── -->
                <Border CornerRadius="8" Padding="14" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🚚 TAMAMLAMA FORMU" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teslim Notu" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding DeliveryNote, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"
                                         IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Tamamlayan Teknisyen" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CompletionTechnician, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,0"
                                         IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fiili İşçilik Saati" Style="{StaticResource LabelStyle}"/>
                                <ui:NumberBox Value="{Binding CompletionLaborHours, Mode=TwoWay}" Minimum="0" Height="34" Margin="0,4,0,10"
                                              IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock Text="Müşteri İmzası (opsiyonel, metin)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CustomerSignature, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,0"
                                         IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════ Alt ════════ -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CompletionCheckSummary}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemePrimary}"/>
                <TextBlock Text="{Binding CompletionError}" FontSize="10"
                           Foreground="{DynamicResource StatusWarningFg}" TextWrapping="Wrap"/>
            </StackPanel>

            <ui:Button Grid.Column="1" Content="Vazgeç" Command="{Binding CancelCommand}"
                       Appearance="Secondary" Height="38" Padding="18,0" FontSize="12" Cursor="Hand"/>
            <ui:Button Grid.Column="3" Content="💾 Kaydet" Command="{Binding SaveCommand}"
                       Appearance="Secondary" Height="38" Padding="18,0" FontSize="12" Cursor="Hand"/>
            <ui:Button Grid.Column="5" Content="✅ Montajı Tamamla" Command="{Binding CompleteCommand}"
                       IsEnabled="{Binding IsReadyToComplete}" ToolTip="{Binding CompletionError}"
                       ToolTipService.ShowOnDisabled="True"
                       Appearance="Success" Height="38" Padding="18,0" FontSize="12" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
