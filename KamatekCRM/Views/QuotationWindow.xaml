<Window x:Class="KamatekCrm.Views.QuotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="LayoutRoot"
        Title="Yeni Fiyat Teklifi" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PremiumWindowStyle}"
        FontFamily="Segoe UI Variable, Inter, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Overlay for closing sidebar when clicking outside -->
        <Border Background="#1A000000" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- HOLY GRAIL LAYOUT (Pencere İçeriği) -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="*"/>    <!-- Row 1: Body -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Footer -->
            </Grid.RowDefinitions>

            <!-- ROW 0: HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Fiyat Teklifi Hazırla" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            </StackPanel>

            <!-- ROW 1: BODY -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Üst Alan: Müşteri ve Tarih Seçimi -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" 
                        BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Müşteri Seçimi" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Customers}" 
                                      SelectedItem="{Binding SelectedCustomer}" 
                                      DisplayMemberPath="FullName" 
                                      IsEditable="True" Height="36"
                                      Padding="8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Teklif Tarihi" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding QuoteDate}" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Geçerlilik Tarihi" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ValidUntil}" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Orta Alan: Ürünler Tablosu ve Ara Toplamlar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol Taraf: DataGrid -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,16,0" 
                            BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Teklif Kalemleri" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Button DockPanel.Dock="Right" Content="+ Ürün Ekle" 
                                        Command="{Binding ToggleSidebarCommand}" 
                                        HorizontalAlignment="Right"
                                        Style="{DynamicResource DefaultButtonStyle}"
                                        Padding="16,8"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding QuoteLines}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" Background="{DynamicResource SurfaceBrush}"
                                      RowHeight="48" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                      HeadersVisibility="Column" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ürün Adı/Kodu" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding CurrentStockQuantity}" Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="80"/>
                                    <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="80"/>
                                    <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat=C2}" Width="120"/>
                                    <DataGridTextColumn Header="İskonto (%)" Binding="{Binding DiscountPercent}" Width="90"/>
                                    <DataGridTextColumn Header="KDV (%)" Binding="{Binding TaxPercent}" Width="80"/>
                                    <DataGridTextColumn Header="Satır Toplamı" Binding="{Binding LineTotal, StringFormat=C2}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Background="Transparent" BorderThickness="0" 
                                                        Foreground="{DynamicResource StatusErrorFg}" FontSize="16" Cursor="Hand"
                                                        Width="36" Height="36" ToolTip="Satırı Sil"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Sağ Taraf: Şartlar ve Toplamlar -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Şartlar -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" 
                                BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Şartlar ve Koşullar" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox Grid.Row="1" Text="{Binding TermsAndConditions}" AcceptsReturn="True" TextWrapping="Wrap" 
                                         BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" Padding="8" 
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Toplamlar -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="24" 
                                BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8"><TextBlock Text="Ara Toplam:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding SubTotal, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/></Grid>
                                <Grid Margin="0,0,0,8"><TextBlock Text="Toplam İskonto:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding TotalDiscount, StringFormat=C2}" HorizontalAlignment="Right" Foreground="{DynamicResource StatusErrorFg}" FontWeight="SemiBold"/></Grid>
                                <Grid Margin="0,0,0,16"><TextBlock Text="Toplam KDV:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding TotalTax, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/></Grid>
                                <Rectangle Height="1" Fill="{DynamicResource SurfaceStrokeColorDefaultBrush}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,8"><TextBlock Text="Genel Toplam:" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><TextBlock Text="{Binding GrandTotal, StringFormat=C2}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ROW 2: FOOTER (Eylem Butonları) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Command="{Binding ExportToPdfCommand}" Height="40" Padding="16,0" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" Margin="0,0,8,0"/>
                                        <TextBlock Text="PDF İndir"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⏳" Margin="0,0,8,0"/>
                                                <TextBlock Text="İndiriliyor..."/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="İptal" Height="40" Padding="24,0" Margin="0,0,8,0" Style="{DynamicResource DefaultButtonStyle}" Click="CloseWindow_Click"/>
                <Button Content="Kaydet" Command="{Binding SaveAndSendCommand}" Height="40" Padding="24,0" Style="{DynamicResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- YAN PANEL (SIDEBAR) - ÜRÜN EKLEME -->
        <Border Background="{DynamicResource SurfaceBrush}" Width="360" HorizontalAlignment="Right" Panel.ZIndex="20"
                Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Ürün Seçimi" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Button DockPanel.Dock="Right" Content="✕" HorizontalAlignment="Right" Width="32" Height="32"
                            Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DockPanel>

                <!-- Search -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Ürün Ara" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="8,0"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Product List -->
                <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedProduct}"
                         BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" Margin="0,0,0,16" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,8">
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding SKU}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TotalStockQuantity, StringFormat='Stok: {0}'}" Foreground="{DynamicResource StatusSuccessFg}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SalePrice, StringFormat=C2}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Inputs & Add Button -->
                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Miktar" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewQuantity}" Height="40" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="İskonto (%)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewDiscount}" Height="40" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Content="Listeye Ekle" Command="{Binding AddProductCommand}" 
                            Style="{DynamicResource AccentButtonStyle}" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
