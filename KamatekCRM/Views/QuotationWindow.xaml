<Window x:Class="KamatekCrm.Views.QuotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Fiyat Teklifi" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI Variable, Inter, Segoe UI, sans-serif">

    <!-- Styles -->
    <Window.Resources>
        <!-- Soft Drop Shadow Effect -->
        <DropShadowEffect x:Key="SoftDropShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#20000000" Opacity="0.1"/>
        <!-- Deep Drop Shadow for Sidebar -->
        <DropShadowEffect x:Key="DeepDropShadow" BlurRadius="20" ShadowDepth="0" Color="#40000000" Opacity="0.2"/>
        
        <!-- Ghost Button Style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Solid Button Style -->
        <Style x:Key="PrimarySolidButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium Outline Button -->
        <Style x:Key="PremiumOutlineButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="Background" Value="#EFF6FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- ANA İÇERİK (HOLY GRAIL LAYOUT) -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- BÖLÜM 1: ÜST BÖLGE (HEADER) -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" Effect="{StaticResource SoftDropShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Müşteri Seçimi" Foreground="#6B7280" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Customers}" 
                                  SelectedItem="{Binding SelectedCustomer}" 
                                  DisplayMemberPath="FullName" 
                                  IsEditable="True" Height="36"
                                  Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Teklif Tarihi" Foreground="#6B7280" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding QuoteDate}" Height="36"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Geçerlilik Tarihi" Foreground="#6B7280" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ValidUntil}" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BÖLÜM 2: ORTA ALAN (DATAGRID) -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" Effect="{StaticResource SoftDropShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Teklif Kalemleri" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="+ Ürün Ekle" 
                                Command="{Binding ToggleSidebarCommand}" 
                                HorizontalAlignment="Right"
                                Style="{StaticResource PremiumOutlineButton}"
                                Padding="16,8"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding QuoteLines}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" BorderThickness="1" BorderBrush="#E5E7EB" Background="White"
                              RowHeight="48" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün Adı/Kodu" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding CurrentStockQuantity}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat=C2}" Width="120"/>
                            <DataGridTextColumn Header="İskonto (%)" Binding="{Binding DiscountPercent}" Width="90"/>
                            <DataGridTextColumn Header="KDV (%)" Binding="{Binding TaxPercent}" Width="80"/>
                            <DataGridTextColumn Header="Satır Toplamı" Binding="{Binding LineTotal, StringFormat=C2}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="16" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- BÖLÜM 3: ALT BÖLGE (FOOTER) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Şartlar ve Koşullar -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0" Effect="{StaticResource SoftDropShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Şartlar ve Koşullar" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#374151"/>
                        <TextBox Grid.Row="1" Text="{Binding TermsAndConditions}" AcceptsReturn="True" TextWrapping="Wrap" 
                                 BorderThickness="1" BorderBrush="#E5E7EB" Padding="8" Foreground="#4B5563" Background="#F9FAFB"/>
                    </Grid>
                </Border>

                <!-- Özet Kartı ve Aksiyon Butonları -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="24" Effect="{StaticResource SoftDropShadow}">
                    <StackPanel>
                        <!-- Toplamlar -->
                        <Grid Margin="0,0,0,8"><TextBlock Text="Ara Toplam:" Foreground="#6B7280"/><TextBlock Text="{Binding SubTotal, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,0,0,8"><TextBlock Text="Toplam İskonto:" Foreground="#6B7280"/><TextBlock Text="{Binding TotalDiscount, StringFormat=C2}" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,0,0,16"><TextBlock Text="Toplam KDV:" Foreground="#6B7280"/><TextBlock Text="{Binding TotalTax, StringFormat=C2}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        <Rectangle Height="1" Fill="#E5E7EB" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,24"><TextBlock Text="Genel Toplam:" FontWeight="Bold" FontSize="16" Foreground="#111827"/><TextBlock Text="{Binding GrandTotal, StringFormat=C2}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right" Foreground="#10B981"/></Grid>

                        <!-- Eylem Butonları -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ExportToPdfCommand}" Padding="0,12" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄" Margin="0,0,4,0"/>
                                                    <TextBlock Text="PDF İndir"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⏳" Margin="0,0,4,0"/>
                                                            <TextBlock Text="İndiriliyor..."/>
                                                        </StackPanel>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Content="Taslak Kaydet" Command="{Binding SaveDraftCommand}" 
                                    Style="{StaticResource GhostButton}" Padding="0,12" Margin="4,0,4,0"/>
                            <Button Grid.Column="2" Content="Kaydet &amp; Gönder" Command="{Binding SaveAndSendCommand}" 
                                    Style="{StaticResource PrimarySolidButton}" Padding="0,12" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- YAN PANEL (SIDEBAR) - ÜRÜN EKLEME -->
        <!-- Overlay for closing sidebar when clicking outside -->
        <Border Background="#1A000000" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSidebarCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border Background="White" Width="360" HorizontalAlignment="Right" 
                Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Effect="{StaticResource DeepDropShadow}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Ürün Seçimi" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Foreground="#111827"/>
                    <Button DockPanel.Dock="Right" Content="✕" HorizontalAlignment="Right" Width="32" Height="32"
                            Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" Foreground="#6B7280"/>
                </DockPanel>

                <!-- Search -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Ürün Ara" Foreground="#6B7280" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="8,0"
                             VerticalContentAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>

                <!-- Product List -->
                <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedProduct}"
                         BorderThickness="1" BorderBrush="#E5E7EB" Margin="0,0,0,16" Background="#F9FAFB">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,8">
                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SKU}" FontSize="11" Foreground="#6B7280"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TotalStockQuantity, StringFormat='Stok: {0}'}" Foreground="#10B981" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SalePrice, StringFormat=C2}" HorizontalAlignment="Right" FontSize="12"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Inputs & Add Button -->
                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Miktar" Foreground="#6B7280" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewQuantity}" Height="40" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="İskonto (%)" Foreground="#6B7280" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewDiscount}" Height="40" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Content="Listeye Ekle" Command="{Binding AddProductCommand}" 
                            Style="{StaticResource PrimarySolidButton}" Height="48"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
