<Window x:Class="KamatekCrm.Views.BarcodeLabelPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Barkod Etiketi Yazdır"
        Width="520" Height="470"
        MinWidth="460" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource ThemePrimary}" Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="20" Foreground="{DynamicResource TextOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Barkod Etiketi Yazdır" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                <TextBlock Text="Termal veya A4 etiket şablonuyla vektörel PDF oluşturun" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
        </StackPanel>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Ürün Özeti -->
                <Border Style="{DynamicResource CardPanel}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="SKU: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                            <TextBlock Text="{Binding Sku}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,16,0"/>
                            <TextBlock Text="Barkod: " FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                            <TextBlock Text="{Binding EffectiveBarcode}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BarcodeFormatLabel, StringFormat=({0})}" FontSize="11" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PricePreview, StringFormat=Satış Fiyatı: {0}}" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Seçenekler -->
                <Border Style="{DynamicResource CardPanel}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Şablon -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,14">
                            <Label Content="Etiket Şablonu" Style="{StaticResource ModernLabel}"/>
                            <ComboBox ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <!-- Adet -->
                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,14">
                            <Label Content="Etiket Adedi (1 - 100)" Style="{StaticResource ModernLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="-" Command="{Binding DecreaseQuantityCommand}"
                                           Width="36" Height="36" Appearance="Secondary" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" HorizontalContentAlignment="Center"/>
                                <ui:Button Grid.Column="2" Content="+" Command="{Binding IncreaseQuantityCommand}"
                                           Width="36" Height="36" Appearance="Secondary" Margin="6,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Checkboxes -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Orientation="Horizontal">
                            <CheckBox Content="Fiyat Göster" IsChecked="{Binding ShowPrice}" Margin="0,0,24,0"
                                      Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <CheckBox Content="Firma Adı Göster" IsChecked="{Binding ShowCompanyName}"
                                      Foreground="{DynamicResource ThemeTextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="İptal" Command="{Binding CancelCommand}" Height="38" Padding="20,0" Margin="0,0,8,0" Appearance="Secondary"/>
                <ui:Button Content="PDF Oluştur ve Aç" Icon="{ui:SymbolIcon Print24}" Command="{Binding PrintPdfCommand}"
                           IsDefault="True" Height="38" Padding="22,0" Appearance="Primary"/>
            </StackPanel>
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
    </Grid>
</Window>
