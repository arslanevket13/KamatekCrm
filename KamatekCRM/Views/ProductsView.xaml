<UserControl x:Class="KamatekCrm.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KamatekCrm.Views"
             xmlns:viewmodels="clr-namespace:KamatekCrm.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:KamatekCrm.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header & Action Buttons -->
            <RowDefinition Height="Auto"/> <!-- Row 1: KPI Metrics Panel -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Filter Toolbar -->
            <RowDefinition Height="*"/>    <!-- Row 3: Product DataGrid -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: HEADER & MAIN ACTIONS ════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ürünler ve Stok" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Ürün envanterinizi izleyin, stok seviyelerini ve fiyatları yönetin" 
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <ui:Button Content="Excel'den Yükle" 
                           Icon="{ui:SymbolIcon DocumentTable24}"
                           Command="{Binding ImportExcelCommand}"
                           Appearance="Secondary"
                           Height="40" Padding="16,0" Margin="0,0,8,0"/>

                <ui:Button Content="Stok Transferi" 
                           Icon="{ui:SymbolIcon ArrowSwap24}"
                           Command="{Binding TransferStockCommand}"
                           Appearance="Secondary"
                           Height="40" Padding="16,0" Margin="0,0,8,0"/>

                <ui:Button Content="Yeni Ürün Ekle" 
                           Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding AddNewProductCommand}"
                           Appearance="Primary"
                           Height="40" Padding="20,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ════════ ROW 1: KPI SUMMARY CARDS PANEL ════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Products -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource StatusInfoBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="{DynamicResource StatusInfoFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam Çeşit" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding TotalProductCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 2: Total Stock Items -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource ThemePrimaryMuted}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="GroupList24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam Stok Adedi" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding TotalStockQuantityCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 3: Low Stock Warnings -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource StatusErrorBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource StatusErrorFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Kritik Stok Uyarısı (≤5)" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusErrorFg}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 4: Total Inventory Value -->
            <Border Grid.Column="6" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource StatusSuccessBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="{DynamicResource StatusSuccessFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam Envanter Değeri" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding TotalInventoryValueDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessFg}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ════════ ROW 2: FILTER TOOLBAR ════════ -->
        <Border Grid.Row="2" Style="{StaticResource FilterToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <ui:TextBox Grid.Column="0"
                            PlaceholderText="Ürün Adı, SKU, Marka veya Barkod Arayın..." 
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Search24}" 
                            Height="40" VerticalAlignment="Center"
                            AutomationProperties.Name="Ürün ara"
                            AutomationProperties.HelpText="Ürün adı, stok kodu, marka veya barkoda göre arar"/>

                <!-- Category Filter -->
                <StackPanel Grid.Column="2">
                    <ComboBox ItemsSource="{Binding CategoryFilterItems}"
                              SelectedItem="{Binding SelectedCategoryFilter}"
                              Style="{StaticResource AccessibleComboBox}"
                              AutomationProperties.Name="Kategori filtresi"/>
                </StackPanel>

                <!-- Stock Status Filter -->
                <StackPanel Grid.Column="4">
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding StockStatusFilter}"
                              Style="{StaticResource AccessibleComboBox}"
                              AutomationProperties.Name="Stok durumu filtresi">
                        <ComboBoxItem Content="Tümü"/>
                        <ComboBoxItem Content="Stokta Var"/>
                        <ComboBoxItem Content="Kritik Stok"/>
                        <ComboBoxItem Content="Tükenenler"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ ROW 3: PRODUCT DATAGRID ════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding ProductsView}"
                          SelectedItem="{Binding SelectedProduct}"
                          Style="{StaticResource AccessibleDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          GridLinesVisibility="Horizontal">
                    
                    <!-- Double-Click ile Düzenleme -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" 
                                      Command="{Binding EditProductCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding DeleteProductCommand}"/>
                    </DataGrid.InputBindings>
                    
                    <DataGrid.Columns>
                        <!-- Thumbnail -->
                        <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="40" Height="40" CornerRadius="8"
                                            Background="{DynamicResource SurfacePageBrush}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" HorizontalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Box24" FontSize="20" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Stretch="UniformToFill" Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- SKU -->
                        <DataGridTextColumn Header="SKU / Kod" 
                                            Binding="{Binding SKU}" 
                                            Width="140"/>

                        <!-- Ürün Adı & Marka -->
                        <DataGridTemplateColumn Header="Ürün Adı &amp; Marka" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        <TextBlock Text="{Binding Brand.BrandName}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Kategori -->
                        <DataGridTextColumn Header="Kategori" 
                                            Binding="{Binding Category.Name}" 
                                            Width="140"/>

                        <!-- Stok Miktarı Badge -->
                        <DataGridTemplateColumn Header="Stok Miktarı" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#264CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TotalStockQuantity}" Value="0">
                                                        <Setter Property="Background" Value="#26F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TotalStockQuantity}" Value="1">
                                                        <Setter Property="Background" Value="#26FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TotalStockQuantity}" Value="2">
                                                        <Setter Property="Background" Value="#26FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TotalStockQuantity}" Value="3">
                                                        <Setter Property="Background" Value="#26FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TotalStockQuantity}" Value="4">
                                                        <Setter Property="Background" Value="#26FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TotalStockQuantity}" Value="5">
                                                        <Setter Property="Background" Value="#26FF9800"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalStockQuantity}" FontWeight="Bold"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Unit}" FontSize="11" Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Alış Fiyatı -->
                        <DataGridTextColumn Header="Alış Fiyatı" 
                                            Binding="{Binding PurchasePrice, StringFormat='{}₺{0:N2}'}" 
                                            Width="110"/>

                        <!-- Satış Fiyatı -->
                        <DataGridTextColumn Header="Satış Fiyatı" 
                                            Binding="{Binding SalePrice, StringFormat='{}₺{0:N2}'}" 
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- İşlemler Kolonu -->
                        <DataGridTemplateColumn Header="İşlemler" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Düzenle -->
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                                   Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Secondary" Height="28" Width="28" Padding="0" ToolTip="Düzenle"/>
                                        
                                        <!-- Hızlı Stok Düzeltme -->
                                        <ui:Button Icon="{ui:SymbolIcon AddSquare24}"
                                                   Command="{Binding DataContext.QuickAdjustStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Secondary" Height="28" Width="28" Padding="0" ToolTip="Stok Düzelt"/>

                                        <!-- Sil -->
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                   Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Secondary" Height="28" Width="28" Padding="0" Foreground="{DynamicResource StatusErrorFg}" ToolTip="Sil"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status Message -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,12,0,0" FontWeight="Medium">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActionSuccessful}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
