<UserControl x:Class="KamatekCrm.Views.NetworkSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBooleanConverter x:Key="InverseBool"/>
        <vm:ConnectionStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Globe24" FontSize="26" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AĞ VE BAĞLANTI YÖNETİMİ" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        <TextBlock Text="Sunucu rolü, otomatik UDP ağ keşfi ve canlı veritabanı istemci izleme paneli" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live Status Badge -->
                <Border Grid.Column="1" CornerRadius="20" Padding="16,8" VerticalAlignment="Center"
                        Background="{Binding IsConnectionHealthy, Converter={StaticResource StatusColorConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectionHealthy}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════ MAIN CONTENT: 2-COLUMN LAYOUT ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CONFIGURATION CARDS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- CARD 1: ROL YAPILANDIRMASI -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                            Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource ThemePrimary}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Rol Yapılandırması" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock Text="Bu bilgisayarın ağdaki görevini belirleyin" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Role Badge -->
                                <Border Grid.Column="2" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMainServer}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RoleDisplayText}" FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMainServer}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <Separator Margin="0,0,0,16" Background="{DynamicResource BorderSubtleBrush}"/>

                            <!-- Main Server Toggle -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ana Sunucu Modu (Main Server)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                                               Text="Ana sunucu veritabanını barındırır ve UDP yayını yapar. İstemciler otomatik bağlanır."/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMainServer}" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- Unsaved Warning -->
                            <Border CornerRadius="8" Padding="12,8" Background="{DynamicResource StatusWarningBg}" 
                                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{DynamicResource StatusWarningFg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Değişikliklerin etkili olması için 'Kaydet ve Yeniden Başlat' butonuna basın." 
                                               FontSize="11" Foreground="{DynamicResource StatusWarningFg}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: BAĞLANTI MODU & UDP KEŞFİ -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                            Padding="20" Margin="0,0,0,16"
                            Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource ThemePrimary}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Wifi124" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Bağlantı ve Keşif Modu" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock Text="Sunucuya bağlanma yöntemini yapılandırın" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,0,0,16" Background="{DynamicResource BorderSubtleBrush}"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Otomatik UDP Keşfi (Zero-Config)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock Text="Sunucuyu yerel ağda otomatik bul ve bağlan" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoDiscoveryEnabled}" VerticalAlignment="Top"/>
                            </Grid>

                            <ui:Button Content="Ağ'ı Tara" Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding ScanNetworkCommand}" Margin="0,4,0,12"
                                       Visibility="{Binding IsAutoDiscoveryEnabled, Converter={StaticResource BoolToVis}}"
                                       Appearance="Primary" Height="36" Padding="16,0" Cursor="Hand" HorizontalAlignment="Left"/>

                            <!-- Manual IP Input -->
                            <Border CornerRadius="8" Padding="14" Margin="0,4,0,0"
                                    Background="{DynamicResource SurfacePageBrush}"
                                    Visibility="{Binding IsAutoDiscoveryEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <StackPanel>
                                    <TextBlock Text="MANUEL SUNUCU IP ADRESİ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding ManualServerIp, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn: 192.168.1.100" Height="38"/>
                                        <ui:Button Grid.Column="1" Content="Test Et" Icon="{ui:SymbolIcon PlugConnected24}"
                                                   Command="{Binding TestConnectionCommand}" Margin="8,0,0,0"
                                                   Appearance="Primary" Height="38" Padding="14,0" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: PORT VE TIMEOUT KONFİGÜRASYONU -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="UDP Yayın Portu" FontWeight="SemiBold" FontSize="12"/>
                                <ui:TextBox Text="{Binding ConfiguredPort, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Label Content="Zaman Aşımı (sn)" FontWeight="SemiBold" FontSize="12"/>
                                <ui:TextBox Text="{Binding ConfiguredTimeout, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: LIVE SERVER DASHBOARD (CONNECTED CLIENTS) -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource StatusSuccessBg}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="People24" FontSize="18" Foreground="{DynamicResource StatusSuccessFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Canlı Bağlı İstemci Paneli" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="PostgreSQL pg_stat_activity izleme • "/>
                                <Run Text="{Binding ConnectedClients.Count, Mode=OneWay, StringFormat='{}{0} aktif istemci'}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Yenile" Command="{Binding RefreshClientsCommand}" Appearance="Secondary" Height="34" Padding="12,0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Connected Clients DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ConnectedClients}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent" AlternatingRowBackground="{DynamicResource HoverOverlayBrush}"
                              Foreground="{DynamicResource TextHeadingBrush}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfacePageBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Status Indicator -->
                            <DataGridTemplateColumn Header="" Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="İstemci IP Adresi" Binding="{Binding ClientAddress}" Width="160"/>
                            <DataGridTextColumn Header="Bağlantı Durumu" Binding="{Binding State}" Width="*"/>
                            <DataGridTextColumn Header="Son Sorgu" Binding="{Binding QueryStartDisplay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ BOTTOM ACTION BAR ═══════════════ -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <ui:Button DockPanel.Dock="Right" Content="Kapat" Width="100" Height="36" Click="CloseButton_Click" Appearance="Secondary" Cursor="Hand"/>

            <ui:Button Content="Kaydet ve Yeniden Başlat" Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding SaveAndRestartCommand}"
                       Appearance="Primary" Height="38" Padding="20,0" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</UserControl>
