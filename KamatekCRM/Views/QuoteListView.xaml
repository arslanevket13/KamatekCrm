<UserControl x:Class="KamatekCrm.Views.QuoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:KamatekCrm.Converters"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <converters:QuoteStatusTextConverter x:Key="StatusTextConverter"/>
        <converters:QuoteStatusColorConverter x:Key="StatusColorConverter"/>
        <converters:DateDisplayConverter x:Key="DateConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: KPI Cards -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Filter Toolbar -->
            <RowDefinition Height="*"/>     <!-- Row 3: DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Row 4: Footer -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ ROW 0: HEADER ═══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="26"
                               Foreground="{DynamicResource ThemePrimary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Proje ve Teklifler" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Tüm proje tekliflerini görüntüleyin, yönetin ve takip edin"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Content="Yeni Teklif"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding NewQuoteCommand}"
                       Appearance="Primary"
                       Height="40" Padding="20,0" Cursor="Hand" VerticalAlignment="Center"/>
        </Grid>

        <!-- ═══════════════ ROW 1: KPI CARDS ═══════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toplam -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterAllCommand}"/>
                </Border.InputBindings>
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource StatusInfoBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="20"
                                       Foreground="{DynamicResource StatusInfoFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam Teklif" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding TotalQuoteCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Taslak -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterDraftCommand}"/>
                </Border.InputBindings>
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource ThemePrimaryMuted}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="20"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Taslak" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding DraftCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Gönderildi -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterSentCommand}"/>
                </Border.InputBindings>
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource StatusInfoBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Send24" FontSize="20"
                                       Foreground="{DynamicResource ThemePrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Gönderildi" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding SentCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemePrimary}"/>
                        <TextBlock Text="{Binding TotalPendingAmountDisplay}" FontSize="10"
                                   Foreground="{DynamicResource ThemePrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Onaylandı -->
            <Border Grid.Column="6" Style="{StaticResource CardPanel}" Padding="16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterApprovedCommand}"/>
                </Border.InputBindings>
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource StatusSuccessBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20"
                                       Foreground="{DynamicResource StatusSuccessFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Onaylandı" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding ApprovedCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource StatusSuccessFg}"/>
                        <TextBlock Text="{Binding TotalApprovedAmountDisplay}" FontSize="10"
                                   Foreground="{DynamicResource StatusSuccessFg}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Reddedildi -->
            <Border Grid.Column="8" Style="{StaticResource CardPanel}" Padding="16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterRejectedCommand}"/>
                </Border.InputBindings>
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource StatusErrorBg}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DismissCircle24" FontSize="20"
                                       Foreground="{DynamicResource StatusErrorFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Reddedildi" FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding RejectedCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource StatusErrorFg}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════════ ROW 2: FILTER TOOLBAR ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FilterToolbarCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Arama -->
                <ui:TextBox Grid.Column="0"
                            PlaceholderText="Proje adı, müşteri adı veya proje kodu ara..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            Height="40" VerticalAlignment="Center"/>

                <!-- Filtre Gösterimi -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filtre:" FontSize="12"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{DynamicResource ThemePrimaryMuted}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding StatusFilterDisplay}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemePrimary}"/>
                    </Border>
                </StackPanel>

                <!-- Yenile -->
                <ui:Button Grid.Column="4"
                           Content="Yenile"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshCommand}"
                           Appearance="Secondary"
                           Height="36" Padding="12,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════ ROW 3: DATA GRID ═══════════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="0" Margin="0,16,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding QuotesView}"
                          SelectedItem="{Binding SelectedQuote}"
                          Style="{StaticResource AccessibleDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Düzenle" Command="{Binding EditQuoteCommand}"
                                      Icon="{ui:SymbolIcon Edit24}"/>
                            <MenuItem Header="Kopyala" Command="{Binding DuplicateQuoteCommand}"
                                      Icon="{ui:SymbolIcon Copy24}"/>
                            <MenuItem Header="PDF Dışa Aktar" Command="{Binding ExportPdfCommand}"
                                      Icon="{ui:SymbolIcon Document24}"/>
                            <Separator/>
                            <MenuItem Header="Gönderildi Olarak İşaretle" Command="{Binding MarkAsSentCommand}"
                                      Icon="{ui:SymbolIcon Send24}"/>
                            <MenuItem Header="Onaylandı Olarak İşaretle" Command="{Binding MarkAsApprovedCommand}"
                                      Icon="{ui:SymbolIcon CheckmarkCircle24}"/>
                            <MenuItem Header="Reddedildi Olarak İşaretle" Command="{Binding MarkAsRejectedCommand}"
                                      Icon="{ui:SymbolIcon DismissCircle24}"/>
                            <MenuItem Header="Kurulum İş Emri Oluştur" Command="{Binding ConvertToWorkOrderCommand}"
                                      Icon="{ui:SymbolIcon Wrench24}"/>
                            <Separator/>
                            <MenuItem Header="Sil" Command="{Binding DeleteQuoteCommand}"
                                      Icon="{ui:SymbolIcon Delete24}"
                                      Foreground="{DynamicResource ThemeError}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditQuoteCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding DeleteQuoteCommand}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <!-- Proje Kodu -->
                        <DataGridTextColumn Header="Proje Kodu" Binding="{Binding ProjectCode}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Teklif No -->
                        <DataGridTextColumn Header="Teklif No" Binding="{Binding QuoteNumber}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Proje Adı -->
                        <DataGridTextColumn Header="Proje Adı" Binding="{Binding Title}" Width="*"/>

                        <!-- Müşteri -->
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="160"/>

                        <!-- Tutar -->
                        <DataGridTextColumn Header="Tutar" Binding="{Binding TotalBudget, StringFormat='₺{0:N2}'}" Width="125">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Kar -->
                        <DataGridTextColumn Header="Kar" Binding="{Binding TotalProfit, StringFormat='₺{0:N2}'}" Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Durum Badge -->
                        <DataGridTemplateColumn Header="Durum" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding QuoteStatus, Converter={StaticResource StatusColorConverter}}"
                                            CornerRadius="10" Padding="10,4" HorizontalAlignment="Center"
                                            Margin="4,4">
                                        <TextBlock Text="{Binding QuoteStatus, Converter={StaticResource StatusTextConverter}}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Revizyon -->
                        <DataGridTextColumn Header="Rev." Binding="{Binding RevisionNumber, StringFormat='R{0}'}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- İskonto -->
                        <DataGridTextColumn Header="İskonto" Binding="{Binding DiscountPercent, StringFormat='%{0:N0}'}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tarih -->
                        <DataGridTextColumn Header="Oluşturma" Binding="{Binding CreatedDate, Converter={StaticResource DateConverter}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Durum Mesajı -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- ═══════════════ ROW 4: FOOTER ACTIONS ═══════════════ -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="12,8" Margin="0,16,0,0">
            <DockPanel>
                <!-- Sağ taraftaki butonlar -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Düzenle"
                               Icon="{ui:SymbolIcon Edit24}"
                               Command="{Binding EditQuoteCommand}"
                               Appearance="Secondary"
                               Height="36" Padding="14,0" Margin="0,0,8,0"/>

                    <ui:Button Content="PDF"
                               Icon="{ui:SymbolIcon Document24}"
                               Command="{Binding ExportPdfCommand}"
                               Appearance="Secondary"
                               Height="36" Padding="14,0" Margin="0,0,8,0"/>

                    <ui:Button Content="Kopyala"
                               Icon="{ui:SymbolIcon Copy24}"
                               Command="{Binding DuplicateQuoteCommand}"
                               Appearance="Secondary"
                               Height="36" Padding="14,0" Margin="0,0,8,0"/>

                    <ui:Button Content="İş Emri"
                               Icon="{ui:SymbolIcon Wrench24}"
                               Command="{Binding ConvertToWorkOrderCommand}"
                               Appearance="Secondary"
                               Height="36" Padding="14,0" Margin="0,0,8,0"/>

                    <ui:Button Content="Sil"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding DeleteQuoteCommand}"
                               Appearance="Danger"
                               Height="36" Padding="14,0"/>
                </StackPanel>

                <!-- Sol taraftaki filtre bilgisi -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
