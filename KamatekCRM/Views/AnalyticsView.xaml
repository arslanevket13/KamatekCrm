<UserControl x:Class="KamatekCrm.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:km="clr-namespace:KamatekCrm.Components"
             Background="{DynamicResource SurfacePageBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Toolbar -->
                <RowDefinition Height="Auto"/> <!-- KPI Cards -->
                <RowDefinition Height="*"/>    <!-- Charts Grid -->
            </Grid.RowDefinitions>

            <!-- ═══════════════ ROW 0: HEADER & FILTERS ═══════════════ -->
            <DockPanel Grid.Row="0" Margin="0,0,0,32">
                <!-- Right: Action Buttons & Filter -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Date Range Filter -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="8" Padding="4" Margin="0,0,16,0"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Bu Hafta" Appearance="Secondary" Height="32" Padding="12,0" Margin="0,0,4,0"/>
                            <ui:Button Content="Bu Ay" Appearance="Primary" Height="32" Padding="12,0" Margin="0,0,4,0"/>
                            <ui:Button Content="Bu Yıl" Appearance="Secondary" Height="32" Padding="12,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Export Button -->
                    <ui:Button Content="Rapor İndir (PDF)" 
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Appearance="Secondary"
                               Height="40" Padding="16,0"/>
                </StackPanel>

                <!-- Left: Title & Subtitle -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="28" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analitik &amp; Raporlar" 
                                   FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextHeadingBrush}"/>
                    </StackPanel>
                    <TextBlock Text="İşletme performansı, teknisyen verimliliği ve gelir trend analizi" 
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="40,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- ═══════════════ ROW 1: ENHANCED KPI CARDS ═══════════════ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,32">
                <!-- KPI 1: Toplam İşler -->
                <km:KmKpiCard Title="Toplam İş Hacmi"
                              Value="{Binding TotalJobs}"
                              Icon="📊"
                              Subtitle="kayıtlı iş emri"
                              AccentBrush="{DynamicResource KpiGradientPurple}"
                              Margin="0,0,24,0"/>

                <!-- KPI 2: Tamamlanan -->
                <km:KmKpiCard Title="Tamamlanan İşler"
                              Value="{Binding CompletedJobs}"
                              Icon="✅"
                              Subtitle="başarıyla teslim edildi"
                              AccentBrush="{DynamicResource KpiGradientGreen}"
                              Margin="0,0,24,0"/>

                <!-- KPI 3: Başarı Oranı -->
                <km:KmKpiCard Title="Servis Başarı Oranı"
                              Value="{Binding SuccessRate}"
                              Suffix="%" Format="N1"
                              Icon="🎯"
                              Subtitle="müşteri memnuniyet hedefi"
                              AccentBrush="{DynamicResource KpiGradientCyan}"
                              Margin="0,0,0,0"/>
            </UniformGrid>

            <!-- ═══════════════ ROW 2: CHARTS GRID ═══════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>   <!-- Pie Chart -->
                    <ColumnDefinition Width="1.8*"/> <!-- Bar & Line Charts -->
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══ 1. PIE CHART: ARIZA TÜRÜ DAĞILIMI ═══ -->
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" CornerRadius="12" Margin="0,0,24,0" Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Effect="{DynamicResource Elevation2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,10,0"/>
                                <TextBlock Text="Arıza Türü Dağılımı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Kategorilere göre iş oranı" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="30,4,0,0"/>
                        </StackPanel>

                        <lvc:PieChart Grid.Row="1" 
                                     Series="{Binding JobDistributionSeries}" 
                                     LegendPosition="Bottom"
                                     Height="320"/>
                    </Grid>
                </Border>

                <!-- ═══ 2. COLUMN CHART: TEKNİSYEN PERFORMANSI ═══ -->
                <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Margin="0,0,0,24" Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Effect="{DynamicResource Elevation2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="20" Foreground="{DynamicResource ThemeSuccess}" Margin="0,0,10,0"/>
                                <TextBlock Text="En İyi Teknisyenler (Top 5)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Tamamlanan iş sayısına göre personel sıralaması" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="30,4,0,0"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1" 
                                            Series="{Binding TechPerformanceSeries}" 
                                            XAxes="{Binding TechXAxes}"
                                            Height="220"
                                            TooltipPosition="Top"/>
                    </Grid>
                </Border>

                <!-- ═══ 3. LINE CHART: AYLIK TREND ═══ -->
                <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Margin="0,0,0,0" Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Effect="{DynamicResource Elevation2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="20" Foreground="{DynamicResource ThemeWarning}" Margin="0,0,10,0"/>
                                <TextBlock Text="Son 6 Ay İş Trendi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Aylık tamamlanan servis talepleri değişimi" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="30,4,0,0"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1" 
                                            Series="{Binding TrendSeries}" 
                                            XAxes="{Binding TrendXAxes}"
                                            Height="220"
                                            TooltipPosition="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
