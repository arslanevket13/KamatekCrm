<UserControl x:Class="KamatekCrm.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KamatekCrm.Views"
             xmlns:vm="clr-namespace:KamatekCrm.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:KamatekCrm.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Tab Button Style -->
        <Style x:Key="SettingsTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="26" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SİSTEM VE YAPILANDIRMA AYARLARI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                        <TextBlock Text="Firma bilgileri, görünüm, veritabanı yedekleme ve ağ yönetimi" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Yalnızca yetkili geliştirici hesaplarına görünür; yetki servis katmanında da denetlenir. -->
                <ui:Button Grid.Column="1"
                           Content="Geliştirici Tanılama Merkezi"
                           Appearance="Secondary"
                           VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon Wrench24}"
                           Command="{Binding OpenDevCenterCommand}"
                           Visibility="{Binding IsDevCenterAvailable, Converter={StaticResource BoolToVis}}"
                           ToolTip="Geliştirici Tanılama Merkezi: Canlı loglar, hata merkezi, performans ve sağlık kontrolleri"
                           Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Content (Left Tabs, Right Content) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TAB NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Margin="0,0,20,0" Padding="8" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Building24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Firma &amp; PDF Kimliği" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Color24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Görünüm &amp; Tema" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Database24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yedekleme &amp; Veri" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yazıcı &amp; Bildirimler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ağ &amp; Sunucu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Uygulama Güncellemeleri" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- RIGHT TAB CONTENT PANELS -->
            <Border Grid.Column="1" Padding="24" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- TAB 0: FIRMA BILGILERI -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="🏢 Firma Kimliği &amp; Kurumsal PDF Tasarım Stüdyosu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Fiyat Teklifi, Servis/İş Emri Formu, Ekstre ve Fiş çıktılarında firmanızın kurumsal kimliğini, logosunu, renklerini, banka hesaplarını ve şartnamelerini özelleştirin." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

                            <!-- İKİ SÜTUNLU ANA DÜZEN (Sol: Logo, Kaşe ve Renkler | Sağ: Resmi Bilgiler & Bankalar) -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- SOL SÜTUN: GÖRSEL VE RENK KİMLİĞİ KARTI -->
                                <Border Grid.Column="0" Margin="0,0,16,0" Padding="16" CornerRadius="10"
                                        Background="{DynamicResource SurfacePageBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🎨 Görsel &amp; Renk Kimliği" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,12"/>

                                        <!-- LOGO ÖNİZLEME VE İŞLEMLERİ -->
                                        <Label Content="Firma Logosu (PDF Başlığı İçin)" FontWeight="SemiBold" FontSize="12"/>
                                        <Border Height="95" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,4,0,8" Padding="6">
                                            <Grid>
                                                <Image Source="{Binding LogoPreviewSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="Özel Logo Yok&#x0a;(Orijinal Kamatek Logosu Aktif)"
                                                           FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogoPreviewSource}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <ui:Button Content="Logo Seç" Icon="{ui:SymbolIcon Image24}" Command="{Binding UploadLogoCommand}" Height="34" Margin="0,0,6,0" Cursor="Hand"/>
                                            <ui:Button Content="Kamatek'e Sıfırla" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ResetToDefaultBrandCommand}" Appearance="Secondary" Height="34" Cursor="Hand" ToolTip="Özel logoyu kaldırıp orijinal Kamatek logosuna döner"/>
                                        </StackPanel>

                                        <!-- KAŞE & İMZA ÖNİZLEME -->
                                        <Label Content="Yetkili Kaşe &amp; İmza (PDF Onay Bloğu)" FontWeight="SemiBold" FontSize="12"/>
                                        <Border Height="75" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,4,0,8" Padding="6">
                                            <Grid>
                                                <Image Source="{Binding StampPreviewSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="Kaşe / İmza Yüklenmedi"
                                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StampPreviewSource}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <ui:Button Content="Kaşe Seç" Icon="{ui:SymbolIcon Image24}" Command="{Binding UploadStampCommand}" Height="34" Margin="0,0,6,0" Cursor="Hand"/>
                                            <ui:Button Content="Kaldır" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveStampCommand}" Appearance="Danger" Height="34" Cursor="Hand"
                                                       IsEnabled="{Binding HasCustomStamp}"/>
                                        </StackPanel>

                                        <!-- RENKLER -->
                                        <TextBlock Text="PDF Kurumsal Renkleri (HEX)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <Label Content="Ana Renk" FontSize="11"/>
                                                <ui:TextBox Text="{Binding PrimaryBrandColorHex, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <Label Content="Vurgu Rengi" FontSize="11"/>
                                                <ui:TextBox Text="{Binding AccentBrandColorHex, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>

                                        <Label Content="Hazır Renk Paletleri:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <WrapPanel Margin="0,2,0,0">
                                            <ui:Button Content="Kamatek" Command="{Binding ApplyBrandPaletteCommand}" CommandParameter="Kamatek" Margin="0,0,4,4" Height="26" FontSize="11" Cursor="Hand"/>
                                            <ui:Button Content="Kurumsal Mavi" Command="{Binding ApplyBrandPaletteCommand}" CommandParameter="CorporateBlue" Margin="0,0,4,4" Height="26" FontSize="11" Cursor="Hand"/>
                                            <ui:Button Content="Modern Antrasit" Command="{Binding ApplyBrandPaletteCommand}" CommandParameter="ModernAnthracite" Margin="0,0,4,4" Height="26" FontSize="11" Cursor="Hand"/>
                                            <ui:Button Content="Güvenlik Yeşili" Command="{Binding ApplyBrandPaletteCommand}" CommandParameter="SecurityGreen" Margin="0,0,4,4" Height="26" FontSize="11" Cursor="Hand"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- SAĞ SÜTUN: RESMİ ŞİRKET BİLGİLERİ VE BANKA HESAPLARI -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="🏛️ Resmi Firma ve İletişim Bilgileri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="Firma Unvanı (Marka Adı)" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="Alt Başlık (Sektör/Açıklama)" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding CompanySubtitle, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="Şube / Bölge / Slogan" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding CompanySloganOrBranch, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="Web Sitesi" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Vergi Dairesi" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding TaxOffice, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                            <Label Content="Vergi / TC No" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                            <Label Content="Ticaret Sicil No" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding TradeRegistryNo, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                            <Label Content="MERSİS No" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding MersisNo, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="Telefon Numarası" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="E-Posta Adresi" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,14">
                                        <Label Content="Resmi Tebligat &amp; Firma Adresi" FontWeight="SemiBold"/>
                                        <ui:TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="💳 Banka &amp; IBAN Hesapları" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="Banka Adı" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="Hesap Sahibi" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding AccountHolder, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,10">
                                        <Label Content="IBAN (Türk Lirası - TRY)" FontWeight="SemiBold"/>
                                        <ui:TextBox Text="{Binding IbanTry, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="IBAN (USD - Opsiyonel)" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding IbanUsd, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="IBAN (EUR - Opsiyonel)" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding IbanEur, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- ALT BÖLÜM: PDF BELGE TERCİHLERİ VE ŞARTNAME METİNLERİ -->
                            <Border Padding="16" CornerRadius="10" Background="{DynamicResource SurfacePageBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="📄 PDF Belge Tercihleri ve Hukuki Şartnameler" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,12"/>

                                    <WrapPanel Margin="0,0,0,12">
                                        <CheckBox Content="Birim Fiyatları Göster (İşaretsizse Paket Teklif Modu)" IsChecked="{Binding ShowUnitPricesInPdf}" VerticalAlignment="Center" Margin="0,0,20,8"/>
                                        <CheckBox Content="Ürün Görsellerini Dahil Et" IsChecked="{Binding ShowProductImagesInPdf}" VerticalAlignment="Center" Margin="0,0,20,8"/>
                                        <CheckBox Content="Yetkili Kaşe &amp; İmzayı Bas" IsChecked="{Binding ShowStampInPdf}" VerticalAlignment="Center" Margin="0,0,20,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                            <Label Content="Teklif Geçerlilik (Gün):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ui:TextBox Text="{Binding QuoteValidityDays, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Label Content="Filigran Metni:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ui:TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="32"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="Fiyat Teklifi Şartnamesi (Madde Madde)" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding QuoteTermsText, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="Servis &amp; İş Emri Şartnamesi" FontWeight="SemiBold"/>
                                            <ui:TextBox Text="{Binding ServiceFormTermsText, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,4">
                                        <Label Content="Garanti Belgesi Şartnamesi" FontWeight="SemiBold"/>
                                        <ui:TextBox Text="{Binding WarrantyTermsText, UpdateSourceTrigger=PropertyChanged}" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- AKSİYON BUTONLARI -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button Content="Firma &amp; PDF Ayarlarını Kaydet" Icon="{ui:SymbolIcon Save24}"
                                           Command="{Binding SaveCompanyInfoCommand}"
                                           Appearance="Primary" Height="42" Padding="24,0" Cursor="Hand" Margin="0,0,12,0"/>

                                <ui:Button Content="Örnek Teklif PDF'ini Canlı Önizle" Icon="{ui:SymbolIcon DocumentPdf24}"
                                           Command="{Binding PreviewSamplePdfCommand}"
                                           Appearance="Secondary" Height="42" Padding="20,0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- TAB 1: GORUNUM & TEMA -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="🎨 Görünüm &amp; Tema Ayarları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Kullanıcı arayüzü temalarını ve görsel renk modlarını özelleştirin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

                            <ListBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" 
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,12,12"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="200" Height="110" CornerRadius="10" Padding="14"
                                                BorderThickness="2" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                Background="{DynamicResource SurfacePageBrush}" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- TAB 2: YEDEKLEME & VERITABANI -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="💾 Veritabanı &amp; Yedekleme Yönetimi" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="SHA-256 manifestiyle doğrulanan yedek oluşturun; geri yüklemeden önce otomatik kurtarma noktası alınır." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

                            <!-- Backup Folder Setting -->
                            <Border Padding="16" CornerRadius="10" Margin="0,0,0,16" Background="{DynamicResource SurfacePageBrush}">
                                <StackPanel>
                                    <TextBlock Text="Yedekleme Klasör Konumu" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding CustomBackupPath}" PlaceholderText="Varsayılan: Belgeler/KamatekCRM/Backups" IsReadOnly="True" Height="36"/>
                                        <ui:Button Grid.Column="1" Content="Klasör Seç" Command="{Binding SelectBackupFolderCommand}" Margin="8,0,0,0" Height="36" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="16" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource SurfacePageBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Son Doğrulanmış Yedek" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding LastBackupText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Şimdi Yedek Al" Icon="{ui:SymbolIcon Save24}"
                                                   Command="{Binding TakeBackupCommand}"
                                                   Appearance="Primary" Height="38" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"/>

                                        <ui:Button Content="Yedeği Geri Yükle" Icon="{ui:SymbolIcon FolderOpen24}"
                                                   Command="{Binding RestoreBackupCommand}"
                                                   Appearance="Secondary" Height="38" Padding="16,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="16" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource SurfacePageBrush}">
                                <StackPanel>
                                    <TextBlock Text="Eski Cari Satış Uzlaştırması" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    <TextBlock Text="Eski veresiye satışlarda tahsilat gibi kaydedilmiş hareketleri bulur. Önizleme yazmaz; uygulama eski kaydı değiştirmeden benzersiz telafi hareketi ekler." TextWrapping="Wrap" Margin="0,5,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding LegacyLedgerSummary}" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding LegacyLedgerIssues}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" Style="{StaticResource ModernDataGrid}" Margin="0,0,0,10">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Fiş" Binding="{Binding OrderNumber}" Width="130"/>
                                            <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerName}" Width="*"/>
                                            <DataGridTextColumn Header="Bakiye Farkı" Binding="{Binding OnAccountAmount, StringFormat=C}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="Salt Okunur Önizleme" Command="{Binding PreviewLegacyLedgerCommand}" Appearance="Secondary" Margin="0,0,8,0"/>
                                        <ui:Button Content="Düzeltmeleri Uygula" Command="{Binding ApplyLegacyLedgerCorrectionsCommand}" Appearance="Primary"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: YAZICI & BILDIRIMLER -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="🖨️ Yazıcı &amp; Bildirim Ayarları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Varsayılan fatura yazıcısı ve sesli sistem bildirim yapılandırmaları" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

                            <StackPanel Margin="0,0,0,20">
                                <Label Content="Varsayılan Fatura / Teklif Yazıcısı" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}" Height="38"/>
                            </StackPanel>

                            <CheckBox Content="Fiyat teklifleri kaydedildiğinde otomatik yazdır" IsChecked="{Binding AutoPrintReceipt}" Margin="0,0,0,12" FontSize="13"/>
                            <CheckBox Content="Kritik stok ve yeni arıza kaydı bildirimi seslerini aktif et" IsChecked="{Binding SoundAlertsEnabled}" Margin="0,0,0,24" FontSize="13"/>

                            <ui:Button Content="Ayarları Kaydet" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCompanyInfoCommand}" Appearance="Primary" Height="38" Padding="16,0" HorizontalAlignment="Left" Cursor="Hand"/>
                        </StackPanel>

                        <!-- TAB 4: AG & SUNUCU -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="🌐 Ağ &amp; Sunucu Yönetimi" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Sunucu-istemci mimarisi ve yerel ağ bağlantı ayarları" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

                            <Border Padding="16" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource SurfacePageBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MEVCUT SUNUCU ROLÜ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="💻 İstemci (Client Modu)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMainServer}" Value="True">
                                                            <Setter Property="Text" Value="🖥️ Ana Sunucu (Main Server)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" Content="Detaylı Ağ Yönetimini Aç" Icon="{ui:SymbolIcon Globe24}"
                                               Command="{Binding OpenNetworkSettingsCommand}" Appearance="Primary" Height="38" Padding="16,0" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- TAB 5: UYGULAMA GUNCELLEMELERI -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="🚀 Otomatik Uygulama Güncellemeleri" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Velopack altyapısı ile GitHub Releases üzerinden güvenli ve otomatik masaüstü güncellemeleri" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

                            <!-- Sürüm & Durum Özeti Kartı -->
                            <Border Padding="16" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource SurfacePageBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MEVCUT MASAÜSTÜ SÜRÜMÜ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentAppVersionText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SON KONTROL ZAMAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding LastCheckTimeText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Güncellemeleri Kontrol Et" Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   Command="{Binding CheckForUpdatesNowCommand}"
                                                   Appearance="Primary" Height="38" Padding="16,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Hazır İndirilmiş Güncelleme Uyarısı (Varsa) -->
                            <Border Padding="16" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource StatusSuccessBg}"
                                    Visibility="{Binding IsUpdateDownloaded, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource StatusSuccessFg}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <ui:Button Content="Şimdi Yeniden Başlat ve Yükle" Command="{Binding ApplyUpdateNowCommand}"
                                               Appearance="Success" Height="36" Padding="16,0" DockPanel.Dock="Right" Cursor="Hand"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="YENİ GÜNCELLEME İNDİRİLDİ VE YÜKLEMEYE HAZIR" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessFg}"/>
                                        <TextBlock Text="Uygulama yeniden başlatıldığında yeni sürüm otomatik aktifleşecektir." FontSize="12" Foreground="{DynamicResource TextHeadingBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Yapılandırma Seçenekleri -->
                            <Border Padding="18" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource SurfacePageBrush}">
                                <StackPanel>
                                    <TextBlock Text="GÜNCELLEME DAVRANIŞI &amp; KANAL SEÇİMİ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,14"/>

                                    <CheckBox Content="Uygulama açılışında güncellemeleri otomatik kontrol et" IsChecked="{Binding CheckForUpdatesOnStartup}" Margin="0,0,0,12" FontSize="13"/>
                                    <CheckBox Content="Yeni sürüm bulunduğunda arka planda otomatik indir" IsChecked="{Binding AutoDownloadUpdates}" Margin="0,0,0,12" FontSize="13"/>
                                    <CheckBox Content="Program kapatılırken indirilen güncellemeyi yükle" IsChecked="{Binding InstallOnClose}" Margin="0,0,0,16" FontSize="13"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="Güncelleme Kanalı" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding AvailableUpdateChannels}" SelectedItem="{Binding UpdateChannel}" Height="36"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,16,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="Stable: Kararlı genel yayın sürümleri. Beta: Test ve ön izleme (prerelease) sürümleri. Kanal değişimi yetkili yönetici izni gerektirir."/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Geliştirici & Tanılama Merkezi Kartı -->
                            <Border Padding="18" CornerRadius="10" Margin="0,0,0,20" Background="{DynamicResource SurfacePageBrush}"
                                    Visibility="{Binding IsDevCenterAvailable, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="GELİŞTİRİCİ TANILAMA MERKEZİ" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Sistem performansı, bellek tüketimi, canlı log akışı, hata ve çökme raporları, XAML/Binding analizleri ve API/DB sağlık durumu izleme merkezi."
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ui:Button Content="Geliştirici Tanılama Merkezini Aç"
                                                   Icon="{ui:SymbolIcon Open24}"
                                                   Command="{Binding OpenDevCenterCommand}"
                                                   Appearance="Secondary" Height="38" Padding="16,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
