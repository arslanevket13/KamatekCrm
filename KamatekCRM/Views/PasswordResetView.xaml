<Window x:Class="KamatekCrm.Views.PasswordResetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Şifre Değiştir" 
        Width="460"
        MinWidth="420" MinHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource PremiumWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding HeaderTitle}" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource TextHeadingBrush}"/>
            <TextBlock Text="{Binding AdSoyad}" 
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBodyBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Username, StringFormat='@{0}'}" 
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" 
                    Padding="20" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Yeni Şifre -->
                    <TextBlock Text="Yeni Şifre *" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,6"/>
                    <ui:PasswordBox x:Name="NewPasswordBox"
                                    Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="LockClosed24"
                                    PlaceholderText="Yeni güçlü şifrenizi girin"
                                    Height="40" FontSize="14"/>

                    <!-- Şifre Tekrar -->
                    <TextBlock Text="Şifre Tekrar *" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" Margin="0,14,0,6"/>
                    <ui:PasswordBox x:Name="ConfirmPasswordBox"
                                    Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="LockClosed24"
                                    PlaceholderText="Yeni şifrenizi tekrar girin"
                                    Height="40" FontSize="14"/>

                    <!-- Şifre eşleşme mesajı -->
                    <TextBlock Text="{Binding PasswordMatchMessage}" 
                               FontSize="12" FontWeight="Medium" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PasswordsMatch}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Canlı Şifre Kural Listesi -->
                    <Border Background="{DynamicResource SurfacePageBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Şifre Gereksinimleri" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○ En az 10 karakter"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMinLength}" Value="True">
                                                <Setter Property="Text" Value="✓ En az 10 karakter"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○ En az bir büyük harf (A-Z)"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpperCase}" Value="True">
                                                <Setter Property="Text" Value="✓ En az bir büyük harf (A-Z)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○ En az bir küçük harf (a-z)"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLowerCase}" Value="True">
                                                <Setter Property="Text" Value="✓ En az bir küçük harf (a-z)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○ En az bir rakam (0-9)"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDigit}" Value="True">
                                                <Setter Property="Text" Value="✓ En az bir rakam (0-9)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="12" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○ En az bir özel karakter (!@#$%...)"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSpecialChar}" Value="True">
                                                <Setter Property="Text" Value="✓ En az bir özel karakter (!@#$%...)"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○ Şifre tekrarı ile eşleşiyor"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConfirmAndMatches}" Value="True">
                                                <Setter Property="Text" Value="✓ Şifre tekrarı ile eşleşiyor"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Bağlamsal Bilgi Notu -->
                    <Border Background="{DynamicResource StatusInfoBg}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <TextBlock Text="{Binding InfoNoteText}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource StatusInfoFg}"/>
                    </Border>

                    <!-- Status Message -->
                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,10"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource StatusErrorBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="İptal" 
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Height="42" FontSize="14"
                    Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" Content="Şifreyi Kaydet" 
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Height="42" FontSize="14" FontWeight="SemiBold"
                    Foreground="{DynamicResource TextOnPrimaryBrush}"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemePrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>


