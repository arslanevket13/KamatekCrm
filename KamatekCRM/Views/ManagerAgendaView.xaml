<UserControl x:Class="KamatekCrm.Views.ManagerAgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:KamatekCrm.Components"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PersonStar24" FontSize="26" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yönetici Gündemi &amp; Patron Takibi" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="Yönetici ilgisi gerektiren talepler, kritik şikâyetler ve patron görüşmeleri" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="2" Content="Yenile" Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding LoadAgendaCommand}" Appearance="Secondary" Height="38" Padding="16,0" Cursor="Hand"/>
        </Grid>

        <!-- ROW 1: ALERT BANNER -->
        <Border Grid.Row="1" Background="{DynamicResource StatusWarningBg}" CornerRadius="10" Padding="14" Margin="0,0,0,16"
                BorderBrush="{DynamicResource StatusWarningFg}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource StatusWarningFg}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Bu ekran yalnızca yüksek öncelikli, şikâyet bildiren veya özel patron görüşmesi talep eden müşterileri listeler."
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ROW 2: DATAGRID & DETAIL PANEL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="12" Padding="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding AgendaItems}"
                          SelectedItem="{Binding SelectedAgendaItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="54"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          AlternatingRowBackground="{DynamicResource HoverOverlayBrush}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfacePageBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding InteractionNumber}" Width="120"/>
                        <DataGridTextColumn Header="Arayan / Müşteri" Binding="{Binding CallerName}" Width="160"/>
                        <DataGridTextColumn Header="Konu" Binding="{Binding Subject}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="Öncelik" Binding="{Binding Priority}" Width="90"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding InteractionDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <components:KmEmptyState Icon="&#xE7EF;" Title="Gündem Maddesi Seçilmedi"
                                             Message="Yönetici notlarını ve aksiyonları görmek için listeden bir kayıt seçin."
                                             Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedAgendaItem}">
                            <TextBlock Text="{Binding InteractionNumber}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeWarning}"/>
                            <TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding CallerName, StringFormat='Arayan: {0}'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="GÖRÜŞME ÖZETİ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <TextBlock Text="YÖNETİCİYE ÖZEL NOT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusWarningFg}"/>
                            <TextBlock Text="{Binding ManagerNotes, TargetNullValue='Özel not eklenmemiş'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                            <StackPanel>
                                <ui:Button Content="İncelendi Olarak İşaretle" Icon="{ui:SymbolIcon Eye24}"
                                           Command="{Binding DataContext.MarkAsSeenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Appearance="Secondary" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand"/>

                                <ui:Button Content="Sonuçlandır ve Kapat" Icon="{ui:SymbolIcon Checkmark24}"
                                           Command="{Binding DataContext.ResolveAgendaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Appearance="Success" Height="36" HorizontalAlignment="Stretch" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
