<Window x:Class="KamatekCrm.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KamatekCrm.Views"
        xmlns:viewmodels="clr-namespace:KamatekCrm.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:KamatekCrm.Converters"
        xmlns:specs="clr-namespace:KamatekCrm.Shared.Models.Specs;assembly=KamatekCrm.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:AddProductViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}" 
        Height="720" Width="920"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource PremiumWindowStyle}"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>

        <!-- Camera Specs Template -->
        <DataTemplate DataType="{x:Type specs:CameraSpecs}">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                    <Label Content="Çözünürlük" Style="{StaticResource ModernLabel}"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Resolution}" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="2MP"/>
                        <ComboBoxItem Content="4MP"/>
                        <ComboBoxItem Content="5MP"/>
                        <ComboBoxItem Content="8MP (4K)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                    <Label Content="Lens Tipi" Style="{StaticResource ModernLabel}"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding LensType}" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Fixed"/>
                        <ComboBoxItem Content="Varifocal"/>
                        <ComboBoxItem Content="Motorized"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,0,12">
                    <Label Content="Kamera Tipi" Style="{StaticResource ModernLabel}"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding CameraType}" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Dome"/>
                        <ComboBoxItem Content="Bullet"/>
                        <ComboBoxItem Content="PTZ"/>
                        <ComboBoxItem Content="Turret"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <Label Content="IR Mesafesi (m)" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding IRDistance}" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <Label Content="IP Koruma" Style="{StaticResource ModernLabel}"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding IpRating}" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="IP65"/>
                        <ComboBoxItem Content="IP66"/>
                        <ComboBoxItem Content="IP67"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,12">
                    <Label Content="Sıkıştırma" Style="{StaticResource ModernLabel}"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Compression}" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="H.264"/>
                        <ComboBoxItem Content="H.265"/>
                        <ComboBoxItem Content="H.265+"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="PoE Destekli" IsChecked="{Binding IsPoE}" Margin="0,0,24,0"/>
                    <CheckBox Content="Sesli" IsChecked="{Binding HasAudio}" Margin="0,0,24,0"/>
                    <CheckBox Content="ColorVu (Renkli Gece)" IsChecked="{Binding HasColorVu}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- General Specs Template -->
        <DataTemplate DataType="{x:Type specs:GeneralSpecs}">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Malzeme" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding Material}" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Renk" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding Color}" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <Label Content="Garanti" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding Warranty}" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
            <RowDefinition Height="*"/>    <!-- Row 1: Tabbed Form Body -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Footer -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: HEADER ════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ThemePrimary}" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBlock Text="Stok kartı bilgilerini ve dinamik teknik parametreleri yönetin" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ════════ ROW 1: TABBED FORM BODY ════════ -->
        <TabControl Grid.Row="1" Style="{DynamicResource ModernTabControl}" Background="Transparent" BorderThickness="0">
            
            <!-- 📌 TAB 1: TEMEL BİLGİLER -->
            <TabItem Header="📋 Temel Bilgiler">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- SKU -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,16">
                                    <Label Content="SKU / Stok Kodu *" Style="{StaticResource ModernLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewProduct.SKU, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RegenerateSKUCommand}" 
                                                   Height="38" Width="38" Margin="8,0,0,0" ToolTip="Yeni SKU Üret" Appearance="Secondary"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Barkod -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,16">
                                    <Label Content="Barkod (EAN/UPC)" Style="{StaticResource ModernLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewProduct.Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon BarcodeScanner24}" Command="{Binding GenerateBarcodeCommand}" 
                                                   Height="38" Width="38" Margin="8,0,0,0" ToolTip="Otomatik Barkod Oluştur" Appearance="Secondary"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Ürün Adı -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                    <Label Content="Ürün Adı *" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding NewProduct.ProductName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Kategori -->
                                <StackPanel Grid.Column="0" Grid.Row="2">
                                    <Label Content="Kategori *" Style="{StaticResource ModernLabel}"/>
                                    <ComboBox ItemsSource="{Binding Categories}" 
                                              SelectedItem="{Binding SelectedCategory}"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <!-- Marka & Model -->
                                <Grid Grid.Column="2" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="Marka" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding NewProduct.BrandName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Model" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding NewProduct.ModelName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 💰 TAB 2: FİYATLANDIRMA & STOK -->
            <TabItem Header="💰 Fiyatlandırma &amp; Stok">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Fiyatlandırma Kartı -->
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="Fiyatlandırma &amp; Marj Analizi" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <!-- Dynamic Profit Badge -->
                                    <Border DockPanel.Dock="Right" Background="{Binding ProfitColor}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ProfitMarginDisplay}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Alış Fiyatı -->
                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,16">
                                        <Label Content="Alış Fiyatı (Maliyet)" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding NewProduct.PurchasePrice, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Satış Fiyatı -->
                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,16">
                                        <Label Content="Satış Fiyatı *" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding NewProduct.SalePrice, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Para Birimi & KDV -->
                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,16">
                                        <Label Content="Para Birimi" Style="{StaticResource ModernLabel}"/>
                                        <ComboBox ItemsSource="{Binding Currencies}" 
                                                  SelectedItem="{Binding NewProduct.Currency}"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,16">
                                        <Label Content="KDV Oranı (%)" Style="{StaticResource ModernLabel}"/>
                                        <ComboBox ItemsSource="{Binding VatRates}" 
                                                  SelectedItem="{Binding NewProduct.VatRate}"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <!-- Birim -->
                                    <StackPanel Grid.Column="0" Grid.Row="2">
                                        <Label Content="Birim" Style="{StaticResource ModernLabel}"/>
                                        <ComboBox ItemsSource="{Binding Units}" 
                                                  Text="{Binding NewProduct.Unit, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="2">
                                        <Label Content="Tedarikçi Adı" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding NewProduct.SupplierName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stok Kartı -->
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Stok Durumu" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Açılış Stoğu (Sadece Add modunda) -->
                                    <StackPanel Grid.Column="0" Visibility="{Binding IsInitialStockVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Label Content="Açılış Stoğu (İlk Miktar)" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding InitialStock, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 ToolTip="Yeni ürün için başlangıç deposundaki stok miktarı"/>
                                    </StackPanel>

                                    <!-- Mevcut Stok (Sadece Edit modunda) -->
                                    <StackPanel Grid.Column="0" Visibility="{Binding IsStockAdjustmentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Label Content="Mevcut Depo Stoğu" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding CurrentTotalStock, Mode=OneWay}" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True" FontWeight="Bold"
                                                 Background="{DynamicResource SurfacePageBrush}"/>
                                    </StackPanel>

                                    <!-- Stok Düzeltme (Sadece Edit modunda) -->
                                    <StackPanel Grid.Column="2" Visibility="{Binding IsStockAdjustmentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Label Content="Stok Düzeltme (+ / -)" Style="{StaticResource ModernLabel}"/>
                                        <TextBox Text="{Binding StockAdjustment, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 ToolTip="Pozitif stok girerek artırın, negatif girerek düşürün (Örn: +10 veya -3)"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 🖼️ TAB 3: GÖRSEL & ÖZELLİKLER -->
            <TabItem Header="🖼️ Görsel &amp; Özellikler">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Fotoğraf Yükleme Dropzone -->
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Ürün Görseli" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview Image Frame -->
                                    <Border Grid.Column="0" Width="120" Height="120" CornerRadius="12"
                                            Background="{DynamicResource SurfacePageBrush}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                            HorizontalAlignment="Left" ClipToBounds="True">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Image24" FontSize="36" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding SelectedImagePreview}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <!-- Controls -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ürün görseli ekleyerek tekliflerde ve aramalarda kolay bulunmasını sağlayın."
                                                   Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Fotoğraf Seç" Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseImageCommand}"
                                                       Appearance="Primary" Height="36" Margin="0,0,8,0"/>
                                            <ui:Button Content="Fotoğrafı Kaldır" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveImageCommand}"
                                                       Appearance="Secondary" Height="36"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dinamik Teknik Özellikler -->
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Teknik Özellikler (Kategoriye Özel)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12"/>
                                <ContentControl Content="{Binding CurrentSpecs}"/>
                                
                                <StackPanel Margin="0,12,0,0">
                                    <Label Content="Notlar / Özel Belirteçler" Style="{StaticResource ModernLabel}"/>
                                    <TextBox Text="{Binding CurrentSpecs.Notes, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ürün Açıklaması -->
                        <Border Style="{StaticResource CardPanel}" Padding="20">
                            <StackPanel>
                                <Label Content="Ürün Detaylı Açıklaması" Style="{StaticResource ModernLabel}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding NewProduct.Description, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ════════ ROW 2: FOOTER ════════ -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="İptal" Command="{Binding CancelCommand}" Height="40" Padding="24,0" Margin="0,0,8,0" Appearance="Secondary"/>
                <ui:Button Content="{Binding SaveButtonText}" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SaveCommand}" IsDefault="True" Height="40" Padding="28,0" Appearance="Primary"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
