<UserControl x:Class="KamatekCrm.Views.ServiceJobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KamatekCrm.Views"
             xmlns:helpers="clr-namespace:KamatekCrm.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:enums="clr-namespace:KamatekCrm.Shared.Enums;assembly=KamatekCrm.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             helpers:AnimationHelper.EntranceAnimation="SlideInFromBottom"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sadece Keşif tipindeki kayıtlarda görünmesi gereken menü öğeleri için -->
        <Style x:Key="DiscoveryMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorkOrderTypeDisplay}" Value="🔍 Keşif">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/> <!-- Row 1: KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- Row 3: DataGrid -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: HEADER ════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="İş Emri Yönetim Merkezi" 
                           FontSize="26" FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0">
                    <Run Text="Sistemde toplam "/>
                    <Run Text="{Binding TotalJobCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                    <Run Text=" iş kaydı bulunuyor (Bugün eklenen: "/>
                    <Run Text="{Binding TodayCreatedCount, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=")"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <ui:Button Content="Yeni İş Emri Ekle"
                           Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding OpenNewJobFormCommand}"
                           Appearance="Primary"
                           Height="40" Padding="20,0" Margin="0,0,8,0"/>

                <ui:Button Command="{Binding RefreshListCommand}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Yenile"
                           Appearance="Secondary"
                           Height="40" Padding="14,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ════════ ROW 1: KPI CARDS ════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Toplam -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#262196F3" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="GroupList24" FontSize="20" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam İş" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding TotalJobCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 2: Bekleyen -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#26FF9800" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="#FF9800" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bekleyen" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="20" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 3: Devam Eden -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#262196F3" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Devam Eden" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding InProgressCount}" FontSize="20" FontWeight="Bold" Foreground="#2196F3"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 4: Tamamlanan -->
            <Border Grid.Column="6" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#264CAF50" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tamamlanan" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 5: SLA Aşan -->
            <Border Grid.Column="8" Style="{StaticResource CardPanel}" Padding="16">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#26F44336" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="#F44336" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SLA Aşan" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        <TextBlock Text="{Binding SlaBreachedCount}" FontSize="20" FontWeight="Bold" Foreground="#F44336"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ════════ ROW 2: SEARCH TOOLBAR ════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            PlaceholderText="İş Emri No, Müşteri Adı veya Açıklama Arayın..." 
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                            Icon="{ui:SymbolIcon Search24}" 
                            Height="38" VerticalAlignment="Center"/>

                <ComboBox Grid.Column="2" 
                          SelectedValuePath="Content" SelectedValue="{Binding SelectedStatusFilter}"
                          Style="{StaticResource ModernComboBox}" Height="38">
                    <ComboBoxItem Content="Tümü"/>
                    <ComboBoxItem Content="Bekliyor"/>
                    <ComboBoxItem Content="Devam Ediyor"/>
                    <ComboBoxItem Content="Tamamlandı"/>
                    <ComboBoxItem Content="İptal Edildi"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ════════ ROW 3: DATAGRID ════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="16">
            <DataGrid ItemsSource="{Binding ServiceJobsView}"
                      SelectedItem="{Binding SelectedServiceJob}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
                
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📋 Detay Göster" Command="{Binding ViewJobDetailCommand}" CommandParameter="{Binding SelectedServiceJob}"/>
                        <MenuItem Header="✏️ İşi Düzenle" Command="{Binding EditJobCommand}" CommandParameter="{Binding SelectedServiceJob}"/>
                        <Separator/>
                        <MenuItem Header="Teklife Dönüştür" Command="{Binding ConvertToQuoteCommand}" CommandParameter="{Binding SelectedServiceJob}"/>
                        <Separator/>
                        <MenuItem Header="Bekliyor Yap" Command="{Binding ChangeJobStatusCommand}" CommandParameter="Pending"/>
                        <MenuItem Header="Devam Ediyor Yap" Command="{Binding ChangeJobStatusCommand}" CommandParameter="InProgress"/>
                        <MenuItem Header="Tamamla" Command="{Binding ChangeJobStatusCommand}" CommandParameter="Completed"/>
                        <MenuItem Header="İptal Et" Command="{Binding ChangeJobStatusCommand}" CommandParameter="Cancelled"/>
                        <Separator/>
                        <MenuItem Header="PDF Yazdır" Command="{Binding PrintServiceFormCommand}" CommandParameter="{Binding SelectedServiceJob}"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Sil" Command="{Binding DeleteJobCommand}" CommandParameter="{Binding SelectedServiceJob}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Müşteri -->
                    <DataGridTemplateColumn Header="Müşteri" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerFullName}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock Text="{Binding CustomerPhone, Converter={StaticResource SensitiveData}, ConverterParameter=Phone}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Açıklama -->
                    <DataGridTextColumn Header="Açıklama / Konu" Binding="{Binding Description}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Durum Rozeti -->
                    <DataGridTemplateColumn Header="Durum" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#26FF9800"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusDisplay}" Value="Devam Ediyor">
                                                    <Setter Property="Background" Value="#262196F3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusDisplay}" Value="Tamamlandı">
                                                    <Setter Property="Background" Value="#264CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusDisplay}" Value="İptal">
                                                    <Setter Property="Background" Value="#26F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusDisplay}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Öncelik Rozeti -->
                    <DataGridTemplateColumn Header="Öncelik" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#264CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PriorityDisplay}" Value="🔥 Acil">
                                                    <Setter Property="Background" Value="#26F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PriorityDisplay}" Value="⚡ Yüksek">
                                                    <Setter Property="Background" Value="#26FF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PriorityDisplay}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tarih -->
                    <DataGridTextColumn Header="Oluşturulma" Binding="{Binding CreatedDate, StringFormat='{}dd.MM.yyyy HH:mm'}" Width="130"/>

                    <!-- İşlemler Kolonu -->
                    <DataGridTemplateColumn Header="İşlemler" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Detay -->
                                    <ui:Button Icon="{ui:SymbolIcon Eye24}"
                                               Command="{Binding DataContext.ViewJobDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" ToolTip="Detay Göster"/>
                                    
                                    <!-- Düzenle -->
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                               Command="{Binding DataContext.EditJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" ToolTip="Düzenle"/>

                                    <!-- PDF -->
                                    <ui:Button Icon="{ui:SymbolIcon Print24}"
                                               Command="{Binding DataContext.PrintServiceFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" ToolTip="PDF Yazdır"/>

                                    <!-- Sil -->
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                               Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary" Height="28" Width="28" Padding="0" Foreground="#F44336" ToolTip="Sil"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
