<UserControl x:Class="KamatekCrm.Views.ServiceJobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KamatekCrm.Views"
             xmlns:helpers="clr-namespace:KamatekCrm.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:enums="clr-namespace:KamatekCrm.Shared.Enums;assembly=KamatekCrm.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             helpers:AnimationHelper.EntranceAnimation="SlideInFromBottom"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sadece Keşif tipindeki kayıtlarda görünmesi gereken menü öğeleri için -->
        <Style x:Key="DiscoveryMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorkOrderTypeDisplay}" Value="🔍 Keşif">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== ROW 0: HEADER ========== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="24,16" Margin="0,0,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Geri" Command="{Binding NavigateBackCommand}" 
                            Style="{StaticResource SecondaryButton}" Padding="16,4" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔧 İş Emri Yönetim Merkezi" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="Toplam"/>
                            <Run Text="{Binding TotalJobCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Run Text="iş kaydı  •  Bugün"/>
                            <Run Text="{Binding TodayCreatedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Run Text="yeni"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="➕ Yeni İş Emri"
                               Command="{Binding OpenNewJobFormCommand}"
                               Appearance="Primary"
                               Height="38" Padding="16,0" Margin="0,0,8,0" FontSize="14"/>
                    <ui:Button Content="✏️ Düzenle"
                               Command="{Binding EditJobCommand}"
                               CommandParameter="{Binding SelectedServiceJob}"
                               Appearance="Secondary"
                               Height="38" Padding="16,0" Margin="0,0,8,0" FontSize="14"/>
                    <ui:Button Content="🔄"
                               Command="{Binding RefreshListCommand}"
                               Width="38" Height="38" Padding="0"
                               ToolTip="Yenile"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== ROW 1: KPI CARDS ========== -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="16,16,16,4">
            <!-- Toplam -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                    Padding="16,16" Margin="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource StatusInfoBgLight}" CornerRadius="8" Width="28" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TOPLAM" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalJobCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Bekleyen -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                    Padding="16,16" Margin="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource StatusWarningBgLight}" CornerRadius="8" Width="28" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="⏳" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="BEKLEYEN" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusWarningFg}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Devam Eden -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                    Padding="16,16" Margin="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource StatusInfoBgLight}" CornerRadius="8" Width="28" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="🔵" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="DEVAM EDEN" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusInfoFg}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding InProgressCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Tamamlanan -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                    Padding="16,16" Margin="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource StatusSuccessBgLight}" CornerRadius="8" Width="28" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="✅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TAMAMLANAN" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusSuccessFg}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- SLA Aşan -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"
                    Padding="16,16" Margin="4"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{DynamicResource StatusErrorBgLight}" CornerRadius="8" Width="28" Height="28" Margin="0,0,8,0">
                            <TextBlock Text="⚠️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SLA AŞAN" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusErrorFg}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SlaBreachedCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource StatusErrorFg}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ========== ROW 2: F-PATTERN CONTENT (70/30) ========== -->
        <Grid Grid.Row="2" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL BÖLGE (%70) - DataGrid -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Padding="16,16" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="İş Emirleri Listesi" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <ui:Button Content="🖨️ PDF Yazdır"
                                       Command="{Binding PrintServiceFormCommand}"
                                       CommandParameter="{Binding SelectedServiceJob}"
                                       HorizontalAlignment="Right"
                                       Height="32" Padding="16,0"/>
                        </DockPanel>
                    </Border>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ServiceJobsView}"
                          SelectedItem="{Binding SelectedServiceJob}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          AlternatingRowBackground="{DynamicResource SurfacePageBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="40"
                          RowHeight="44"
                          FontSize="14">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📋 Detay Göster" Command="{Binding ViewJobDetailCommand}" 
                                      CommandParameter="{Binding SelectedServiceJob}"/>
                            <MenuItem Header="✏️ İşi Düzenle" Command="{Binding EditJobCommand}" 
                                      CommandParameter="{Binding SelectedServiceJob}"/>
                            <Separator/>
                            <MenuItem Header="🔍 Keşfi Onayla &amp; Malzeme Seç" 
                                      Command="{Binding ApproveDiscoveryCommand}" 
                                      CommandParameter="{Binding SelectedServiceJob}"
                                      Style="{StaticResource DiscoveryMenuItemStyle}"/>
                            <MenuItem Header="❌ Keşfi Reddet" 
                                      Command="{Binding ChangeJobStatusCommand}" 
                                      CommandParameter="Cancelled"
                                      Style="{StaticResource DiscoveryMenuItemStyle}"/>
                            <Separator/>
                            <MenuItem Header="⏳ Bekliyor Yap" Command="{Binding ChangeJobStatusCommand}" CommandParameter="Pending"/>
                            <MenuItem Header="🔵 Devam Ediyor Yap" Command="{Binding ChangeJobStatusCommand}" CommandParameter="InProgress"/>
                            <MenuItem Header="✅ Tamamla" Command="{Binding ChangeJobStatusCommand}" CommandParameter="Completed"/>
                            <MenuItem Header="❌ İptal Et" Command="{Binding ChangeJobStatusCommand}" CommandParameter="Cancelled"/>
                            <Separator/>
                            <MenuItem Header="🖨️ PDF Yazdır" Command="{Binding PrintServiceFormCommand}" 
                                      CommandParameter="{Binding SelectedServiceJob}"/>
                            <Separator/>
                            <MenuItem Header="🗑️ Sil" Command="{Binding DeleteJobCommand}" Foreground="{DynamicResource ThemeError}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- ID -->
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Müşteri -->
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding Customer.FullName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Açıklama -->
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- İş Türü -->
                        <DataGridTextColumn Header="Tür" Binding="{Binding WorkOrderTypeDisplay}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Durum -->
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusDisplay}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Öncelik -->
                        <DataGridTemplateColumn Header="Öncelik" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Padding="8,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:JobPriority.Low}">
                                                        <Setter Property="Text" Value="🟢 Düşük"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:JobPriority.Normal}">
                                                        <Setter Property="Text" Value="🔵 Normal"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:JobPriority.Urgent}">
                                                        <Setter Property="Text" Value="🟠 Acil"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static enums:JobPriority.Critical}">
                                                        <Setter Property="Text" Value="🔴 Kritik"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Teknisyen -->
                        <DataGridTextColumn Header="Teknisyen" Binding="{Binding AssignedTechnician}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tarih -->
                        <DataGridTextColumn Header="Tarih" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SLA -->
                        <DataGridTextColumn Header="SLA" Binding="{Binding SlaStatus}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tutar -->
                        <DataGridTextColumn Header="Tutar" Binding="{Binding TotalAmount, StringFormat=₺{0:N0}}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>

            <!-- SAĞ BÖLGE (%30) - Filtreler ve Arama -->
            <StackPanel Grid.Column="2">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="24"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.06" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Arama ve Filtreleme" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <!-- Arama -->
                        <TextBlock Text="Hızlı Arama" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ui:TextBox PlaceholderText="Müşteri, başlık veya açıklama..."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Height="40" Margin="0,0,0,16"/>

                        <!-- Durum Filtre -->
                        <TextBlock Text="Durum Filtresi" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Height="40" Margin="0,0,0,16"
                                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="All">
                                                        <Setter Property="Text" Value="🔘 Tümü"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Pending">
                                                        <Setter Property="Text" Value="⏳ Bekleyen"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="InProgress">
                                                        <Setter Property="Text" Value="🔵 Devam Eden"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="Completed">
                                                        <Setter Property="Text" Value="✅ Tamamlanan"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Tarih Filtre -->
                        <TextBlock Text="Tarih Aralığı" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <StackPanel Margin="0,0,0,16">
                            <DatePicker SelectedDate="{Binding FilterStartDate}" 
                                        Height="40" Margin="0,0,0,8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                            <DatePicker SelectedDate="{Binding FilterEndDate}" 
                                        Height="40"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
