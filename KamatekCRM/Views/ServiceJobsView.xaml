<UserControl x:Class="KamatekCrm.Views.ServiceJobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:KamatekCrm.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1440"
             helpers:AnimationHelper.EntranceAnimation="SlideInFromBottom"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- View Switcher Segmented Button Style -->
        <Style x:Key="ViewSwitcherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smart KPI Card Style -->
        <Style x:Key="RadarKpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kanban Card Template -->
        <DataTemplate x:Key="KanbanCardTemplate">
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,8" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding DataContext.ViewJobDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Row}"/>
                </Border.InputBindings>
                <StackPanel>
                    <!-- Top Row: Code + Category + Open Button -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CodeDisplay}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource SurfaceSubtleBrush}"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ui:Button Grid.Column="2" Content="Aç" Padding="8,2" FontSize="11" Height="24"
                                   Appearance="Secondary" Cursor="Hand"
                                   Command="{Binding DataContext.ViewJobDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding Row}"/>
                    </Grid>

                    <!-- Customer & Description -->
                    <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadingBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" Margin="0,2,0,6"/>

                    <!-- Meta: Tech & Date -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TechnicianDisplay}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Footer: Total + Smart Alert Pill -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TotalDisplay}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"/>

                        <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource SurfaceSubtleBrush}">
                            <TextBlock Text="{Binding PrimaryAlertText}" FontSize="10" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCriticalAlert}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header + View Switcher + Actions -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 5 Smart KPI Radar Cards -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Single-Row Compact Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Row 3: Kanban / Table / Field Calendar -->
        </Grid.RowDefinitions>

        <!-- ════════ ROW 0: HEADER & 3-MODE VIEW SWITCHER ════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Wrench24" FontSize="22" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="İş Emri Komuta Merkezi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="Keşif, teklif, montaj ve tahsilat süreçlerini tek ekrandan yönetin" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 3-Mode View Switcher -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Süreç Panosu" Style="{StaticResource ViewSwitcherButtonStyle}"
                            Tag="{Binding IsKanbanView}" Command="{Binding SetViewModeCommand}" CommandParameter="Kanban"/>
                    <Button Content="Akıllı Liste" Style="{StaticResource ViewSwitcherButtonStyle}"
                            Tag="{Binding IsTableView}" Command="{Binding SetViewModeCommand}" CommandParameter="Table" Margin="2,0"/>
                    <Button Content="Saha Takvimi" Style="{StaticResource ViewSwitcherButtonStyle}"
                            Tag="{Binding IsCalendarView}" Command="{Binding SetViewModeCommand}" CommandParameter="Calendar"/>
                </StackPanel>
            </Border>

            <!-- Primary Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Yeni İş Emri" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding OpenNewJobFormCommand}"
                           Appearance="Primary" Height="36" Padding="14,0" Margin="0,0,8,0" Cursor="Hand"/>
                <ui:Button Content="Yenile" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Command="{Binding RefreshListCommand}"
                           Appearance="Secondary" Height="36" Padding="12,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- ════════ ROW 1: 5 CLICKABLE SMART-FILTER KPI CARDS ════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Bugün Yapılacaklar -->
            <Border Grid.Column="0" Style="{StaticResource RadarKpiCardStyle}" Tag="{Binding IsRadarTodayActive}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectRadarFilterCommand}" CommandParameter="Today"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Bugün Yapılacaklar" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RadarTodayCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="CalendarToday24" FontSize="20" Foreground="{DynamicResource AccentPrimaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75"/>
                </Grid>
            </Border>

            <!-- 2. Teknisyen Bekleyen -->
            <Border Grid.Column="2" Style="{StaticResource RadarKpiCardStyle}" Tag="{Binding IsRadarUnassignedActive}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectRadarFilterCommand}" CommandParameter="Unassigned"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Teknisyen Bekleyen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RadarUnassignedCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="PersonAlert24" FontSize="20" Foreground="{DynamicResource WarningBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75"/>
                </Grid>
            </Border>

            <!-- 3. Teklif Bekleyen -->
            <Border Grid.Column="4" Style="{StaticResource RadarKpiCardStyle}" Tag="{Binding IsRadarWaitingQuoteActive}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectRadarFilterCommand}" CommandParameter="WaitingQuote"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Teklif Bekleyen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RadarWaitingQuoteCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource InfoBrush}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="20" Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75"/>
                </Grid>
            </Border>

            <!-- 4. Geciken / Unutulan -->
            <Border Grid.Column="6" Style="{StaticResource RadarKpiCardStyle}" Tag="{Binding IsRadarOverdueActive}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectRadarFilterCommand}" CommandParameter="Overdue"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Geciken / Unutulan" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RadarOverdueCount}" FontSize="22" FontWeight="Bold" Typography.NumeralAlignment="Tabular">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RadarOverdueCount}" Value="0">
                                            <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75"/>
                </Grid>
            </Border>

            <!-- 5. Tahsilat Bekleyen -->
            <Border Grid.Column="8" Style="{StaticResource RadarKpiCardStyle}" Tag="{Binding IsRadarWaitingPaymentActive}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectRadarFilterCommand}" CommandParameter="WaitingPayment"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Tahsilat Bekleyen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RadarWaitingPaymentCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════ ROW 2: SINGLE-ROW COMPACT FILTER BAR ════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" PlaceholderText="İş emri #, müşteri adı, telefon veya açıklama ara..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}" Height="34" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Başlangıç:" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FilterStartDate}" Width="130" Height="34"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Bitiş:" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FilterEndDate}" Width="130" Height="34"/>
                </StackPanel>

                <ComboBox Grid.Column="3" ItemsSource="{Binding StatusFilters}"
                          SelectedValue="{Binding SelectedStatusFilter}"
                          SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                          Width="160" Height="34" Margin="0,0,10,0"/>

                <ui:Button Grid.Column="4" Content="Temizle" Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding ClearFiltersCommand}"
                           Appearance="Secondary" Height="34" Padding="12,0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ════════ ROW 3A: KANBAN MODE (DEFAULT — 5 PROCESS COLUMNS) ════════ -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsKanbanView, Converter={StaticResource BoolToVis}}">
            <Grid MinWidth="1120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Talep & Planlanacak -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <TextBlock Text="Talep &amp; Planlanacak" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="8,1">
                                <TextBlock Text="{Binding KanbanRequestCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding KanbanRequestCards}" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 2: Keşif -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <TextBlock Text="Keşif" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="8,1">
                                <TextBlock Text="{Binding KanbanDiscoveryCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding KanbanDiscoveryCards}" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 3: Teklif Bekleyen -->
                <Border Grid.Column="4" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <TextBlock Text="Teklif Bekleyen" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="8,1">
                                <TextBlock Text="{Binding KanbanQuoteCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding KanbanQuoteCards}" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 4: Montaj / Sahada -->
                <Border Grid.Column="6" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <TextBlock Text="Montaj / Sahada" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="8,1">
                                <TextBlock Text="{Binding KanbanInstallationCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding KanbanInstallationCards}" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 5: Teslim & Tahsilat -->
                <Border Grid.Column="8" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <TextBlock Text="Teslim &amp; Tahsilat" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="10" Padding="8,1">
                                <TextBlock Text="{Binding KanbanDeliveryCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding KanbanDeliveryCards}" ItemTemplate="{StaticResource KanbanCardTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ════════ ROW 3B: SMART TABLE MODE + QUICK PREVIEW PANEL ════════ -->
        <Grid Grid.Row="3" Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" MinWidth="560"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                <DataGrid x:Name="ServiceJobsDataGrid"
                          ItemsSource="{Binding ServiceJobsView}"
                          SelectedItem="{Binding SelectedServiceJob}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Çalışma Alanını Aç" Command="{Binding Tag.ViewJobDetailCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="Düzenle" Command="{Binding Tag.EditJobCommand}" CommandParameter="{Binding DataContext}"/>
                                        <Separator/>
                                        <MenuItem Header="Teklife Dönüştür" Command="{Binding Tag.ConvertToQuoteCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="Teklifi Düzenle" Command="{Binding Tag.EditQuoteCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="Teklifi Onayla" Command="{Binding Tag.AcceptQuoteCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="Montaj Planla" Command="{Binding Tag.SetInstallationPlannedCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="Montajı Tamamla" Command="{Binding Tag.SetInstallationCompletedCommand}" CommandParameter="{Binding DataContext}"/>
                                        <Separator/>
                                        <MenuItem Header="Servis Formu Yazdır" Command="{Binding Tag.PrintServiceFormCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="İşi İptal Et" Command="{Binding Tag.CancelJobCommand}" CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="Sil" Command="{Binding Tag.DeleteJobCommand}" CommandParameter="{Binding DataContext}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="58" MinWidth="54"/>
                        <DataGridTextColumn Header="Müşteri" Binding="{Binding CustomerFullName}" Width="1.2*" MinWidth="150"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="1.5*" MinWidth="170"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusDisplay}" Width="Auto" MinWidth="130"/>
                        <DataGridTextColumn Header="Öncelik" Binding="{Binding PriorityDisplay}" Width="Auto" MinWidth="88"/>
                        <DataGridTextColumn Header="Teknisyen" Binding="{Binding AssignedTechnician}" Width="Auto" MinWidth="115"/>
                        <DataGridTextColumn Header="Tutar" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} ₺'}" Width="Auto" MinWidth="100"/>
                        <DataGridTemplateColumn Header="Aksiyon" Width="Auto" MinWidth="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Aç" Appearance="Secondary" Height="26" Padding="10,0" FontSize="11" Cursor="Hand"
                                               Command="{Binding DataContext.ViewJobDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right Quick Preview Panel -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedServiceJob, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
                        <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Önizleme için listeden bir iş emri seçin" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedServiceJob, Converter={StaticResource NullToVis}}">
                        <StackPanel DataContext="{Binding SelectedServiceJob}">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding Id, StringFormat='İş Emri #{0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSubtleBgBrush}" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding CustomerFullName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Text="{Binding CustomerPhone}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10"/>

                            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBodyBrush}"/>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teknisyen" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AssignedTechnician, TargetNullValue='Atanmadı'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Toplam Tutar" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ₺'}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Grid>

                            <!-- Primary & Secondary Actions (Always readable in Light & Dark) -->
                            <ui:Button Content="Çalışma Alanını Aç" Icon="{ui:SymbolIcon Open24}" Appearance="Primary"
                                       HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,8" Cursor="Hand"
                                       Command="{Binding DataContext.ViewJobDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>

                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <ui:Button Content="Düzenle" Appearance="Secondary" HorizontalAlignment="Stretch" Height="32" Margin="0,0,4,0"
                                           Command="{Binding DataContext.EditJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="PDF / Yazdır" Appearance="Secondary" HorizontalAlignment="Stretch" Height="32" Margin="4,0,0,0"
                                           Command="{Binding DataContext.PrintServiceFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"/>
                            </UniformGrid>

                            <ui:Button Content="Tamamla" Appearance="Secondary" HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,8"
                                       Command="{Binding DataContext.CompleteJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                            <ui:Button Content="Teklife Dönüştür" Appearance="Secondary" HorizontalAlignment="Stretch" Height="32"
                                       Command="{Binding DataContext.ConvertToQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════ ROW 3C: FIELD CALENDAR MODE (WEEKLY BY DAY / TECHNICIAN) ════════ -->
        <Grid Grid.Row="3" Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Calendar Navigation -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Önceki Hafta" Appearance="Secondary" Height="30" Padding="10,0" Margin="0,0,6,0"
                                   Command="{Binding PreviousCalendarWeekCommand}"/>
                        <ui:Button Content="Bu Hafta" Appearance="Secondary" Height="30" Padding="10,0" Margin="0,0,6,0"
                                   Command="{Binding TodayCalendarWeekCommand}"/>
                        <ui:Button Content="Sonraki Hafta" Appearance="Secondary" Height="30" Padding="10,0"
                                   Command="{Binding NextCalendarWeekCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CalendarWeekRangeLabel}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 7-Day Columns -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CalendarWeekDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" MinWidth="1120"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="6" Padding="6,4" Margin="0,0,0,8"
                                            Background="{DynamicResource SurfaceSubtleBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding DayTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                                            <TextBlock Text="{Binding SlotCount}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.ViewJobDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding Row}"/>
                                                        </Border.InputBindings>
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentPrimaryBrush}" Typography.NumeralAlignment="Tabular"/>
                                                                <TextBlock Text="{Binding StageLabel}" FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextHeadingBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding TechnicianName}" FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="4" Padding="5,2" Margin="0,4,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding HasOverlap, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding OverlapText}" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{DynamicResource DangerBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
