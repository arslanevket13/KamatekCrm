<Window x:Class="KamatekCrm.Views.CustomerAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:KamatekCrm.Helpers"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Yeni Müşteri Ekle" Height="720" Width="640"
        MinWidth="540" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfacePageBrush}">

    <Window.Resources>
        <helpers:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PersonAdd24" FontSize="26" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yeni Müşteri Oluştur" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                    <TextBlock Text="Bireysel, kurumsal veya perakende yeni müşteri kartı ekleyin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ FORM CONTENT ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- SECTION 1: MÜŞTERİ TİPİ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Person24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Müşteri Tipi Seçimi" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Bireysel" 
                                         IsChecked="{Binding NewCustomerType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Individual, Mode=TwoWay}"
                                         GroupName="NewCustomerType" Margin="0,0,24,0" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <RadioButton Content="Kurumsal Şirket" 
                                         IsChecked="{Binding NewCustomerType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Corporate, Mode=TwoWay}"
                                         GroupName="NewCustomerType" Margin="0,0,24,0" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <RadioButton Content="Perakende / WalkIn" 
                                         IsChecked="{Binding NewCustomerType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=WalkIn, Mode=TwoWay}"
                                         GroupName="NewCustomerType" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: BİREYSEL EK BİLGİLER -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16"
                        Visibility="{Binding NewCustomerType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Individual}">
                    <StackPanel>
                        <Label Content="TC Kimlik No" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewTcKimlikNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Height="38"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: KURUMSAL EK BİLGİLER -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16"
                        Visibility="{Binding NewCustomerType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Corporate}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Building24" FontSize="18" Foreground="{DynamicResource ThemeWarning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kurumsal Şirket Bilgileri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <Label Content="Şirket Tam Ünvanı *" FontWeight="SemiBold"/>
                            <ui:TextBox Text="{Binding NewCompanyName, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Vergi Numarası" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding NewTaxNumber, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Vergi Dairesi" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding NewTaxOffice, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: TEMEL İLETİŞİM BİLGİLERİ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Phone24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Temel İletişim Bilgileri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Ad Soyad *" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Telefon *" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="05XX XXX XX XX" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="E-posta" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ornek@domain.com" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Doğum Tarihi" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding BirthDate}" Height="38" FontSize="13" Padding="6,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 5: ADRES BİLGİLERİ -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" 
                        Padding="20" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Location24" FontSize="18" Foreground="{DynamicResource ThemePrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Adres Bilgileri" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Şehir" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" DisplayMemberPath="Name" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="İlçe" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrict}" DisplayMemberPath="Name" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Mahalle" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Neighborhoods}" SelectedItem="{Binding SelectedNeighborhood}" DisplayMemberPath="Name" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Sokak / Cadde" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Bina No" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding BuildingNo, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Daire No" FontWeight="SemiBold"/>
                                <ui:TextBox Text="{Binding ApartmentNo, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Error Message Overlay -->
                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Background="{DynamicResource StatusErrorBg}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusErrorFg}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ FOOTER BUTTONS ═══════════════ -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <ui:Button DockPanel.Dock="Left" Content="Temizle" Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding ClearFormCommand}" Appearance="Secondary" Height="38" Padding="16,0" Cursor="Hand"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="İptal" Command="{Binding CancelCommand}" Appearance="Secondary" Height="38" Padding="20,0" Margin="0,0,8,0" Click="CloseWindow_Click" Cursor="Hand"/>
                <ui:Button Content="Müşteriyi Kaydet" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Appearance="Primary" Height="38" Padding="20,0" IsDefault="True" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
