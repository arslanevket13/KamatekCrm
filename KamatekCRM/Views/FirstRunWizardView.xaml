<UserControl x:Class="KamatekCrm.Views.FirstRunWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="{DynamicResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="860" Margin="32,28,32,36" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="KamatekCRM İlk Kurulum Sihirbazı"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Veritabanı ve işletme hesabınızı 3 kolay adımda otomatik hazırlayın."
                           FontSize="13" Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <!-- 3 ADIMLI STEPPER -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20,14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Adım 1 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SurfaceBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kurulum Tipi" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Veritabanı Motoru" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="36" Height="2" Background="{DynamicResource SubtleBorderBrush}" VerticalAlignment="Center" Margin="8,0"/>

                    <!-- Adım 2 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep2Done}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SurfaceBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="İşletme Bilgileri" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Firma &amp; Logo" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" Width="36" Height="2" Background="{DynamicResource SubtleBorderBrush}" VerticalAlignment="Center" Margin="8,0"/>

                    <!-- Adım 3 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SurfaceBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Yönetici Hesabı" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Parola &amp; Kurtarma" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HATA BANNER -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" FontWeight="Medium"/>
            </Border>

            <!-- ADIM İÇERİKLERİ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="28">
                <Grid>
                    <!-- ==================== ADIM 1 ==================== -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="1. Kurulum Tipini Seçin" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Tek bilgisayarda veya ofis ana makinesinde kullanacaksanız önerilen otomatik kurulumu seçin."
                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kart 1: Tek / Ana Bilgisayar -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1.5" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Tek / Ana Bilgisayar (Önerilen)"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Yerel PostgreSQL veritabanını otomatik kurar, güvenli parola üretir ve tabloları hazırlar."
                                               TextWrapping="Wrap" FontSize="12" Margin="0,6,0,14"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <CheckBox IsChecked="{Binding AllowLanAccess}"
                                              Content="Diğer ofis bilgisayarları da bağlansın (LAN)"
                                              Margin="0,0,0,16"
                                              Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <ui:Button Content="Otomatik Kurulumu Başlat"
                                               Appearance="Primary"
                                               Command="{Binding SetupLocalPostgresCommand}"
                                               IsEnabled="{Binding IsNotBusy}"
                                               HorizontalAlignment="Stretch" Height="40"/>
                                </StackPanel>
                            </Border>

                            <!-- Kart 2: İstemci -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Ofisteki Ana Bilgisayara Bağlan (İstemci)"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Yerel ağda kurulu KamatekCRM ana bilgisayarını tarar ve doğrudan bağlanır."
                                               TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <ui:Button Content="Ağdaki Sunucuları Tara"
                                               Appearance="Secondary"
                                               Command="{Binding ScanNetworkServersCommand}"
                                               HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,10"/>

                                    <ListBox ItemsSource="{Binding DiscoveredServers}"
                                             SelectedItem="{Binding SelectedServer}"
                                             DisplayMemberPath="DisplayText"
                                             Height="78" Margin="0,0,0,10"
                                             Visibility="{Binding HasDiscoveredServers, Converter={StaticResource BoolToVis}}"/>

                                    <ui:Button Content="Seçili Sunucuya Bağlan"
                                               Appearance="Primary"
                                               Command="{Binding ConnectToDiscoveredServerCommand}"
                                               Visibility="{Binding HasDiscoveredServers, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Stretch" Height="36"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Canlı İlerleme -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="110" Height="6" Margin="0,0,12,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Gelişmiş Link -->
                        <Button Content="Gelişmiş: Mevcut PostgreSQL Sunucusuna Bağlan →"
                                Command="{Binding OpenAdvancedConnectionCommand}"
                                HorizontalAlignment="Left" Margin="0,16,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- ==================== ADIM 2 ==================== -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="2. İşletme Bilgileri" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="PDF teklif ve servis fişlerinde görünecek işletme bilgilerinizi girin (isterseniz daha sonra Ayarlar'dan güncelleyebilirsiniz)."
                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="İşletme Adı *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn: Yılmaz Güvenlik Sistemleri"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="Telefon" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ui:TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn: 0222 230 40 50"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="İl" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ui:TextBox Text="{Binding CompanyCity, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn: Eskişehir"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="İlçe" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ui:TextBox Text="{Binding CompanyDistrict, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn: Odunpazarı"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
                                <TextBlock Text="İşletme Logosu (Opsiyonel)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding LogoPath}" IsReadOnly="True" PlaceholderText="Henüz logo seçilmedi" Margin="0,0,10,0"/>
                                    <ui:Button Grid.Column="1" Content="Logo Seç..." Command="{Binding BrowseLogoCommand}" Appearance="Secondary"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="Şimdilik Atla" Command="{Binding SkipCompanyInfoCommand}" Appearance="Secondary" Margin="0,0,10,0"/>
                            <ui:Button Content="Kaydet ve Devam Et →" Command="{Binding SaveCompanyInfoCommand}" Appearance="Primary"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== ADIM 3 ==================== -->
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="3. Yönetici Hesabı ve Kurtarma Anahtarı" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Sisteme giriş yapacağınız yönetici hesabını oluşturun ve şifre sıfırlama anahtarınızı saklayın."
                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Ad Soyad *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ui:TextBox Text="{Binding AdminFullName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Örn: Ahmet Yılmaz"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Kullanıcı Adı *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ui:TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="admin"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Parola *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <PasswordBox x:Name="AdminPasswordBox" PasswordChanged="AdminPasswordBox_PasswordChanged" Height="36" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Parola Tekrar *" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <PasswordBox x:Name="AdminPasswordConfirmBox" PasswordChanged="AdminPasswordConfirmBox_PasswordChanged" Height="36" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Canlı Parola Kuralları -->
                        <WrapPanel Margin="0,2,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="✓ En az 6 karakter" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMinPasswordLength}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="✓ Harf veya rakam içeriyor" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLetterOrDigit}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="✓ Parolalar eşleşiyor" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordsMatch}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>

                        <CheckBox IsChecked="{Binding KeepLoggedIn}"
                                  Content="Tek kullanıcıyım, bu bilgisayarda oturumu açık tut"
                                  Margin="0,0,0,16"
                                  Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <!-- Kurtarma Anahtarı Kartı -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Çevrimdışı Kurtarma Anahtarınız (Tek Seferlik Gösterilir)"
                                           FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Şifrenizi unutursanız bu anahtar ile internet bağlantısı olmadan yeni şifre belirleyebilirsiniz."
                                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding RecoveryKey}" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                    <ui:Button Grid.Column="1" Content="Panoya Kopyala" Command="{Binding CopyRecoveryKeyCommand}"
                                               Appearance="Secondary" Margin="0,0,8,0"/>
                                    <ui:Button Grid.Column="2" Content="Metin Dosyası Olarak Kaydet" Command="{Binding SaveRecoveryKeyToFileCommand}"
                                               Appearance="Secondary"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding HasConfirmedRecoveryKey}"
                                          Content="Kurtarma anahtarını güvenli bir yere kaydettim"
                                          FontWeight="SemiBold" Margin="0,12,0,0"
                                          Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="← Geri" Command="{Binding GoBackToStep2Command}" Appearance="Secondary" Margin="0,0,10,0"/>
                            <ui:Button Content="Kurulumu Tamamla ve Başla" Command="{Binding CompleteSetupCommand}" Appearance="Primary" Height="40"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
