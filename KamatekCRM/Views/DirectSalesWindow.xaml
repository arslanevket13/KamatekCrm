<Window x:Class="KamatekCrm.Views.DirectSalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.leocad.com/wpf/ui"
        mc:Ignorable="d"
        Title="🛍️ Perakende Satış Terminali (POS)" 
        Height="800" Width="1360"
        MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PremiumWindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ClearCartCommand}"/>
        <KeyBinding Key="F6" Command="{Binding ParkCurrentCartCommand}"/>
        <KeyBinding Key="F7" Command="{Binding QuickAddCustomerCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PayFullCashCommand}"/>
        <KeyBinding Key="F9" Command="{Binding PayFullCardCommand}"/>
        <KeyBinding Key="F10" Command="{Binding PayFullOnAccountCommand}"/>
        <KeyBinding Key="F11" Command="{Binding PrintLastReceiptCommand}"/>
        <KeyBinding Key="F12" Command="{Binding CompleteSaleCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Action Button Style -->
        <Style x:Key="PosActionBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Pill Button Style -->
        <Style x:Key="PillPresetBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemePrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextInverseBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================= LEFT: CATALOG & BARCODE ========================= -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
            <Border.Effect><DropShadowEffect BlurRadius="14" Opacity="0.08" ShadowDepth="2"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title & Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Ürün Kataloğu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Warehouse Selection -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Depo:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  Height="32" Width="140" TabIndex="2"/>
                    </StackPanel>
                </Grid>

                <!-- Highlighted Barcode Scanning Field -->
                <Border Grid.Row="1" Background="{DynamicResource StatusInfoBgLight}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource StatusInfoFgLight}" BorderThickness="1.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📷 Barkod / SKU:" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemePrimary}" Margin="0,0,12,0" FontSize="13"/>
                        <TextBox Grid.Column="1" x:Name="BarcodeTextBox"
                                 Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" TabIndex="0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding BarcodeScanCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="Ekle (Enter) →"
                                Command="{Binding BarcodeScanCommand}"
                                Background="{DynamicResource ThemePrimary}" Foreground="{DynamicResource TextInverseBrush}"
                                FontSize="12" FontWeight="Bold"
                                Padding="12,6" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search Input -->
                <Border Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" TabIndex="1"/>
                        <TextBlock Grid.Column="1" Text="Ürün adı, model veya barkod ile hızlı arama..."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Catalog DataGrid -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding FilteredProducts}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          RowHeight="48"
                          ColumnHeaderHeight="38">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource ThemePrimaryLight}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryDark}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ThemePrimaryLight}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Image / Icon Thumbnail -->
                        <DataGridTemplateColumn Header="" Width="48" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ApplicationBackgroundBrush}"
                                            HorizontalAlignment="Center" ClipToBounds="True">
                                        <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Product Name -->
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextHeadingBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Model / SKU -->
                        <DataGridTextColumn Header="Model / SKU" Binding="{Binding ModelName}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Stock Badge -->
                        <DataGridTemplateColumn Header="Stok" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StockQuantity}" Value="0">
                                                        <Setter Property="Background" Value="{DynamicResource StatusErrorBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockQuantity}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Price -->
                        <DataGridTextColumn Header="Fiyat" Binding="{Binding SalePrice, StringFormat='{}{0:N2} ₺'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryDark}"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Add Button -->
                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="➕"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource ThemeSuccess}" Foreground="{DynamicResource TextInverseBrush}"
                                            FontSize="14" Width="42" Height="34"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Sepete Ekle">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StockQuantity}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================= RIGHT: CART & POS TERMINAL ========================= -->
        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
            <Border.Effect><DropShadowEffect BlurRadius="14" Opacity="0.08" ShadowDepth="2"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: Header & Receipt Button -->
                    <RowDefinition Height="Auto"/>  <!-- 1: Parked Carts Bar -->
                    <RowDefinition Height="Auto"/>  <!-- 2: Customer Selection Panel -->
                    <RowDefinition Height="*"/>     <!-- 3: CART DATAGRID (Gets maximum star height!) -->
                    <RowDefinition Height="Auto"/>  <!-- 4: Global Discount & Change Calculator -->
                    <RowDefinition Height="Auto"/>  <!-- 5: Grand Totals Box -->
                    <RowDefinition Height="Auto"/>  <!-- 6: Payment Actions Grid -->
                    <RowDefinition Height="Auto"/>  <!-- 7: Status & Warnings -->
                </Grid.RowDefinitions>

                <!-- Row 0: Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛒" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Sepetim" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ThemePrimaryLight}" CornerRadius="8" Padding="8,3" Margin="12,0,0,0"
                                Visibility="{Binding CartItemCount, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding CartItemCount, StringFormat='{}{0} ürün'}"
                                       Foreground="{DynamicResource ThemePrimaryDark}" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- Print Thermal Receipt Action -->
                    <Button HorizontalAlignment="Right" Content="🖨️ Fiş Bas (F11)"
                            Command="{Binding PrintLastReceiptCommand}"
                            IsEnabled="{Binding HasLastOrder}"
                            Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource ThemePrimaryDark}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="Son satılan fişi yazdır">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 1: Parked Carts Tabs (Suspended Sales) -->
                <Border Grid.Row="1" Background="{DynamicResource StatusWarningBgLight}" CornerRadius="6" Padding="8,6" Margin="0,0,0,10"
                        Visibility="{Binding HasParkedCarts, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📌 Bekleyen Sepetler:" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StatusWarningFgDark}" Margin="0,0,8,0"/>
                        <ItemsControl ItemsSource="{Binding ParkedCarts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RestoreParkedCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource ThemePrimary}" Foreground="{DynamicResource TextInverseBrush}"
                                            Margin="3,0" Padding="8,3" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <TextBlock Text="{Binding Label}" Foreground="{TemplateBinding Foreground}" Margin="6,2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Row 2: Customer Selection Panel -->
                <Border Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="10,8"
                        Margin="0,0,0,10" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Customer Display & Add Button -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CustomerDisplayName}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Content="✕"
                                    Command="{Binding ClearCustomerCommand}"
                                    Foreground="{DynamicResource StatusErrorFg}" FontSize="12" FontWeight="Bold"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Margin="4,0,6,0" ToolTip="Müşteriyi Temizle">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="3" Content="➕ Müşteri (F7)"
                                    Command="{Binding QuickAddCustomerCommand}"
                                    Background="{DynamicResource ThemePrimary}" Foreground="{DynamicResource TextInverseBrush}"
                                    FontSize="11" FontWeight="Bold"
                                    BorderThickness="0" Cursor="Hand"
                                    Padding="8,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Search Customer Box -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <TextBox Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Padding="8,4"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" TabIndex="3">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <!-- Popup Dropdown -->
                            <Popup IsOpen="{Binding CustomerSearch, Converter={StaticResource BoolVis}}"
                                   Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.12"/></Border.Effect>
                                    <ListBox ItemsSource="{Binding FilteredCustomers}" Width="260" BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Left" Cursor="Hand" Width="240">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding PhoneNumber, Converter={StaticResource SensitiveData}, ConverterParameter=Phone, StringFormat=' · {0}'}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 3: CART DATAGRID (STAR HEIGHT — TAKES ALL AVAILABLE VERTICAL SPACE) -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <DataGrid ItemsSource="{Binding CartItems}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               HeadersVisibility="Column"
                               GridLinesVisibility="None"
                               BorderThickness="0"
                               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                               RowHeight="44">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ThemePrimaryLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryDark}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Product Name -->
                            <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Quantity with +/- Buttons -->
                            <DataGridTemplateColumn Header="Adet" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="−" Width="20" Height="20" FontSize="13" FontWeight="Bold"
                                                    Background="{DynamicResource StatusErrorBg}" Foreground="{DynamicResource StatusErrorFg}" BorderThickness="0"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Text="{Binding Quantity}" Width="26" TextAlignment="Center"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            <Button Content="+" Width="20" Height="20" FontSize="13" FontWeight="Bold"
                                                    Background="{DynamicResource StatusSuccessBg}" Foreground="{DynamicResource StatusSuccessFg}" BorderThickness="0"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Instant Price Edit (PropertyChanged!) -->
                            <DataGridTemplateColumn Header="B.Fiyat" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                                 FontSize="12" FontWeight="Bold"
                                                 Foreground="{DynamicResource TextHeadingBrush}"
                                                 BorderThickness="0" Background="Transparent"
                                                 TextAlignment="Right" VerticalAlignment="Center"
                                                 Padding="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Instant Discount Edit (PropertyChanged!) -->
                            <DataGridTemplateColumn Header="İnd.%" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}"
                                                 FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"
                                                 BorderThickness="0" Background="{DynamicResource ThemePrimaryLight}"
                                                 TextAlignment="Center" VerticalAlignment="Center"
                                                 Padding="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Line Total -->
                            <DataGridTextColumn Header="Tutar" Binding="{Binding LineTotal, StringFormat='{}{0:N2} ₺'}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryDark}"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Remove Button -->
                            <DataGridTemplateColumn Header="" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="{DynamicResource StatusErrorFg}"
                                                FontSize="12" FontWeight="Bold"
                                                BorderThickness="0" Cursor="Hand" ToolTip="Kaldır"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Row 4: Global Discount & Cash Change Calculator Bar -->
                <Border Grid.Row="4" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="10,6" Margin="0,8,0,6"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Global Discount -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 Genel İndirim (%)" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <TextBlock Grid.Column="1" Text="Tüm Ürünler:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="2" TabIndex="4"
                                     Text="{Binding GlobalDiscountPercent, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}"
                                     FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ThemePrimary}" BorderThickness="1"
                                     Padding="2,2" Foreground="{DynamicResource ThemePrimary}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Grid.Column="3" Text=" %" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryDark}"/>
                        </Grid>

                        <!-- Cash Change Calculator (Alınan Nakit / Para Üstü) -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💵 Alınan:" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Width="70"
                                     Text="{Binding TenderedAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                     FontSize="13" FontWeight="Bold" TextAlignment="Right"
                                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                     Padding="4,2"/>
                            
                            <!-- Presets -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0">
                                <Button Style="{StaticResource PillPresetBtn}" Content="Tam" Command="{Binding SetTenderedExactCommand}"/>
                                <Button Style="{StaticResource PillPresetBtn}" Content="50₺" Command="{Binding SetTenderedPresetCommand}" CommandParameter="50"/>
                                <Button Style="{StaticResource PillPresetBtn}" Content="100₺" Command="{Binding SetTenderedPresetCommand}" CommandParameter="100"/>
                                <Button Style="{StaticResource PillPresetBtn}" Content="200₺" Command="{Binding SetTenderedPresetCommand}" CommandParameter="200"/>
                                <Button Style="{StaticResource PillPresetBtn}" Content="500₺" Command="{Binding SetTenderedPresetCommand}" CommandParameter="500"/>
                            </StackPanel>

                            <!-- Para Üstü Display -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Para Üstü:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ChangeAmount, StringFormat='{}{0:N2} ₺'}"
                                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 5: Grand Totals Summary Box -->
                <Border Grid.Row="5" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0">
                            <TextBlock Text="Ara Toplam" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N2} ₺'}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock Text="İndirim" Foreground="{DynamicResource ThemePrimary}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DiscountTotal, StringFormat='- {0:N2} ₺'}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource ThemePrimary}" FontSize="11"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,2,0,0">
                            <TextBlock Text="KDV" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TaxTotal, StringFormat='{}{0:N2} ₺'}"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                        </Grid>
                        
                        <Separator Grid.Row="3" Background="{DynamicResource BorderDefaultBrush}" Margin="0,4"/>
                        
                        <!-- TOPLAM GRAND TOTAL -->
                        <Grid Grid.Row="4">
                            <TextBlock Text="GENEL TOPLAM" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHeadingBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} ₺'}"
                                       HorizontalAlignment="Right" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemePrimaryDark}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 6: Payment Actions Grid -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- NAKİT F8 -->
                    <Button Grid.Column="0" Grid.Row="0" Style="{StaticResource PosActionBtn}"
                            Command="{Binding PayFullCashCommand}"
                            Background="{DynamicResource ThemeSuccess}" Foreground="{DynamicResource TextInverseBrush}"
                            ToolTip="F8 Kısayolu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💵" FontSize="18" Margin="0,0,6,0"/>
                            <TextBlock Text="NAKİT (F8)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- KREDİ KARTI F9 -->
                    <Button Grid.Column="1" Grid.Row="0" Style="{StaticResource PosActionBtn}"
                            Command="{Binding PayFullCardCommand}"
                            Background="{DynamicResource ThemePrimary}" Foreground="{DynamicResource TextInverseBrush}"
                            ToolTip="F9 Kısayolu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" FontSize="18" Margin="0,0,6,0"/>
                            <TextBlock Text="KART (F9)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- CARİ / VERESİYE F10 -->
                    <Button Grid.Column="2" Grid.Row="0" Style="{StaticResource PosActionBtn}"
                            Command="{Binding PayFullOnAccountCommand}"
                            Background="{DynamicResource StatusWarningBgDark}" Foreground="{DynamicResource TextInverseBrush}"
                            ToolTip="F10 Kısayolu — Kayıtlı müşteri gerektirir">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,6,0"/>
                            <TextBlock Text="CARİ (F10)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- PARK ET (F6) -->
                    <Button Grid.Column="0" Grid.Row="1" Content="📌 Park Et (F6)"
                            Command="{Binding ParkCurrentCartCommand}"
                            Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource ThemePrimaryDark}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                            Height="34" FontSize="12" FontWeight="Bold" Margin="2,4,2,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- TEMİZLE (F5) -->
                    <Button Grid.Column="1" Grid.Row="1" Content="🗑️ Temizle (F5)"
                            Command="{Binding ClearCartCommand}"
                            Background="{DynamicResource StatusErrorBgLight}" Foreground="{DynamicResource ThemeError}"
                            Height="34" FontSize="12" FontWeight="Bold" Margin="2,4,2,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- OTOMATİK FİŞ TOGGLE -->
                    <CheckBox Grid.Column="2" Grid.Row="1" Content="Otomatik Fiş"
                              IsChecked="{Binding AutoPrintReceipt}"
                              VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"
                              FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"
                              ToolTip="Satış onaylandığında termal fişi otomatik yazdır"/>
                </Grid>

                <!-- Row 7: Status & Warnings -->
                <StackPanel Grid.Row="7" Margin="0,6,0,0">
                    <Border Background="{DynamicResource StatusWarningBgLight}" CornerRadius="6" Padding="6,4" Margin="0,0,0,4"
                            Visibility="{Binding HasStockWarning, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding StockWarningMessage}" FontSize="11" Foreground="{DynamicResource StatusWarningFgDark}" FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActionSuccessful}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
