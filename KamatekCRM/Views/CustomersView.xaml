<UserControl x:Class="KamatekCrm.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KamatekCrm.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
             xmlns:viewmodels="clr-namespace:KamatekCrm.ViewModels"
             xmlns:helpers="clr-namespace:KamatekCrm.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:enums="clr-namespace:KamatekCrm.Shared.Enums;assembly=KamatekCrm.Shared"
             d:DataContext="{d:DesignInstance Type=viewmodels:CustomersViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             helpers:AnimationHelper.EntranceAnimation="FadeIn"
             Background="{DynamicResource SurfacePageBrush}">

    <UserControl.Resources>
        <helpers:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════ HEADER & MAIN ACTION ════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="Müşteri Yönetimi" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimary}"
                       VerticalAlignment="Center"/>
                       
            <!-- Yeni Müşteri Butonu -->
            <ui:Button Grid.Column="1" 
                       Content="Yeni Müşteri Ekle" 
                       Icon="{ui:SymbolIcon PersonAdd24}"
                       Command="{Binding OpenAddCustomerWindowCommand}" 
                       Appearance="Primary"
                       Height="40"
                       Padding="16,0"
                       Cursor="Hand"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ════════ İSTATİSTİK KARTLARI ════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Toplam Müşteri -->
            <Border Grid.Column="0" Background="{DynamicResource ThemePrimaryDark}" CornerRadius="8" Margin="0,0,8,0" Padding="24" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Color="{DynamicResource ThemePrimaryDarkColor}"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClearTypeFilterCommand}"/>
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="People24" FontSize="16" Foreground="{DynamicResource ThemePrimaryLight}" Margin="0,0,8,0"/>
                        <TextBlock Text="Toplam" FontSize="12" Foreground="{DynamicResource ThemePrimaryLight}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCustomers}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Müşteri" FontSize="11" Foreground="{DynamicResource ThemePrimaryLight}"/>
                </StackPanel>
            </Border>
            
            <!-- Bireysel -->
            <Border Grid.Column="1" Background="{DynamicResource ThemeSuccess}" CornerRadius="8" Margin="8,0,8,0" Padding="24" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Color="{DynamicResource ThemeSuccessColor}"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static enums:CustomerType.Individual}"/>
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource ThemeSuccessLight}" Margin="0,0,8,0"/>
                        <TextBlock Text="Bireysel" FontSize="12" Foreground="{DynamicResource ThemeSuccessLight}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding IndividualCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Müşteri" FontSize="11" Foreground="{DynamicResource ThemeSuccessLight}"/>
                </StackPanel>
            </Border>
            
            <!-- Kurumsal -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeWarning}" CornerRadius="8" Margin="8,0,8,0" Padding="24" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Color="{DynamicResource ThemeWarningColor}"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static enums:CustomerType.Corporate}"/>
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Building24" FontSize="16" Foreground="{DynamicResource ThemeWarningLight}" Margin="0,0,8,0"/>
                        <TextBlock Text="Kurumsal" FontSize="12" Foreground="{DynamicResource ThemeWarningLight}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CorporateCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Müşteri" FontSize="11" Foreground="{DynamicResource ThemeWarningLight}"/>
                </StackPanel>
            </Border>
            
            <!-- WalkIn -->
            <Border Grid.Column="3" Background="{DynamicResource ThemeInfoDark}" CornerRadius="8" Margin="8,0,0,0" Padding="24" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Color="{DynamicResource ThemeInfoColor}"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Static enums:CustomerType.WalkIn}"/>
                </Border.InputBindings>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Cart24" FontSize="16" Foreground="{DynamicResource ThemeInfoLight}" Margin="0,0,8,0"/>
                        <TextBlock Text="Perakende" FontSize="12" Foreground="{DynamicResource ThemeInfoLight}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding WalkInCount}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Müşteri" FontSize="11" Foreground="{DynamicResource ThemeInfoLight}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════ F-PATTERN CONTENT (70/30) ════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL BÖLGE (%70) - DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Kayıtlı Müşteriler" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16" Foreground="{DynamicResource ThemeTextPrimary}"/>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding CustomersView}"
                              SelectedItem="{Binding SelectedCustomer}"
                              Style="{StaticResource ModernDataGrid}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCustomerProfileCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tip" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Individual">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Corporate">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="WalkIn">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeInfo}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="E-posta" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Şehir" Binding="{Binding City}" Width="100"/>
                            <DataGridTextColumn Header="Harcama" Binding="{Binding TotalSpent, StringFormat='{}{0:C2}'}" Width="120"/>
                            <DataGridTemplateColumn Header="İşlemler" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Görüntüle" 
                                                Command="{Binding DataContext.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource ModernButton}"
                                                Padding="16,8"
                                                Height="32"
                                                Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Content="&lt;" Command="{Binding PreviousPageCommand}" Style="{StaticResource ModernButton}" Width="40" Margin="0,0,16,0"/>
                        <TextBlock Text="Sayfa" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0"/>
                        <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="&gt;" Command="{Binding NextPageCommand}" Style="{StaticResource ModernButton}" Width="40" Margin="16,0,0,0"/>
                        
                        <TextBlock Text="{Binding TotalCount, StringFormat='Toplam: {0}'}" VerticalAlignment="Center" Margin="32,0,0,0" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SAĞ BÖLGE (%30) - Filtreler ve Hızlı İşlemler -->
            <StackPanel Grid.Column="2">
                <!-- Arama Kutusu -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Hızlı Arama" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,16"/>
                        <ui:TextBox PlaceholderText="İsim, telefon veya şehir ara..."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Height="40"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Filtreler -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Kategori Filtresi" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,16"/>
                        
                        <Button Content="Tümü" Command="{Binding ClearTypeFilterCommand}" 
                                Style="{StaticResource ModernButton}" Margin="0,0,0,8" Height="40" HorizontalAlignment="Stretch"/>
                                
                        <Button Content="Bireysel Müşteriler" 
                                Command="{Binding SetTypeFilterCommand}"
                                CommandParameter="{x:Static enums:CustomerType.Individual}"
                                Style="{StaticResource ModernButton}" Margin="0,0,0,8" Height="40" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeSuccess}"/>
                                
                        <Button Content="Kurumsal Müşteriler" 
                                Command="{Binding SetTypeFilterCommand}"
                                CommandParameter="{x:Static enums:CustomerType.Corporate}"
                                Style="{StaticResource ModernButton}" Margin="0,0,0,8" Height="40" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeWarning}"/>
                                
                        <Button Content="Perakende (Walk-in)" 
                                Command="{Binding SetTypeFilterCommand}"
                                CommandParameter="{x:Static enums:CustomerType.WalkIn}"
                                Style="{StaticResource ModernButton}" Height="40" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeInfoDark}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>


